@model LearnNova.Models.ViewModels.Student.LearningViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "التعلم - " + Model.Course.Title;
    Layout = "_Layout";
}

<style>
    .learning-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    @@media (min-width: 992px) {
        .learning-container {
            flex-direction: row;
        }
        .learning-sidebar {
            width: 300px;
            flex-shrink: 0;
        }
        .learning-main {
            flex-grow: 1;
        }
    }
    
    .lesson-item {
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 8px;
        text-decoration: none;
        color: var(--slate);
        display: flex;
        align-items: center;
        gap: 12px;
        transition: all 0.2s;
        border: 1px solid transparent;
    }
    .lesson-item:hover {
        background-color: #F3F4F6;
        color: var(--primary);
    }
    .lesson-item.active {
        background-color: #F5F3FF;
        border-color: #DDD6FE;
        color: var(--primary);
        font-weight: 600;
    }
    .lesson-icon {
        font-size: 20px;
        flex-shrink: 0;
    }
</style>

<div class="mb-4">
    <a asp-controller="Enrollment" asp-action="MyCourses" class="btn btn-sm btn-light" style="font-size:13px; font-weight:600; border:1px solid var(--color-border); background:white;">
        <i class="bi bi-arrow-right me-1"></i> العودة إلى كورساتي
    </a>
</div>

<div class="d-flex align-items-end mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold mb-1" style="color:var(--color-text-primary); letter-spacing:-0.5px;">@Model.Course.Title</h3>
        <p class="text-muted mb-0" style="font-size:14px;">بيئة التعلم والمحتوى الدراسي</p>
    </div>
</div>

<div class="learning-container">
    <!-- Sidebar -->
    <div class="learning-sidebar">
        <div class="card-box p-0 position-sticky" style="top:20px; max-height: calc(100vh - 40px); overflow-y: auto; overflow-x: hidden;">
            <div class="p-4 border-bottom" style="background:var(--color-surface-muted);">
                <h6 class="fw-bold mb-3 d-flex align-items-center" style="color:var(--color-text-primary); font-size:15px;">
                    <i class="bi bi-collection-play me-2 text-primary"></i> محتويات الكورس
                </h6>
                <div class="progress mb-2" style="height:8px; background-color:var(--color-border); border-radius:var(--radius-full); box-shadow:inset 0 1px 2px rgba(0,0,0,0.05);">
                    <div class="progress-bar" role="progressbar" style="width: @Model.CourseProgressPercentage%; background-color:var(--color-primary); border-radius:var(--radius-full);" aria-valuenow="@Model.CourseProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="d-flex justify-content-between align-items-center" style="font-size:12px; font-weight:600;">
                    <span class="text-muted">نسبة الإنجاز</span>
                    <span style="color:var(--color-primary);">@Model.CourseProgressPercentage%</span>
                </div>
            </div>
            
            <div class="p-2">
                @if (!Model.Contents.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox d-block mb-2 text-secondary opacity-50 fs-3"></i>
                        <span class="text-muted" style="font-size:13px">لا يوجد محتوى مضاف حتى الآن.</span>
                    </div>
                }
                else
                {
                    @foreach (var content in Model.Contents)
                    {
                        var isCurrent = Model.CurrentContent?.Id == content.Id;
                        var isCompleted = Model.CompletedContentIds.Contains(content.Id);
                        
                        var icon = "bi-file-earmark-text-fill";
                        var iconColor = "var(--color-primary)";
                        
                        switch (content.Type)
                        {
                            case LearnNova.Models.Enums.ContentType.Video: icon = "bi-play-circle-fill"; iconColor = "var(--color-indigo)"; break;
                            case LearnNova.Models.Enums.ContentType.Pdf: icon = "bi-file-earmark-pdf-fill"; iconColor = "var(--color-danger)"; break;
                            case LearnNova.Models.Enums.ContentType.Word: icon = "bi-file-earmark-word-fill"; iconColor = "#2563eb"; break;
                            case LearnNova.Models.Enums.ContentType.PowerPoint: icon = "bi-file-earmark-ppt-fill"; iconColor = "#ea580c"; break;
                            case LearnNova.Models.Enums.ContentType.Excel: icon = "bi-file-earmark-excel-fill"; iconColor = "#16a34a"; break;
                            case LearnNova.Models.Enums.ContentType.Archive: icon = "bi-file-earmark-zip-fill"; iconColor = "#8b5cf6"; break;
                            case LearnNova.Models.Enums.ContentType.Image: icon = "bi-image-fill"; iconColor = "#10b981"; break;
                            case LearnNova.Models.Enums.ContentType.ExternalLink: icon = "bi-link-45deg"; iconColor = "#475569"; break;
                        }
                        
                        if (isCompleted) iconColor = "var(--color-success)";
                        
                        <a asp-action="Index" asp-route-courseId="@Model.Course.Id" asp-route-contentId="@content.Id"
                           class="lesson-item @(isCurrent ? "active" : "")">
                            
                            @if (isCompleted)
                            {
                                <div style="width:32px; height:32px; border-radius:50%; background:var(--color-success-light); color:var(--color-success-dark); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                    <i class="bi bi-check-circle-fill lesson-icon" style="font-size:16px;"></i>
                                </div>
                            }
                            else
                            {
                                <div style="width:32px; height:32px; border-radius:50%; background:var(--color-surface-muted); color:@iconColor; display:flex; align-items:center; justify-content:center; flex-shrink:0; border:1px solid var(--color-border);">
                                    <i class="bi @icon lesson-icon" style="font-size:16px;"></i>
                                </div>
                            }
                            
                            <div class="flex-grow-1" style="font-size:13px">
                                <div class="text-truncate fw-semibold" style="color:var(--color-text-primary);">@content.Title</div>
                                @if (content.DurationSec.HasValue)
                                {
                                    <div class="d-flex align-items-center gap-1 mt-1" style="font-size:11px; color:var(--color-text-secondary);">
                                        <i class="bi bi-clock"></i> @(content.DurationSec / 60) دقيقة
                                    </div>
                                }
                            </div>
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="learning-main">
        @if (Model.CurrentContent != null)
        {
            var rawUrl = Model.CurrentContent.FileUrl ?? "";
            string fileSizeText = "";
            if (rawUrl.StartsWith("/uploads/"))
            {
                var fullPath = System.IO.Path.Combine(Env.WebRootPath, rawUrl.TrimStart('/'));
                if (System.IO.File.Exists(fullPath))
                {
                    double mb = new System.IO.FileInfo(fullPath).Length / 1024.0 / 1024.0;
                    fileSizeText = $"{mb:F1} MB";
                }
            }

            var mainIcon = "bi-file-earmark-text-fill";
            var mainIconColor = "var(--color-primary)";
            var mainLabel = "Course Material";
            
            switch (Model.CurrentContent.Type)
            {
                case LearnNova.Models.Enums.ContentType.Video: mainIcon = "bi-play-circle-fill"; mainIconColor = "var(--color-indigo)"; mainLabel = "Video Lesson"; break;
                case LearnNova.Models.Enums.ContentType.Pdf: mainIcon = "bi-file-earmark-pdf-fill"; mainIconColor = "var(--color-danger)"; mainLabel = "PDF Document"; break;
                case LearnNova.Models.Enums.ContentType.Word: mainIcon = "bi-file-earmark-word-fill"; mainIconColor = "#2563eb"; mainLabel = "Word Document"; break;
                case LearnNova.Models.Enums.ContentType.PowerPoint: mainIcon = "bi-file-earmark-ppt-fill"; mainIconColor = "#ea580c"; mainLabel = "PowerPoint Presentation"; break;
                case LearnNova.Models.Enums.ContentType.Excel: mainIcon = "bi-file-earmark-excel-fill"; mainIconColor = "#16a34a"; mainLabel = "Excel Spreadsheet"; break;
                case LearnNova.Models.Enums.ContentType.Archive: mainIcon = "bi-file-earmark-zip-fill"; mainIconColor = "#8b5cf6"; mainLabel = "ZIP Archive"; break;
                case LearnNova.Models.Enums.ContentType.Image: mainIcon = "bi-image-fill"; mainIconColor = "#10b981"; mainLabel = "Image"; break;
                case LearnNova.Models.Enums.ContentType.ExternalLink: mainIcon = "bi-link-45deg"; mainIconColor = "#475569"; mainLabel = "External Link"; break;
            }
            
            <div class="card-box p-0 overflow-hidden mb-4" style="border:1px solid var(--color-border); box-shadow:var(--shadow-md);">
                
                @if (Model.CurrentContent.Type == LearnNova.Models.Enums.ContentType.Video)
                {
                    <div class="ratio ratio-16x9" style="background:#0f172a; border-bottom:1px solid var(--color-border-light);">
                        @{
                            string videoUrl = rawUrl;
                            if (videoUrl.Contains("youtube.com") || videoUrl.Contains("youtu.be"))
                            {
                                string videoId = "";
                                if (videoUrl.Contains("watch?v="))
                                    videoId = videoUrl.Split("watch?v=")[1].Split('&')[0];
                                else if (videoUrl.Contains("youtu.be/"))
                                    videoId = videoUrl.Split("youtu.be/")[1].Split('?')[0];
                                else if (videoUrl.Contains("embed/"))
                                    videoId = videoUrl.Split("embed/")[1].Split('?')[0];

                                if (!string.IsNullOrEmpty(videoId))
                                    videoUrl = $"https://www.youtube.com/embed/{videoId}";
                            }
                        }
                        <iframe src="@videoUrl" title="@Model.CurrentContent.Title" 
                                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen style="border:none;"></iframe>
                    </div>
                }
                else if (Model.CurrentContent.Type == LearnNova.Models.Enums.ContentType.Pdf)
                {
                    bool isDrive = rawUrl.Contains("drive.google.com");
                    bool isOneDrive = rawUrl.Contains("onedrive.live.com") || rawUrl.Contains("sharepoint.com");
                    string embedUrl = rawUrl;

                    if (isDrive && rawUrl.Contains("/view"))
                    {
                        embedUrl = rawUrl.Replace("/view", "/preview");
                        if (embedUrl.Contains("?")) embedUrl = embedUrl.Split('?')[0] + "/preview";
                    }

                    <div class="ratio ratio-16x9" style="border-bottom:1px solid var(--color-border-light); background:#f8fafc; position: relative;">
                        @if (isDrive || isOneDrive)
                        {
                            <iframe src="@embedUrl" title="@Model.CurrentContent.Title" style="border:none; z-index:2;"></iframe>
                        }
                        else
                        {
                            <object data="@embedUrl" type="application/pdf" width="100%" height="100%" style="z-index:2;">
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 w-100 position-absolute" style="top:0; left:0; z-index:1; background:#f8fafc;">
                                    <div style="width:80px; height:80px; border-radius:var(--radius-xl); background:white; box-shadow:var(--shadow-sm); display:flex; align-items:center; justify-content:center; margin-bottom:24px;">
                                        <i class="bi bi-file-earmark-pdf-fill" style="font-size:40px; color:var(--color-danger)"></i>
                                    </div>
                                    <h4 class="fw-bold mb-2" style="color:var(--color-text-primary);">@Model.CurrentContent.Title</h4>
                                    <p style="color:var(--color-text-secondary); font-size:14px;" class="mb-2">Preview is unavailable for this document.</p>
                                    @if(!string.IsNullOrEmpty(fileSizeText)) {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary mb-4">Size: @fileSizeText</span>
                                    }
                                    <div class="d-flex gap-3 mt-2">
                                        <a href="@rawUrl" target="_blank" class="btn btn-primary d-flex align-items-center gap-2">
                                            <i class="bi bi-box-arrow-up-right"></i> Open PDF
                                        </a>
                                        <a href="@rawUrl" download class="btn btn-outline-dark d-flex align-items-center gap-2">
                                            <i class="bi bi-download"></i> Download PDF
                                        </a>
                                    </div>
                                </div>
                            </object>
                        }
                    </div>
                }
                else
                {
                    <div class="p-5 text-center d-flex flex-column align-items-center justify-content-center" style="min-height:400px; background:linear-gradient(to bottom, #f8fafc, #f1f5f9); border-bottom:1px solid var(--color-border-light);">
                        
                        @if (Model.CurrentContent.Type == LearnNova.Models.Enums.ContentType.Image)
                        {
                            <div style="max-width:80%; max-height:400px; overflow:hidden; border-radius:var(--radius-lg); box-shadow:var(--shadow-md); margin-bottom:24px; transition: transform 0.3s ease;" class="zoom-image-container">
                                <img src="@rawUrl" alt="@Model.CurrentContent.Title" style="width:100%; height:auto; object-fit:contain; cursor: zoom-in;" onclick="this.classList.toggle('zoomed')" />
                            </div>
                            <style>
                                img.zoomed { transform: scale(1.5); cursor: zoom-out !important; }
                            </style>
                        }
                        else
                        {
                            <div style="width:80px; height:80px; border-radius:var(--radius-xl); background:white; box-shadow:var(--shadow-sm); display:flex; align-items:center; justify-content:center; margin-bottom:24px;">
                                <i class="bi @mainIcon" style="font-size:40px; color:@mainIconColor"></i>
                            </div>
                        }

                        <h4 class="fw-bold mb-2" style="color:var(--color-text-primary);">@Model.CurrentContent.Title</h4>
                        <p style="color:var(--color-text-secondary); font-size:14px; max-width:400px;" class="mb-2">Preview is unavailable for this document type.</p>
                        @if(!string.IsNullOrEmpty(fileSizeText)) {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 mb-4">Size: @fileSizeText</span>
                        }
                        
                        <div class="d-flex gap-3 mt-2">
                            <a href="@rawUrl" target="_blank" class="btn-primary-custom d-flex align-items-center gap-2" style="height:44px; padding:0 24px;">
                                <i class="bi bi-box-arrow-up-right"></i> Open File
                            </a>
                            <a href="@rawUrl" download class="btn btn-outline-dark d-flex align-items-center gap-2" style="height:44px; padding:0 24px;">
                                <i class="bi bi-download"></i> Download File
                            </a>
                        </div>
                    </div>
                }

                <div class="p-4 d-flex justify-content-between align-items-center flex-wrap gap-4">
                    <div>
                        <div class="mb-2 d-flex align-items-center gap-2" style="color:@mainIconColor; font-size:14px;">
                            <i class="bi @mainIcon"></i> <span class="fw-bold">@mainLabel</span>
                        </div>
                        
                        <h4 class="fw-bold mb-0" style="color:var(--color-text-primary); font-size:20px; letter-spacing:-0.5px;">@Model.CurrentContent.Title</h4>
                    </div>
                    
                    <div class="d-flex align-items-center flex-wrap gap-3">
                        @if (Model.CurrentContent.Type != LearnNova.Models.Enums.ContentType.Video)
                        {
                            <a href="@rawUrl" target="_blank" class="btn btn-light d-flex align-items-center gap-2" style="height:44px; font-weight:600; border:1px solid var(--color-border);">
                                <i class="bi bi-box-arrow-up-right"></i> Open
                            </a>
                            <a href="@rawUrl" download class="btn btn-light d-flex align-items-center gap-2" style="height:44px; font-weight:600; border:1px solid var(--color-border);">
                                <i class="bi bi-download"></i> Download
                            </a>
                        }

                        @if (Model.CompletedContentIds.Contains(Model.CurrentContent.Id))
                        {
                            <div class="d-flex align-items-center gap-2 px-4 rounded" style="height:44px; background:var(--color-success-light); color:var(--color-success-dark); font-weight:600; font-size:14px; border:1px solid rgba(16,185,129,0.2);">
                                <i class="bi bi-check-circle-fill fs-5"></i> مكتمل
                            </div>
                        }
                        else
                        {
                            <form asp-action="MarkCompleted" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="courseId" value="@Model.Course.Id" />
                                <input type="hidden" name="contentId" value="@Model.CurrentContent.Id" />
                                <input type="hidden" name="nextContentId" value="@Model.NextContentId" />
                                <button type="submit" class="btn btn-success d-flex align-items-center gap-2" style="height:44px; padding:0 24px; font-weight:600; font-size:14px; border-radius:var(--radius-md); box-shadow:0 4px 12px rgba(16,185,129,0.2);">
                                    <i class="bi bi-check2-all fs-5"></i> تحديد كمكتمل
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center gap-3">
                @if (Model.PrevContentId.HasValue)
                {
                    <a asp-action="Index" asp-route-courseId="@Model.Course.Id" asp-route-contentId="@Model.PrevContentId" class="btn btn-light" style="height:44px; padding:0 20px; display:flex; align-items:center; font-weight:600; font-size:14px; border:1px solid var(--color-border); background:white;">
                        <i class="bi bi-arrow-right me-2"></i> الدرس السابق
                    </a>
                }
                else
                {
                    <div></div>
                }

                @if (Model.NextContentId.HasValue)
                {
                    <a asp-action="Index" asp-route-courseId="@Model.Course.Id" asp-route-contentId="@Model.NextContentId" class="btn-primary-custom" style="height:44px; padding:0 20px;">
                        الدرس التالي <i class="bi bi-arrow-left ms-2"></i>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="card-box p-5 text-center my-4" style="background:var(--color-surface-muted); box-shadow:none; border:1px dashed var(--color-border);">
                <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width:80px; height:80px; background:white; color:var(--color-primary); border-radius:var(--radius-xl); box-shadow:var(--shadow-sm);">
                    <i class="bi bi-play-circle-fill" style="font-size:40px;"></i>
                </div>
                <h4 class="fw-bold mb-2" style="color:var(--color-text-primary);">مرحباً بك في بيئة التعلم!</h4>
                <p class="text-muted mb-0" style="font-size:14px; max-width:400px; margin:auto;">اختر درساً من القائمة الجانبية للبدء في رحلة التعلم واكتساب مهارات جديدة.</p>
            </div>
        }
    </div>
</div>
