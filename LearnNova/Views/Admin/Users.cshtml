@model IEnumerable<LearnNova.Models.Entities.ApplicationUser>
@using LearnNova.Models.Enums
@{
    string currentUserId = (string?)ViewBag.CurrentUserId ?? "";
    string roleFilter = (string)ViewBag.RoleFilter;
    string isActiveFilter = (string)ViewBag.IsActiveFilter;
    ViewData["Title"] = "المستخدمون";
}

<!-- Page Header -->
<div class="page-header animate-in">
    <div class="page-header-info">
        <div class="page-header-title">
            <div class="ph-icon"><i class="bi bi-people"></i></div>
            إدارة المستخدمين
        </div>
        <div class="page-header-subtitle">إدارة حسابات الطلاب، المدرسين، والمديرين في المنصة.</div>
    </div>
    <a asp-action="CreateAdmin" class="btn-primary-custom">
        <i class="bi bi-person-badge"></i> إضافة مدير
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success animate-in">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger animate-in">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Filter Card -->
<div class="filter-card animate-in animate-in-delay-1">
    <form method="get" class="d-flex flex-wrap gap-3 align-items-center">
        <!-- Search -->
        <div class="search-input-wrap flex-grow-1" style="min-width:240px;max-width:380px;">
            <i class="bi bi-search"></i>
            <input name="term" class="search-input" placeholder="ابحث بالاسم أو البريد الإلكتروني..." value="@ViewBag.Term" />
        </div>
        <!-- Role filter -->
        <select name="role" class="form-control-custom" style="width:155px;">
            <option value="">كل الأدوار</option>
            <option value="Admin" selected="@(roleFilter == "Admin")">مدير</option>
            <option value="Teacher" selected="@(roleFilter == "Teacher")">مدرس</option>
            <option value="Student" selected="@(roleFilter == "Student")">طالب</option>
        </select>
        <!-- Status filter -->
        <select name="isActive" class="form-control-custom" style="width:155px;">
            <option value="">كل الحالات</option>
            <option value="true" selected="@(isActiveFilter == "true")">نشط</option>
            <option value="false" selected="@(isActiveFilter == "false")">غير نشط</option>
        </select>
        <button type="submit" class="btn-outline-custom">
            <i class="bi bi-funnel"></i> تصفية
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.Term as string) || !string.IsNullOrEmpty(roleFilter) || !string.IsNullOrEmpty(isActiveFilter))
        {
            <a asp-action="Users" class="btn-icon" title="مسح الفلاتر">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </form>
</div>

@if (!Model.Any())
{
    <div class="empty-state animate-in animate-in-delay-2">
        <div class="es-icon-wrap">
            <i class="bi bi-search es-ico"></i>
        </div>
        <div class="es-title">لا يوجد مستخدمون</div>
        <div class="es-desc">لم يتم العثور على أي مستخدم يطابق معايير البحث الخاصة بك.</div>
        <a asp-action="Users" class="btn-outline-custom mx-auto">
            <i class="bi bi-arrow-counterclockwise"></i> مسح الفلاتر
        </a>
    </div>
}
else
{
    <div class="table-card animate-in animate-in-delay-2">
        <div style="overflow-x:auto;">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:50px;"></th>
                        <th>الاسم</th>
                        <th>البريد الإلكتروني</th>
                        <th>الدور</th>
                        <th>التفاصيل</th>
                        <th>تاريخ الانضمام</th>
                        <th>الحالة</th>
                        <th style="text-align:start;">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var isPending = user.Role == UserRole.Teacher && !user.IsActive;
                        var badgeClass = user.IsActive ? "badge-success" : (isPending ? "badge-warning" : "badge-danger");
                        var badgeText = user.IsActive ? "نشط" : (isPending ? "قيد المراجعة" : "موقوف");
                        var initial = user.FullName.Trim().Length > 0 ? user.FullName.Trim()[0].ToString() : "؟";

                        <tr>
                            <td>
                                <div class="avatar-circle size-md">@initial</div>
                            </td>
                            <td>
                                <a asp-action="UserDetails" asp-route-id="@user.Id"
                                   class="fw-bold text-decoration-none"
                                   style="color:var(--color-text-primary);transition:color var(--dur-fast);"
                                   onmouseover="this.style.color='var(--color-primary)'"
                                   onmouseout="this.style.color='var(--color-text-primary)'">
                                    @user.FullName
                                </a>
                            </td>
                            <td style="color:var(--color-text-muted);font-size:13px;">@user.Email</td>
                            <td>
                                @if (user.Role == UserRole.Admin)
                                {
                                    <span class="role-tag role-tag-admin"><i class="bi bi-shield-fill"></i>مدير</span>
                                }
                                else if (user.Role == UserRole.Teacher)
                                {
                                    <span class="role-tag role-tag-teacher"><i class="bi bi-person-workspace"></i>مدرس</span>
                                }
                                else
                                {
                                    <span class="role-tag role-tag-student"><i class="bi bi-mortarboard-fill"></i>طالب</span>
                                }
                            </td>
                            <td style="font-size:13px;color:var(--color-text-secondary);font-weight:500;">
                                @(user.Role == UserRole.Student ? user.GradeLabel : user.Role == UserRole.Teacher ? user.Subject : "—")
                            </td>
                            <td style="font-size:13px;color:var(--color-text-muted);">
                                @DateTimeService.ToLocal(user.CreatedAt).ToString("yyyy/MM/dd")
                            </td>
                            <td>
                                <span class="badge-status @badgeClass">@badgeText</span>
                            </td>
                            <td style="text-align:start;">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="UserDetails" asp-route-id="@user.Id" class="btn-icon btn-sm" title="عرض التفاصيل">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (user.Id != currentUserId)
                                    {
                                        <form method="post" asp-action="ToggleActive" class="m-0">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <input type="hidden" name="targetStatus" value="@(user.IsActive ? "false" : "true")" />
                                            <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                            <button type="submit"
                                                    class="btn-icon btn-sm @(user.IsActive ? "danger" : "")"
                                                    title="@(user.IsActive ? "إيقاف الحساب" : "تفعيل الحساب")">
                                                <i class="bi @(user.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Table footer -->
        <div style="padding:var(--space-4) var(--space-5);border-top:1px solid var(--color-border);background:var(--color-surface);font-size:12.5px;color:var(--color-text-muted);font-weight:600;">
            يعرض <strong style="color:var(--color-text-primary)">@Model.Count()</strong> مستخدم
        </div>
    </div>
}
