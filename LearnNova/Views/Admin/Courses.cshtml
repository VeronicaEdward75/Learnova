@model IEnumerable<LearnNova.Models.Entities.Course>
@{
    string isPublishedFilter = (string)ViewBag.IsPublishedFilter;
    ViewData["Title"] = "إدارة الكورسات";
}

<!-- Page Header -->
<div class="page-header animate-in">
    <div class="page-header-info">
        <div class="page-header-title">
            <div class="ph-icon"><i class="bi bi-journals"></i></div>
            إدارة الكورسات
        </div>
        <div class="page-header-subtitle">إشراف على جميع الكورسات ونشرها على المنصة.</div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success animate-in">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger animate-in">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Filter Card -->
<div class="filter-card animate-in animate-in-delay-1">
    <form method="get" class="d-flex flex-wrap gap-3 align-items-center">
        <div class="search-input-wrap flex-grow-1" style="min-width:240px;max-width:400px;">
            <i class="bi bi-search"></i>
            <input name="term" class="search-input" placeholder="ابحث بعنوان الكورس أو المدرس..." value="@ViewBag.Term" />
        </div>
        <select name="isPublished" class="form-control-custom" style="width:165px;">
            <option value="">كل الحالات</option>
            <option value="true" selected="@(isPublishedFilter == "true")">منشور</option>
            <option value="false" selected="@(isPublishedFilter == "false")">غير منشور</option>
        </select>
        <button type="submit" class="btn-outline-custom">
            <i class="bi bi-funnel"></i> تصفية
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.Term as string) || !string.IsNullOrEmpty(isPublishedFilter))
        {
            <a asp-action="Courses" class="btn-icon" title="مسح الفلاتر">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </form>
</div>

@if (!Model.Any())
{
    <div class="empty-state animate-in animate-in-delay-2">
        <div class="es-icon-wrap">
            <i class="bi bi-journals es-ico"></i>
        </div>
        <div class="es-title">لا توجد كورسات</div>
        <div class="es-desc">لم يتم العثور على أي كورسات تطابق معايير البحث.</div>
    </div>
}
else
{
    <div class="table-card animate-in animate-in-delay-2">
        <div style="overflow-x:auto;">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>العنوان</th>
                        <th>المادة</th>
                        <th>المرحلة</th>
                        <th>المدرس</th>
                        <th>السعر</th>
                        <th>الحالة</th>
                        <th style="text-align:start;">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        var teacherInitial = course.Teacher.FullName.Trim().Length > 0 ? course.Teacher.FullName.Trim()[0].ToString() : "؟";
                        <tr>
                            <td>
                                <div class="fw-bold" style="color:var(--color-text-primary);font-size:13.5px;">@course.Title</div>
                            </td>
                            <td>
                                <span class="badge-status badge-indigo" style="font-size:11px;">@course.Subject</span>
                            </td>
                            <td style="font-size:13px;color:var(--color-text-muted);">
                                @course.Stage @(course.GradeLevel > 0 ? $"- {course.GradeLevel}" : "")
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-circle size-sm">@teacherInitial</div>
                                    <span style="font-size:13px;font-weight:600;">@course.Teacher.FullName</span>
                                </div>
                            </td>
                            <td style="font-size:13.5px;font-weight:700;color:var(--color-primary);">
                                @(course.Price == 0 ? "مجاني" : $"{course.Price:N0} ج.م")
                            </td>
                            <td>
                                <span class="badge-status @(course.IsPublished ? "badge-success" : "badge-warning")">
                                    @(course.IsPublished ? "منشور" : "مسودة")
                                </span>
                            </td>
                            <td style="text-align:start;">
                                @if (course.IsPublished)
                                {
                                    <form method="post" asp-action="Unpublish">
                                        <input type="hidden" name="id" value="@course.Id" />
                                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                        <button type="submit" class="btn-danger-outline btn-sm">
                                            <i class="bi bi-eye-slash"></i> إلغاء النشر
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-action="Publish">
                                        <input type="hidden" name="id" value="@course.Id" />
                                        <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                        <button type="submit" class="btn-success-custom btn-sm">
                                            <i class="bi bi-globe2"></i> نشر
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div style="padding:var(--space-4) var(--space-5);border-top:1px solid var(--color-border);background:var(--color-surface);font-size:12.5px;color:var(--color-text-muted);font-weight:600;">
            يعرض <strong style="color:var(--color-text-primary)">@Model.Count()</strong> كورس
        </div>
    </div>
}
