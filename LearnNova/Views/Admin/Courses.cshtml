@model IEnumerable<LearnNova.Models.Entities.Course>
@{
    string isPublishedFilter = (string)ViewBag.IsPublishedFilter;
}

<div class="section-title">📚 الكورسات</div>
<div class="section-sub">إشراف على جميع الكورسات ونشرها</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success small">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger small">@TempData["ErrorMessage"]</div>
}

<form method="get" class="d-flex gap-2 mb-3 flex-wrap align-items-center">
    <select name="isPublished" class="form-control-custom" style="max-width:170px">
        <option value="">كل الحالات</option>
        <option value="true" selected="@(isPublishedFilter == "true")">منشور</option>
        <option value="false" selected="@(isPublishedFilter == "false")">غير منشور</option>
    </select>
    <div class="input-group" style="max-width:260px">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input name="term" class="form-control border-start-0" placeholder="ابحث بعنوان الكورس أو المدرس..." value="@ViewBag.Term" />
    </div>
    <button type="submit" class="btn-outline-custom">بحث</button>
</form>

@if (!Model.Any())
{
    <div class="empty-state"><div class="es-ico">📭</div><div>لا توجد كورسات مطابقة</div></div>
}
else
{
    <div class="card-box p-0" style="overflow-x:auto">
        <table class="table align-middle mb-0">
            <thead>
                <tr style="font-size:12.5px;color:var(--gray)">
                    <th>العنوان</th><th>المادة</th><th>المرحلة</th><th>المدرس</th><th>السعر</th><th>الحالة</th><th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr style="font-size:13.5px">
                        <td class="fw-semibold">@course.Title</td>
                        <td>@course.Subject</td>
                        <td style="color:var(--gray);font-size:12px">@course.Stage @(course.GradeLevel > 0 ? $"- {course.GradeLevel}" : "")</td>
                        <td>@course.Teacher.FullName</td>
                        <td>@course.Price ج.م</td>
                        <td><span class="badge-status @(course.IsPublished ? "badge-ok" : "badge-late")">@(course.IsPublished ? "منشور" : "غير منشور")</span></td>
                        <td>
                            <form method="post" asp-action="TogglePublish">
                                <input type="hidden" name="id" value="@course.Id" />
                                <input type="hidden" name="isPublished" value="@(!course.IsPublished)" />
                                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                                <button type="submit" class="btn btn-sm @(course.IsPublished ? "btn-outline-custom" : "btn-primary-custom")">
                                    @(course.IsPublished ? "إلغاء النشر" : "نشر")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
