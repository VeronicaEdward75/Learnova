@model IEnumerable<LearnNova.Models.ViewModels.Admin.AdminRefundViewModel>
@{
    ViewData["Title"] = "إدارة المرتجعات والمنازعات";
    var currentFilter = ViewBag.CurrentFilter as LearnNova.Models.Enums.RefundStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">المرتجعات والمنازعات</h2>
</div>

<div class="card-box p-4 mb-4">
    <form method="get" asp-action="Refunds" class="d-flex gap-3 align-items-end">
        <div style="width:250px;">
            <label class="form-label fw-bold">تصفية حسب الحالة</label>
            <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                <option value="">الكل</option>
                <option value="Pending" selected="@(currentFilter == LearnNova.Models.Enums.RefundStatus.Pending ? "selected" : null)">قيد المراجعة</option>
                <option value="Approved" selected="@(currentFilter == LearnNova.Models.Enums.RefundStatus.Approved ? "selected" : null)">موافق عليه</option>
                <option value="Rejected" selected="@(currentFilter == LearnNova.Models.Enums.RefundStatus.Rejected ? "selected" : null)">مرفوض</option>
            </select>
        </div>
    </form>
</div>

<div class="row g-4">
    @if(!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-secondary text-center py-5">لا توجد طلبات استرداد تتطابق مع بحثك.</div>
        </div>
    }

    @foreach (var r in Model)
    {
        <div class="col-12 col-xl-6">
            <div class="card-box p-4 h-100 d-flex flex-column" style="border-top: 4px solid @(r.Status == LearnNova.Models.Enums.RefundStatus.Pending ? "var(--color-warning)" : r.Status == LearnNova.Models.Enums.RefundStatus.Approved ? "var(--color-success)" : "var(--color-danger)");">
                <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-3">
                    <div>
                        <div class="text-muted small">طلب استرداد #@r.RefundId</div>
                        <h5 class="fw-bold mt-1 text-primary">@r.Amount.ToString("N2") EGP</h5>
                    </div>
                    <div>
                        @if (r.Status == LearnNova.Models.Enums.RefundStatus.Pending) { <span class="badge bg-warning text-dark fs-6">قيد المراجعة</span> }
                        else if (r.Status == LearnNova.Models.Enums.RefundStatus.Approved) { <span class="badge bg-success fs-6">تم الاسترداد</span> }
                        else if (r.Status == LearnNova.Models.Enums.RefundStatus.Rejected) { <span class="badge bg-danger fs-6">مرفوض</span> }
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="text-muted small">الطالب</div>
                        <div class="fw-bold" style="font-size:14px;"><i class="bi bi-person text-primary me-1"></i> @r.StudentName</div>
                    </div>
                    <div class="col-6">
                        <div class="text-muted small">المدرس</div>
                        <div class="fw-bold" style="font-size:14px;"><i class="bi bi-person-video3 text-success me-1"></i> @r.TeacherName</div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">الكورس</div>
                        <div class="fw-bold" style="font-size:14px;"><i class="bi bi-journal-text text-secondary me-1"></i> @r.CourseTitle</div>
                    </div>
                </div>

                <div class="bg-light p-3 rounded mb-4 flex-grow-1">
                    <div class="fw-bold mb-1">السبب: @r.Reason</div>
                    @if(!string.IsNullOrEmpty(r.Description))
                    {
                        <div class="text-muted small mt-2">"@r.Description"</div>
                    }
                </div>

                @if(r.Status == LearnNova.Models.Enums.RefundStatus.Pending)
                {
                    <div class="mt-auto d-flex gap-2">
                        <button type="button" class="btn btn-success flex-grow-1" data-bs-toggle="modal" data-bs-target="#approveModal-@r.RefundId">
                            <i class="bi bi-check-lg me-1"></i> موافقة
                        </button>
                        <button type="button" class="btn btn-danger flex-grow-1" data-bs-toggle="modal" data-bs-target="#rejectModal-@r.RefundId">
                            <i class="bi bi-x-lg me-1"></i> رفض
                        </button>
                    </div>
                }
                else
                {
                    <div class="mt-auto pt-3 border-top text-muted small">
                        <strong>تاريخ القرار:</strong> @(r.ResolvedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")<br />
                        @if(!string.IsNullOrEmpty(r.AdminNotes))
                        {
                            <strong class="mt-2 d-block text-dark">ملاحظات الإدارة:</strong>
                            <div>@r.AdminNotes</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@* Render all Modals outside the nested grid/flex layout to prevent stacking context bugs with Bootstrap backdrop *@
@section Modals {
@foreach (var r in Model.Where(m => m.Status == LearnNova.Models.Enums.RefundStatus.Pending))
{
    <!-- Approve Modal -->
    <div class="modal fade" id="approveModal-@r.RefundId" tabindex="-1" aria-labelledby="approveModalLabel-@r.RefundId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-success text-white px-4 py-3">
                    <h5 class="modal-title fw-bold d-flex align-items-center" id="approveModalLabel-@r.RefundId">
                        <i class="bi bi-shield-check me-2 fs-4"></i>
                        تأكيد الموافقة على الاسترداد المالي
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="ApproveRefund" method="post">
                    <input type="hidden" name="id" value="@r.RefundId" />
                    <div class="modal-body p-4 p-md-5">
                        <p class="text-muted mb-4 fs-5">
                            الموافقة على هذا الاسترداد هي عملية مالية نهائية ولا يمكن التراجع عنها. سيتم تنفيذ القيود المالية التالية فوراً:
                        </p>
                        
                        <div class="row g-4 mb-4">
                            <div class="col-sm-6 col-md-3">
                                <div class="p-3 rounded text-center" style="background-color: var(--color-primary-light); border: 1px solid var(--color-primary);">
                                    <div class="text-muted small fw-bold mb-1">مبلغ الاسترداد</div>
                                    <div class="fw-bold text-primary fs-4">@r.Amount.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="p-3 rounded text-center" style="background-color: #fff3cd; border: 1px solid #ffecb5;">
                                    <div class="text-muted small fw-bold mb-1">خسارة المعلم</div>
                                    <div class="fw-bold text-warning fs-4">-@r.TeacherLoss.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="p-3 rounded text-center" style="background-color: #f8d7da; border: 1px solid #f5c2c7;">
                                    <div class="text-muted small fw-bold mb-1">خسارة المنصة</div>
                                    <div class="fw-bold text-danger fs-4">-@r.PlatformLoss.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="p-3 rounded text-center" style="background-color: #d1e7dd; border: 1px solid #badbcc;">
                                    <div class="text-muted small fw-bold mb-1">يعود للطالب</div>
                                    <div class="fw-bold text-success fs-4">+@r.StudentRefund.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="alert alert-warning d-flex align-items-center mb-4">
                            <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i> 
                            <div>سيتم إلغاء تسجيل الطالب من الكورس بشكل تلقائي فور تأكيد العملية.</div>
                        </div>
                        
                        <div class="mb-0">
                            <label class="form-label fw-bold text-dark">ملاحظات الإدارة (اختياري - سيظهر للطالب)</label>
                            <textarea name="adminNotes" class="form-control bg-light border-0" rows="3" placeholder="أضف أي ملاحظات تود توجيهها للطالب..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light px-4 py-3 border-top-0 d-flex justify-content-end gap-3">
                        <button type="button" class="btn btn-outline-secondary px-4 fw-bold" data-bs-dismiss="modal">إلغاء الأمر</button>
                        <button type="submit" class="btn btn-success px-5 fw-bold">تأكيد وتنفيذ الاسترداد</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Reject Modal -->
    <div class="modal fade" id="rejectModal-@r.RefundId" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                <div class="modal-header bg-danger text-white px-4 py-3">
                    <h5 class="modal-title fw-bold"><i class="bi bi-x-circle me-2"></i>رفض طلب الاسترداد</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="RejectRefund" method="post">
                    <input type="hidden" name="id" value="@r.RefundId" />
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">سبب الرفض (إلزامي - سيظهر للطالب)</label>
                            <textarea name="adminNotes" class="form-control bg-light border-0" rows="4" required placeholder="يرجى توضيح سبب رفض طلب الاسترداد..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light px-4 py-3 border-top-0 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary px-4 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">تأكيد الرفض</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
}
