@model LearnNova.Models.ViewModels.Admin.CouponFormViewModel
@{
    // Title set by Controller
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">@ViewData["Title"]</h2>
    <a asp-action="Coupons" class="btn btn-outline-custom">رجوع للكوبونات</a>
</div>

<div class="card-box p-4" style="max-width:800px; margin: 0 auto;">
    <form asp-action="CreateCoupon" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Code" class="form-label fw-bold"></label>
                <div class="input-group">
                    <input asp-for="Code" class="form-control" style="text-transform:uppercase;" id="CouponCodeInput" />
                    <button type="button" class="btn btn-outline-secondary" onclick="generateCode()">توليد</button>
                </div>
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive">
                    <label class="form-check-label ms-2 fw-bold" asp-for="IsActive">تفعيل الكوبون فوراً</label>
                </div>
            </div>

            <div class="col-md-6">
                <label asp-for="DiscountType" class="form-label fw-bold"></label>
                <select asp-for="DiscountType" class="form-select" id="DiscountTypeSelect">
                    <option value="Percentage">نسبة مئوية (%)</option>
                    <option value="FixedAmount">مبلغ ثابت (EGP)</option>
                    <option value="FreeCourse">كورس مجاني 100%</option>
                </select>
                <span asp-validation-for="DiscountType" class="text-danger small"></span>
            </div>

            <div class="col-md-6" id="DiscountValueContainer">
                <label asp-for="DiscountValue" class="form-label fw-bold"></label>
                <input asp-for="DiscountValue" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="DiscountValue" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label fw-bold"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label fw-bold"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="MinimumOrder" class="form-label fw-bold"></label>
                <input asp-for="MinimumOrder" class="form-control" type="number" step="0.01" placeholder="اختياري" />
                <span asp-validation-for="MinimumOrder" class="text-danger small"></span>
            </div>

            <div class="col-md-6" id="MaximumDiscountContainer">
                <label asp-for="MaximumDiscount" class="form-label fw-bold"></label>
                <input asp-for="MaximumDiscount" class="form-control" type="number" step="0.01" placeholder="اختياري" />
                <span asp-validation-for="MaximumDiscount" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="UsageLimit" class="form-label fw-bold"></label>
                <input asp-for="UsageLimit" class="form-control" type="number" placeholder="غير محدود إذا تُرك فارغاً" />
                <span asp-validation-for="UsageLimit" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="CourseId" class="form-label fw-bold"></label>
                <input asp-for="CourseId" class="form-control" type="number" placeholder="ID الكورس (اختياري)" />
                <span asp-validation-for="CourseId" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="TeacherId" class="form-label fw-bold"></label>
                <input asp-for="TeacherId" class="form-control" placeholder="ID المدرس (اختياري)" />
                <span asp-validation-for="TeacherId" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top text-end">
            <button type="submit" class="btn btn-primary-custom px-5">حفظ الكوبون</button>
        </div>
    </form>
</div>

<script>
    function generateCode() {
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
        let code = '';
        for (let i = 0; i < 8; i++) {
            code += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        document.getElementById('CouponCodeInput').value = code;
    }

    document.getElementById('DiscountTypeSelect').addEventListener('change', function() {
        var type = this.value;
        if(type === 'FreeCourse') {
            document.getElementById('DiscountValueContainer').style.display = 'none';
            document.getElementById('MaximumDiscountContainer').style.display = 'none';
        } else if(type === 'FixedAmount') {
            document.getElementById('DiscountValueContainer').style.display = 'block';
            document.getElementById('MaximumDiscountContainer').style.display = 'none';
        } else {
            document.getElementById('DiscountValueContainer').style.display = 'block';
            document.getElementById('MaximumDiscountContainer').style.display = 'block';
        }
    });

    // Trigger initially
    document.getElementById('DiscountTypeSelect').dispatchEvent(new Event('change'));
</script>
