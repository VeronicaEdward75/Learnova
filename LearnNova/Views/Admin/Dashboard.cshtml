@model LearnNova.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "لوحة تحكم المدير";
}

<!-- Hero Banner -->
<div class="hero-banner hero-admin animate-in">
    <div class="hero-orb"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-banner-content">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div style="width:48px;height:48px;border-radius:14px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(8px);">
                <i class="bi bi-shield-check text-white fs-4"></i>
            </div>
            <div>
                <div style="font-size:11px;font-weight:700;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:1px;">لوحة التحكم</div>
                <h2 class="fw-bold text-white mb-0" style="font-size:22px;letter-spacing:-0.5px;">مرحباً بك يا مدير النظام 👋</h2>
            </div>
        </div>
        <p style="opacity:.8;font-size:14px;font-weight:500;margin:0;">نظرة شاملة على أداء المنصة — المستخدمون والكورسات والإحصائيات.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success animate-in">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger animate-in">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- KPI Stat Cards -->
<div class="row g-4 mb-6 animate-in animate-in-delay-1">
    <!-- Students -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Users" asp-route-role="Student" class="text-decoration-none d-block">
            <div class="stat-card clickable" style="--from:#0F766E;--to:#0D9488">
                <div class="stat-bg-shape"></div>
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-mortarboard stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right stat-arrow"></i>
                </div>
                <div>
                    <div class="stat-lbl">إجمالي الطلاب</div>
                    <div class="stat-val">@Model.TotalStudents</div>
                </div>
            </div>
        </a>
    </div>

    <!-- Teachers -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Users" asp-route-role="Teacher" class="text-decoration-none d-block">
            <div class="stat-card clickable" style="--from:#7C3AED;--to:#6D28D9">
                <div class="stat-bg-shape"></div>
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-person-workspace stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right stat-arrow"></i>
                </div>
                <div>
                    <div class="stat-lbl">إجمالي المدرسين</div>
                    <div class="stat-val">@Model.TotalTeachers</div>
                </div>
            </div>
        </a>
    </div>

    <!-- Admins -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Users" asp-route-role="Admin" class="text-decoration-none d-block">
            <div class="stat-card clickable" style="--from:#8B5E3C;--to:#C4874E">
                <div class="stat-bg-shape"></div>
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-shield-check stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right stat-arrow"></i>
                </div>
                <div>
                    <div class="stat-lbl">المديرون</div>
                    <div class="stat-val">@Model.TotalAdmins</div>
                </div>
            </div>
        </a>
    </div>

    <!-- Pending Teachers -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Users" asp-route-role="Teacher" asp-route-isActive="false" class="text-decoration-none d-block">
            <div class="stat-card clickable" style="--from:#BE123C;--to:#E11D48">
                <div class="stat-bg-shape"></div>
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-person-exclamation stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right stat-arrow"></i>
                </div>
                <div>
                    <div class="stat-lbl">مدرسون قيد المراجعة</div>
                    <div class="stat-val">@Model.PendingTeachersCount</div>
                </div>
            </div>
        </a>
    </div>

    <!-- Platform Revenue -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="stat-card" style="--from:#047857;--to:#10B981">
            <div class="stat-bg-shape"></div>
            <div class="stat-header">
                <div class="stat-ico-wrap">
                    <i class="bi bi-cash-coin stat-ico"></i>
                </div>
            </div>
            <div>
                <div class="stat-lbl">أرباح المنصة</div>
                <div class="stat-val">@Model.TotalPlatformRevenue.ToString("N0") <small>EGP</small></div>
            </div>
        </div>
    </div>

    <!-- Teacher Earnings -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="stat-card" style="--from:#EA580C;--to:#F97316">
            <div class="stat-bg-shape"></div>
            <div class="stat-header">
                <div class="stat-ico-wrap">
                    <i class="bi bi-wallet2 stat-ico"></i>
                </div>
            </div>
            <div>
                <div class="stat-lbl">أرباح المدرسين</div>
                <div class="stat-val">@Model.TotalTeacherEarnings.ToString("N0") <small>EGP</small></div>
            </div>
        </div>
    </div>

    <!-- Pending Revenue -->
    <div class="col-12 col-md-6 col-xl-4">
        <div class="stat-card" style="--from:#64748B;--to:#94A3B8">
            <div class="stat-bg-shape"></div>
            <div class="stat-header">
                <div class="stat-ico-wrap">
                    <i class="bi bi-hourglass-split stat-ico"></i>
                </div>
            </div>
            <div>
                <div class="stat-lbl">أرباح معلقة</div>
                <div class="stat-val">@Model.PendingRevenue.ToString("N0") <small>EGP</small></div>
            </div>
        </div>
    </div>

    <!-- Total Courses -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Courses" class="text-decoration-none d-block">
            <div class="stat-card clickable" style="--from:#0369A1;--to:#0284C7">
                <div class="stat-bg-shape"></div>
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-journals stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right stat-arrow"></i>
                </div>
                <div>
                    <div class="stat-lbl">إجمالي الكورسات</div>
                    <div class="stat-val">@Model.TotalCourses</div>
                </div>
            </div>
        </a>
    </div>

    <!-- Published Courses -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Courses" asp-route-isPublished="true" class="text-decoration-none d-block">
            <div class="stat-card clickable" style="--from:#B45309;--to:#D97706">
                <div class="stat-bg-shape"></div>
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-check-circle stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right stat-arrow"></i>
                </div>
                <div>
                    <div class="stat-lbl">كورسات منشورة</div>
                    <div class="stat-val">@Model.PublishedCoursesCount</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Quick Actions -->
<div class="section-card animate-in animate-in-delay-2">
    <div class="section-card-header">
        <div class="section-card-title">
            <i class="bi bi-lightning-charge-fill"></i>
            إجراءات سريعة
        </div>
    </div>
    <div class="section-card-body">
        <div class="d-flex flex-wrap gap-3">
            <a asp-action="Users" class="btn-outline-custom">
                <i class="bi bi-people"></i> عرض المستخدمين
            </a>
            <a asp-action="CreateAdmin" class="btn-outline-custom">
                <i class="bi bi-person-badge"></i> إنشاء مدير
            </a>
            <a asp-action="Courses" class="btn-outline-custom">
                <i class="bi bi-journals"></i> إدارة الكورسات
            </a>
            @if (Model.PendingTeachersCount > 0)
            {
                <a asp-action="Users" asp-route-role="Teacher" asp-route-isActive="false" class="btn-primary-custom">
                    <i class="bi bi-hourglass-split"></i>
                    مراجعة طلبات المدرسين
                    <span style="background:rgba(255,255,255,0.2);border-radius:var(--radius-full);padding:0 8px;font-size:11px;font-weight:800;">@Model.PendingTeachersCount</span>
                </a>
            }
        </div>
    </div>
</div>
