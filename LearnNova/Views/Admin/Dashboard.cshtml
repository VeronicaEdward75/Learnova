@model LearnNova.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "لوحة تحكم المدير";
}

<div class="hero-banner hero-admin">
    <div class="hero-banner-content">
        <h3>مرحباً بك في لوحة القيادة 👋</h3>
        <p>نظرة عامة على أداء المنصة وإحصائيات المستخدمين والكورسات.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success small">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="row g-4 mb-4">
    <!-- إجمالي الطلاب -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Users" asp-route-role="Student" class="text-decoration-none">
            <div class="stat-card clickable" style="--from:#0F766E;--to:#0D9488">
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-mortarboard stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="mt-3">
                    <div class="stat-val">@Model.TotalStudents</div>
                    <div class="stat-lbl">إجمالي الطلاب</div>
                </div>
            </div>
        </a>
    </div>

    <!-- إجمالي المدرسين -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Users" asp-route-role="Teacher" class="text-decoration-none">
            <div class="stat-card clickable" style="--from:#7C3AED;--to:#6D28D9">
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-person-workspace stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="mt-3">
                    <div class="stat-val">@Model.TotalTeachers</div>
                    <div class="stat-lbl">إجمالي المدرسين</div>
                </div>
            </div>
        </a>
    </div>

    <!-- المديرون -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Users" asp-route-role="Admin" class="text-decoration-none">
            <div class="stat-card clickable" style="--from:#6F4E37;--to:#8D6E63">
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-shield-check stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="mt-3">
                    <div class="stat-val">@Model.TotalAdmins</div>
                    <div class="stat-lbl">المديرون</div>
                </div>
            </div>
        </a>
    </div>

    <!-- مدرسون قيد المراجعة -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Users" asp-route-role="Teacher" asp-route-isActive="false" class="text-decoration-none">
            <div class="stat-card clickable" style="--from:#BE123C;--to:#E11D48">
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-hourglass-split stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="mt-3">
                    <div class="stat-val">@Model.PendingTeachersCount</div>
                    <div class="stat-lbl">مدرسون قيد المراجعة</div>
                </div>
            </div>
        </a>
    </div>

    <!-- إجمالي الكورسات -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Courses" class="text-decoration-none">
            <div class="stat-card clickable" style="--from:#0369A1;--to:#0284C7">
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-journal-richtext stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="mt-3">
                    <div class="stat-val">@Model.TotalCourses</div>
                    <div class="stat-lbl">إجمالي الكورسات</div>
                </div>
            </div>
        </a>
    </div>

    <!-- كورسات منشورة -->
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-action="Courses" asp-route-isPublished="true" class="text-decoration-none">
            <div class="stat-card clickable" style="--from:#B45309;--to:#D97706">
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-check-circle stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="mt-3">
                    <div class="stat-val">@Model.PublishedCoursesCount</div>
                    <div class="stat-lbl">كورسات منشورة</div>
                </div>
            </div>
        </a>
    </div>
</div>
