@model LearnNova.Models.ViewModels.CreateAdminViewModel

@{
    ViewData["Title"] = "إضافة مدير جديد";
}

<!-- Back button -->
<div class="mb-5 animate-in">
    <a asp-action="Users" class="btn-outline-custom btn-sm">
        <i class="bi bi-arrow-right"></i> العودة للمستخدمين
    </a>
</div>

<!-- Page Header -->
<div class="page-header animate-in">
    <div class="page-header-info">
        <div class="page-header-title">
            <div class="ph-icon"><i class="bi bi-person-badge"></i></div>
            إضافة مدير جديد
        </div>
        <div class="page-header-subtitle">قم بإنشاء حساب بصلاحيات الإدارة للنظام.</div>
    </div>
</div>

<div class="row justify-content-center animate-in animate-in-delay-1">
    <div class="col-12 col-lg-7">
        <div class="section-card">
            <div class="section-card-header">
                <div class="section-card-title">
                    <i class="bi bi-person-fill-add"></i>
                    بيانات المدير الجديد
                </div>
            </div>
            <div class="section-card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-5"></div>
                <form asp-action="CreateAdmin" method="post">
                    <div class="form-group-custom">
                        <label asp-for="FullName" class="form-label-custom"></label>
                        <input asp-for="FullName" class="form-control-custom" placeholder="أدخل الاسم الكامل" />
                        <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="form-group-custom">
                        <label asp-for="Email" class="form-label-custom"></label>
                        <input asp-for="Email" class="form-control-custom" placeholder="admin@learnnova.com" />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="row gx-4 mb-0">
                        <div class="col-sm-6">
                            <div class="form-group-custom">
                                <label asp-for="Password" class="form-label-custom"></label>
                                <input asp-for="Password" class="form-control-custom" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group-custom">
                                <label asp-for="ConfirmPassword" class="form-label-custom"></label>
                                <input asp-for="ConfirmPassword" class="form-control-custom" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning mb-5">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            <strong>ملاحظة هامة:</strong> الحساب الذي سيتم إنشاؤه سيحصل فوراً على كافة صلاحيات الإدارة، بما في ذلك إضافة وحذف المستخدمين وتعديل الدورات التدريبية. يرجى توخي الحذر.
                        </div>
                    </div>

                    <button type="submit" class="btn-primary-custom w-100 justify-content-center" style="height:50px;font-size:15px;">
                        <i class="bi bi-check-lg"></i> إنشاء حساب المدير
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
