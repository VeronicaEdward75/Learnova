@model LearnNova.Models.ViewModels.CreateAdminViewModel

<div class="section-title">➕ إنشاء حساب مدير جديد</div>
<div class="section-sub">يمكن فقط لمدير حالي إنشاء حساب مدير جديد — لا يوجد تسجيل عام لهذا الدور</div>

<div class="card-box p-4" style="max-width:480px">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <form asp-action="CreateAdmin" method="post">
        <div class="mb-3">
            <label asp-for="FullName" class="form-label fw-semibold" style="font-size:13px"></label>
            <input asp-for="FullName" class="form-control-custom" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-semibold" style="font-size:13px"></label>
            <input asp-for="Email" class="form-control-custom" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold" style="font-size:13px"></label>
            <input asp-for="Password" class="form-control-custom" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label fw-semibold" style="font-size:13px"></label>
            <input asp-for="ConfirmPassword" class="form-control-custom" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn-primary-custom"><i class="bi bi-check-lg"></i> إنشاء الحساب</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
