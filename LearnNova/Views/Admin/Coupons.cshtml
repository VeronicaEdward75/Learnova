@model IEnumerable<LearnNova.Models.ViewModels.Admin.CouponListViewModel>
@{
    ViewData["Title"] = "إدارة الكوبونات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">الكوبونات والعروض</h2>
    <a asp-action="CreateCoupon" class="btn btn-primary-custom">
        <i class="bi bi-plus-lg me-2"></i>إضافة كوبون
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card-box p-4">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>الكود</th>
                    <th>الخصم</th>
                    <th>الصلاحية</th>
                    <th>حد الاستخدام</th>
                    <th>الحالي</th>
                    <th>المتبقي</th>
                    <th>الهدف</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold" style="color:var(--color-primary);">@c.Code</td>
                        <td class="fw-bold">
                            @if (c.DiscountType == LearnNova.Models.Enums.DiscountType.Percentage) { <span>@c.DiscountValue.ToString("0.##")%</span> }
                            else if (c.DiscountType == LearnNova.Models.Enums.DiscountType.FixedAmount) { <span>@c.DiscountValue.ToString("N2") EGP</span> }
                            else { <span>مجاني</span> }
                        </td>
                        <td class="small">
                            @if(c.StartDate.HasValue) { <div>من: @c.StartDate.Value.ToString("yyyy-MM-dd")</div> }
                            @if(c.EndDate.HasValue) { <div>إلى: @c.EndDate.Value.ToString("yyyy-MM-dd")</div> }
                            @if(!c.StartDate.HasValue && !c.EndDate.HasValue) { <span class="text-muted">دائم</span> }
                        </td>
                        <td>
                            @(c.UsageLimit.HasValue ? c.UsageLimit.Value.ToString() : "غير محدود")
                        </td>
                        <td class="fw-bold">
                            @c.UsageCount
                        </td>
                        <td>
                            @if(c.UsageLimit.HasValue) {
                                var remaining = c.UsageLimit.Value - c.UsageCount;
                                <span class="@(remaining <= 0 ? "text-danger fw-bold" : "")">@remaining</span>
                            } else {
                                <span class="text-muted">--</span>
                            }
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(c.CourseTitle)) { <div class="text-primary"><i class="bi bi-book"></i> @c.CourseTitle</div> }
                            @if (!string.IsNullOrEmpty(c.TeacherName)) { <div class="text-success"><i class="bi bi-person"></i> @c.TeacherName</div> }
                            @if (string.IsNullOrEmpty(c.CourseTitle) && string.IsNullOrEmpty(c.TeacherName)) { <span class="text-muted">عام</span> }
                        </td>
                        <td>
                            @if (!c.IsActive) { <span class="badge bg-danger">معطل</span> }
                            else if (c.IsExpired) { <span class="badge bg-secondary">منتهي</span> }
                            else if (c.IsUsageLimitReached) { <span class="badge bg-warning text-dark">مكتمل</span> }
                            else { <span class="badge bg-success">نشط</span> }
                        </td>
                        <td>
                            <form asp-action="ToggleCouponStatus" asp-route-id="@c.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(c.IsActive ? "تعطيل" : "تفعيل")">
                                    <i class="bi @(c.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                </button>
                            </form>
                            <form asp-action="DeleteCoupon" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا الكوبون؟');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
