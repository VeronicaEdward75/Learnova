@model LearnNova.Models.Entities.ApplicationUser
@using LearnNova.Models.Enums
@{
    string currentUserId = (string?)ViewBag.CurrentUserId ?? "";
    var isPending = Model.Role == UserRole.Teacher && !Model.IsActive;
    var badgeClass = Model.IsActive ? "badge-ok" : (isPending ? "badge-pending" : "badge-late");
    var badgeText = Model.IsActive ? "نشط" : (isPending ? "قيد المراجعة" : "موقوف");
    var roleLabel = Model.Role == UserRole.Admin ? "مدير" : Model.Role == UserRole.Teacher ? "مدرس" : "طالب";
    var initial = Model.FullName.Trim().Length > 0 ? Model.FullName.Trim()[0].ToString() : "؟";
}

<div class="mb-4">
    <a asp-action="Users" class="btn btn-sm btn-light" style="font-size:13px; font-weight:600; border:1px solid var(--color-border); background:white;">
        <i class="bi bi-arrow-right me-1"></i> العودة للمستخدمين
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success small mb-4">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="row gx-4">
    <div class="col-lg-4 mb-4">
        <div class="card-box p-4 text-center">
            <div class="d-flex align-items-center justify-content-center mx-auto mb-3 fw-bold shadow-sm" style="width:88px;height:88px;border-radius:var(--radius-xl);background:var(--gradient-primary);color:var(--color-text-inverse);font-size:32px;">
                @initial
            </div>
            <h4 class="fw-bold mb-1" style="color:var(--color-text-primary); letter-spacing:-0.5px;">@Model.FullName</h4>
            <div class="text-muted mb-3" style="font-size:14px;">@Model.Email</div>
            <span class="badge @badgeClass" style="font-weight:600; font-size:12px; padding:6px 12px; border-radius:var(--radius-full);">@badgeText</span>
            
            @if (Model.Id != currentUserId)
            {
                <div class="mt-4 pt-4" style="border-top:1px solid var(--color-border);">
                    <form method="post" asp-action="ToggleActive">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="targetStatus" value="@(Model.IsActive ? "false" : "true")" />
                        <input type="hidden" name="returnUrl" value="@Url.Action("UserDetails", new { id = Model.Id })" />
                        <button type="submit" class="w-100 btn @(Model.IsActive ? "btn-outline-danger" : "btn-success-custom")" style="height:44px;">
                            @(Model.IsActive ? "إيقاف الحساب" : "تفعيل الحساب")
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
    
    <div class="col-lg-8">
        <div class="card-box p-0 mb-4">
            <div class="p-4" style="border-bottom:1px solid var(--color-border);">
                <h5 class="fw-bold mb-0" style="color:var(--color-text-primary);">المعلومات الشخصية والوظيفية</h5>
            </div>
            <div class="p-4">
                <div class="row gy-4">
                    <div class="col-sm-6">
                        <div class="text-muted" style="font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">الدور</div>
                        <div class="fw-semibold" style="font-size:15px; color:var(--color-text-primary);">
                            <span style="color:var(--color-primary); background:rgba(201,166,107,0.1); padding:4px 8px; border-radius:var(--radius-sm);">
                                @roleLabel
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted" style="font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">تاريخ الإنشاء</div>
                        <div class="fw-semibold" style="font-size:15px; color:var(--color-text-primary);">@DateTimeService.ToLocal(Model.CreatedAt).ToString("yyyy-MM-dd")</div>
                    </div>

                    @if (Model.Role == UserRole.Student)
                    {
                        <div class="col-sm-6">
                            <div class="text-muted" style="font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">المرحلة الدراسية</div>
                            <div class="fw-semibold" style="font-size:15px; color:var(--color-text-primary);">@Model.Stage</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted" style="font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">الصف الدراسي</div>
                            <div class="fw-semibold" style="font-size:15px; color:var(--color-text-primary);">@Model.GradeLabel</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted" style="font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">الفصل</div>
                            <div class="fw-semibold" style="font-size:15px; color:var(--color-text-primary);">@(Model.Section ?? "—")</div>
                        </div>
                    }
                    else if (Model.Role == UserRole.Teacher)
                    {
                        <div class="col-sm-6">
                            <div class="text-muted" style="font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">المادة التي يُدرّسها</div>
                            <div class="fw-semibold" style="font-size:15px; color:var(--color-text-primary);">@Model.Subject</div>
                        </div>
                        <div class="col-sm-6">
                            <div class="text-muted" style="font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:4px;">المرحلة المستهدفة</div>
                            <div class="fw-semibold" style="font-size:15px; color:var(--color-text-primary);">@Model.TeachStage</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
