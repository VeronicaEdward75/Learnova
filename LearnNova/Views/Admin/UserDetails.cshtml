@model LearnNova.Models.Entities.ApplicationUser
@using LearnNova.Models.Enums
@{
    string currentUserId = (string?)ViewBag.CurrentUserId ?? "";
    var isPending = Model.Role == UserRole.Teacher && !Model.IsActive;
    var badgeClass = Model.IsActive ? "badge-success" : (isPending ? "badge-warning" : "badge-danger");
    var badgeText = Model.IsActive ? "نشط" : (isPending ? "قيد المراجعة" : "موقوف");
    var roleLabel = Model.Role == UserRole.Admin ? "مدير" : Model.Role == UserRole.Teacher ? "مدرس" : "طالب";
    var initial = Model.FullName.Trim().Length > 0 ? Model.FullName.Trim()[0].ToString() : "؟";
    ViewData["Title"] = "تفاصيل المستخدم";
}

<!-- Back -->
<div class="mb-5 animate-in">
    <a asp-action="Users" class="btn-outline-custom btn-sm">
        <i class="bi bi-arrow-right"></i> العودة للمستخدمين
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success animate-in">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<div class="row g-5 animate-in animate-in-delay-1">
    <!-- Profile Card -->
    <div class="col-lg-4">
        <div class="section-card text-center">
            <div class="section-card-header justify-content-center">
                <div class="section-card-title"><i class="bi bi-person-circle"></i> بطاقة المستخدم</div>
            </div>
            <div class="section-card-body">
                <div class="avatar-circle size-xl mx-auto mb-4" style="font-size:32px;">@initial</div>
                <h4 class="fw-bold mb-1" style="color:var(--color-text-primary);letter-spacing:-0.3px;">@Model.FullName</h4>
                <div style="font-size:13.5px;color:var(--color-text-muted);margin-bottom:var(--space-4);">@Model.Email</div>

                <div class="d-flex justify-content-center gap-3 mb-5">
                    @if (Model.Role == UserRole.Admin)
                    {
                        <span class="role-tag role-tag-admin"><i class="bi bi-shield-fill"></i>مدير</span>
                    }
                    else if (Model.Role == UserRole.Teacher)
                    {
                        <span class="role-tag role-tag-teacher"><i class="bi bi-person-workspace"></i>مدرس</span>
                    }
                    else
                    {
                        <span class="role-tag role-tag-student"><i class="bi bi-mortarboard-fill"></i>طالب</span>
                    }
                    <span class="badge-status @badgeClass">@badgeText</span>
                </div>

                @if (Model.Id != currentUserId)
                {
                    <form method="post" asp-action="ToggleActive" class="m-0">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="targetStatus" value="@(Model.IsActive ? "false" : "true")" />
                        <input type="hidden" name="returnUrl" value="@Url.Action("UserDetails", new { id = Model.Id })" />
                        @if (Model.IsActive)
                        {
                            <button type="submit" class="btn-danger-outline w-100 justify-content-center" style="height:44px;">
                                <i class="bi bi-slash-circle"></i> إيقاف الحساب
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn-success-custom w-100 justify-content-center" style="height:44px;">
                                <i class="bi bi-check-circle"></i> تفعيل الحساب
                            </button>
                        }
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Info Card -->
    <div class="col-lg-8">
        <div class="section-card">
            <div class="section-card-header">
                <div class="section-card-title">
                    <i class="bi bi-info-circle"></i> المعلومات الشخصية والوظيفية
                </div>
            </div>
            <div class="section-card-body" style="padding:0 var(--space-6);">
                <div class="info-row">
                    <div class="info-label">الدور</div>
                    <div class="info-value">@roleLabel</div>
                </div>
                <div class="info-row">
                    <div class="info-label">البريد الإلكتروني</div>
                    <div class="info-value">@Model.Email</div>
                </div>
                <div class="info-row">
                    <div class="info-label">تاريخ الإنشاء</div>
                    <div class="info-value">@DateTimeService.ToLocal(Model.CreatedAt).ToString("yyyy/MM/dd")</div>
                </div>
                <div class="info-row">
                    <div class="info-label">الحالة</div>
                    <div class="info-value"><span class="badge-status @badgeClass">@badgeText</span></div>
                </div>

                @if (Model.Role == UserRole.Student)
                {
                    <div class="info-row">
                        <div class="info-label">المرحلة الدراسية</div>
                        <div class="info-value">@Model.Stage</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">الصف الدراسي</div>
                        <div class="info-value">@Model.GradeLabel</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">الفصل</div>
                        <div class="info-value">@(Model.Section ?? "—")</div>
                    </div>
                }
                else if (Model.Role == UserRole.Teacher)
                {
                    <div class="info-row">
                        <div class="info-label">المادة التي يُدرّسها</div>
                        <div class="info-value">@Model.Subject</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">المرحلة المستهدفة</div>
                        <div class="info-value">@Model.TeachStage</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
