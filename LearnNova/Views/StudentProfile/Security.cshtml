@model LearnNova.Models.ViewModels.Student.SecurityViewModel
@{
    ViewData["Title"] = "الأمان وكلمة المرور";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold mb-0" style="color: var(--color-primary);"><i class="bi bi-shield-lock me-2"></i>الأمان وكلمة المرور</h4>
            <p class="text-muted" style="color: var(--color-text-muted);">قم بإدارة إعدادات الأمان الخاصة بحسابك.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Security Overview -->
        <div class="col-lg-4">
            <div class="card-box h-100 p-4">
                <h5 class="fw-bold mb-4" style="color: var(--color-text-primary);">نشاط الحساب</h5>
                
                <div class="d-flex align-items-center mb-4">
                    <div class="p-3 rounded-circle shadow-sm me-3" style="background: var(--color-surface-muted); color: var(--color-primary);">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <div class="small fw-bold" style="color: var(--color-text-muted);">آخر تسجيل دخول</div>
                        <div class="fw-bold" dir="ltr" style="color: var(--color-text-primary);">@(Model.LastLoginDate?.ToString("yyyy-MM-dd HH:mm") ?? "غير متوفر")</div>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-circle shadow-sm me-3" style="background: var(--color-success-light); color: var(--color-success-dark);">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                    <div>
                        <div class="small fw-bold" style="color: var(--color-text-muted);">حالة الحساب</div>
                        <div class="fw-bold" style="color: var(--color-success-dark);">نشط وآمن</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Change Password Form -->
        <div class="col-lg-8">
            <div class="card-box p-4">
                <h5 class="fw-bold mb-4" style="color: var(--color-text-primary);">تغيير كلمة المرور</h5>
                
                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="CurrentPassword" class="form-label fw-bold" style="color: var(--color-text-primary);"></label>
                        <input asp-for="CurrentPassword" class="form-control form-control-custom" placeholder="أدخل كلمة المرور الحالية" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label fw-bold" style="color: var(--color-text-primary);"></label>
                            <input asp-for="NewPassword" class="form-control form-control-custom" placeholder="كلمة مرور جديدة قوية" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold" style="color: var(--color-text-primary);"></label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-custom" placeholder="تأكيد كلمة المرور الجديدة" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="alert border-0 d-flex align-items-center mb-4" style="background: var(--color-surface-muted); border-right: 4px solid var(--color-primary) !important;">
                        <i class="bi bi-info-circle-fill fs-4 me-3" style="color: var(--color-primary);"></i>
                        <div class="small" style="color: var(--color-text-primary);">
                            <strong>نصائح لكلمة مرور قوية:</strong>
                            <ul class="mb-0 mt-1 ps-3">
                                <li>يجب أن تتكون من 8 أحرف على الأقل.</li>
                                <li>يجب أن تحتوي على حرف كبير وحرف صغير.</li>
                                <li>يجب أن تحتوي على أرقام ورموز خاصة (مثل !@@#$%).</li>
                            </ul>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary-custom px-4 py-2 fw-bold">
                            <i class="bi bi-key me-2"></i> تحديث كلمة المرور
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
