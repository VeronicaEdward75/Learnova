@model LearnNova.Models.ViewModels.Student.CourseCatalogViewModel
@{
    ViewData["Title"] = "تصفح الكورسات";
}

<!-- Page Header -->
<div class="page-header animate-in">
    <div class="page-header-info">
        <div class="page-header-title">
            <div class="ph-icon"><i class="bi bi-grid-1x2"></i></div>
            تصفح الكورسات
        </div>
        <div class="page-header-subtitle">اكتشف الكورسات المتاحة وابدأ رحلتك التعليمية اليوم.</div>
    </div>
</div>

@* Filter bar *@
<form asp-action="Catalog" method="get" class="filter-card animate-in animate-in-delay-1">
    <div class="d-flex flex-wrap gap-3 align-items-end">
        <!-- Search -->
        <div class="flex-grow-1" style="min-width:220px;">
            <div style="font-size:12px;font-weight:700;color:var(--color-text-muted);margin-bottom:var(--space-2);text-transform:uppercase;letter-spacing:0.5px;">بحث</div>
            <div class="search-input-wrap">
                <i class="bi bi-search"></i>
                <input type="text" name="term" value="@Model.Term" class="search-input" placeholder="اسم الكورس أو المدرس...">
            </div>
        </div>
        <!-- Subject -->
        <div style="min-width:160px;">
            <div style="font-size:12px;font-weight:700;color:var(--color-text-muted);margin-bottom:var(--space-2);text-transform:uppercase;letter-spacing:0.5px;">المادة</div>
            <select name="subject" class="form-control-custom">
                <option value="">كل المواد</option>
                @foreach (var opt in Model.SubjectOptions)
                {
                    if (opt.Value == Model.Subject) { <option value="@opt.Value" selected>@opt.Text</option> }
                    else { <option value="@opt.Value">@opt.Text</option> }
                }
            </select>
        </div>
        <!-- Stage -->
        <div style="min-width:155px;">
            <div style="font-size:12px;font-weight:700;color:var(--color-text-muted);margin-bottom:var(--space-2);text-transform:uppercase;letter-spacing:0.5px;">المرحلة</div>
            <select name="stage" class="form-control-custom">
                <option value="">كل المراحل</option>
                @foreach (var opt in Model.StageOptions)
                {
                    if (opt.Value == Model.Stage) { <option value="@opt.Value" selected>@opt.Text</option> }
                    else { <option value="@opt.Value">@opt.Text</option> }
                }
            </select>
        </div>
        <!-- Actions -->
        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary-custom">
                <i class="bi bi-search"></i> بحث
            </button>
            @if (!string.IsNullOrEmpty(Model.Term) || !string.IsNullOrEmpty(Model.Subject) || !string.IsNullOrEmpty(Model.Stage))
            {
                <a asp-action="Catalog" class="btn-icon" title="مسح الفلاتر">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </div>
</form>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger animate-in">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

@if (!Model.Courses.Any())
{
    <div class="empty-state animate-in animate-in-delay-2">
        <div class="es-icon-wrap">
            <i class="bi bi-search es-ico"></i>
        </div>
        <div class="es-title">لا توجد كورسات تطابق بحثك</div>
        <div class="es-desc">جرب كلمات بحث مختلفة أو قم بمسح الفلاتر لعرض جميع الكورسات المتاحة.</div>
        <a asp-action="Catalog" class="btn-outline-custom mx-auto">
            <i class="bi bi-arrow-counterclockwise"></i> عرض الكل
        </a>
    </div>
}
else
{
    <div class="row g-4 animate-in animate-in-delay-2">
        @{
            var coverGradients = new[] {
                "linear-gradient(135deg,#4338CA,#6366F1)",
                "linear-gradient(135deg,#0369A1,#0EA5E9)",
                "linear-gradient(135deg,#059669,#10B981)",
                "linear-gradient(135deg,#8B5E3C,#C4874E)",
                "linear-gradient(135deg,#7C3AED,#A855F7)",
                "linear-gradient(135deg,#BE123C,#F43F5E)",
                "linear-gradient(135deg,#B45309,#F59E0B)",
                "linear-gradient(135deg,#0F766E,#14B8A6)",
            };
        }
        @foreach (var course in Model.Courses)
        {
            var gradient = coverGradients[Math.Abs(course.Title.GetHashCode()) % coverGradients.Length];
            var teacherInitial = course.Teacher.FullName.Trim().Length > 0 ? course.Teacher.FullName.Trim()[0].ToString() : "؟";

            <div class="col-12 col-md-6 col-xl-4">
                <div class="course-card">
                    <!-- Cover -->
                    <div class="course-cover" style="background:@gradient;">
                        <i class="bi bi-journal-richtext course-cover-icon"></i>
                        <span class="course-cover-badge">
                            @(course.Price == 0 ? "مجاني" : $"{course.Price:N0} ج.م")
                        </span>
                    </div>

                    <!-- Body -->
                    <div class="course-body">
                        <div class="course-meta">
                            <span class="badge-status badge-indigo" style="font-size:11px;">@course.Subject</span>
                            <span class="badge-status" style="background:var(--color-surface-muted);color:var(--color-text-secondary);font-size:11px;">@course.Stage</span>
                        </div>
                        <div class="course-title">@course.Title</div>
                        <div class="course-teacher">
                            <div class="teacher-avatar-xs">@teacherInitial</div>
                            @course.Teacher.FullName
                        </div>
                        <div class="course-desc mt-2">
                            @if (!string.IsNullOrEmpty(course.Description))
                            {
                                @(course.Description.Length > 90 ? course.Description[..90] + "..." : course.Description)
                            }
                            else
                            {
                                <span class="fst-italic" style="opacity:.5">لا يوجد وصف للكورس...</span>
                            }
                        </div>
                    </div>

                    <!-- Footer CTA -->
                    <div class="course-footer">
                        <a asp-action="Details" asp-route-id="@course.Id" class="btn-primary-custom w-100" style="justify-content:center;height:42px;">
                            عرض الكورس <i class="bi bi-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-5 pt-3" style="border-top:1px solid var(--color-border);font-size:13px;color:var(--color-text-muted);font-weight:600;">
        يعرض <strong style="color:var(--color-text-primary)">@Model.Courses.Count()</strong> كورس متاح
    </div>
}
