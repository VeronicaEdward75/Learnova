@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "تمت إعادة تعيين كلمة المرور";
}

<div class="auth-card-premium animate-in text-center">
    <div class="auth-header">
        <div class="auth-icon-wrap" style="background:var(--color-success-light); color:var(--color-success-dark);">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h2>تمت العملية بنجاح!</h2>
        <p>لقد تمت إعادة تعيين كلمة المرور الخاصة بحسابك بنجاح. يمكنك الآن تسجيل الدخول باستخدام كلمة المرور الجديدة.</p>
    </div>

    <a asp-action="Login" class="btn-primary-custom w-100 justify-content-center mt-4" style="height:48px;font-size:15px;">
        الانتقال لتسجيل الدخول <i class="bi bi-arrow-left ms-2"></i>
    </a>
</div>
