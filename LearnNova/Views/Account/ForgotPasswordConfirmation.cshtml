@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "تأكيد إرسال البريد";
}

<div class="auth-card-premium animate-in text-center">
    <div class="auth-header">
        <div class="auth-icon-wrap" style="background:var(--color-success-light); color:var(--color-success-dark);">
            <i class="bi bi-envelope-check-fill"></i>
        </div>
        <h2>تحقق من بريدك الإلكتروني</h2>
        <p>إذا كان البريد الإلكتروني الذي أدخلته مسجلاً لدينا، فقد أرسلنا لك للتو رابطاً لإعادة تعيين كلمة المرور الخاصة بك.</p>
    </div>

    <div class="alert alert-info small text-start mb-4" style="background:var(--color-info-light); color:var(--color-info-dark); border:none; padding:16px; border-radius:12px;">
        <i class="bi bi-info-circle-fill mb-2 d-block fs-5"></i>
        يرجى التحقق من مجلد البريد غير الهام (Spam) إذا لم تجد الرسالة في صندوق الوارد خلال دقائق معدودة.
    </div>

    <a asp-action="Login" class="btn-primary-custom w-100 justify-content-center" style="height:48px;font-size:15px;">
        العودة لتسجيل الدخول
    </a>
</div>
