@model LearnNova.Models.ViewModels.Account.ResetPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

<div class="auth-card-premium animate-in">
    <div class="auth-header">
        <div class="auth-icon-wrap" style="background:var(--color-primary-light); color:var(--color-primary-dark);">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h2>كلمة مرور جديدة</h2>
        <p>قم بتعيين كلمة مرور جديدة وقوية لحسابك.</p>
    </div>

    <form asp-action="ResetPassword" method="post" id="resetPasswordForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>
        
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div class="form-group-custom mb-4">
            <label asp-for="Password" class="form-label-custom"></label>
            <div class="input-icon-wrap">
                <i class="bi bi-lock input-icon"></i>
                <input asp-for="Password" class="form-control-custom with-icon" placeholder="••••••••" />
            </div>
            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="form-group-custom mb-5">
            <label asp-for="ConfirmPassword" class="form-label-custom"></label>
            <div class="input-icon-wrap">
                <i class="bi bi-lock-fill input-icon"></i>
                <input asp-for="ConfirmPassword" class="form-control-custom with-icon" placeholder="••••••••" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
        </div>

        <button type="submit" class="btn-primary-custom w-100 justify-content-center" style="height:48px;font-size:15px;" id="submitBtn">
            <span>حفظ كلمة المرور</span>
            <span class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true" id="submitSpinner"></span>
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('resetPasswordForm').addEventListener('submit', function (e) {
            if ($(this).valid()) {
                const btn = document.getElementById('submitBtn');
                const spinner = document.getElementById('submitSpinner');
                btn.classList.add('disabled');
                spinner.classList.remove('d-none');
            }
        });
    </script>
}
