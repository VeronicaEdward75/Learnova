@model LearnNova.Models.ViewModels.LoginViewModel
@{
    Layout = "_AuthLayout";
}

<div class="auth-header text-center mb-4">
    <h3 class="fw-bold" style="color:var(--color-text-primary)">مرحباً بعودتك</h3>
    <p class="text-muted">قم بتسجيل الدخول للوصول إلى حسابك</p>
</div>

<div class="auth-tabs">
    <a asp-action="Login" class="auth-tab-btn active">تسجيل الدخول</a>
    <a asp-action="Register" class="auth-tab-btn">حساب جديد</a>
</div>

@if (TempData["UnconfirmedEmail"] != null)
{
    <div class="alert alert-warning small mb-3 text-center">
        يرجى تأكيد بريدك الإلكتروني قبل تسجيل الدخول.
        <br />
        <a asp-action="ResendVerification" class="fw-bold text-decoration-underline" style="color:#8B5E3C">إعادة إرسال رابط التأكيد</a>
    </div>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <div class="mb-4">
        <label asp-for="Email" class="form-label fw-semibold" style="font-size:13px"></label>
        <input asp-for="Email" class="form-control-custom" placeholder="أدخل البريد الإلكتروني" />
        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
    </div>
    
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <label asp-for="Password" class="form-label fw-semibold mb-0" style="font-size:13px"></label>
            <a asp-action="ForgotPassword" class="text-decoration-none small" style="color:var(--color-primary)">نسيت كلمة المرور؟</a>
        </div>
        <input asp-for="Password" class="form-control-custom mt-2" placeholder="••••••••" />
        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
    </div>
    
    <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label text-muted" style="font-size:13px"></label>
    </div>
    
    <button type="submit" class="btn-primary-custom w-100 justify-content-center" style="height: 48px;">
        تسجيل الدخول
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
