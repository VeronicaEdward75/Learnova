@model LearnNova.Models.ViewModels.PagedResult<LearnNova.Models.ViewModels.Student.AssignmentItemViewModel>
@{
    ViewData["Title"] = "مهامي";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold mb-0" style="color: var(--color-primary);"><i class="bi bi-journal-text me-2"></i>مهامي</h4>
            <p class="text-muted" style="color: var(--color-text-muted);">جميع المهام المطلوبة منك في الكورسات المسجل بها.</p>
        </div>
    </div>

    <div class="animate-in animate-in-delay-1">
        <partial name="_FilterBarPartial" model="ViewBag.Filters" />
    </div>

    @if (!Model.Items.Any())
    {
        <div class="card-box p-5 text-center my-4" style="background:var(--color-surface-muted); box-shadow:none; border:1px dashed var(--color-border);">
            <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width:80px; height:80px; background:white; color:var(--color-text-secondary); border-radius:var(--radius-xl); box-shadow:var(--shadow-sm);">
                <i class="bi bi-journal-x" style="font-size:36px;"></i>
            </div>
            <h5 class="fw-bold mb-2">لا توجد مهام حالياً</h5>
            <p class="text-muted mb-0" style="font-size:14px;">ليس لديك أي مهام مطلوبة في الوقت الحالي.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                var assignment = item.Assignment;
                var submission = item.Submission;
                var isLate = DateTimeService.UtcNow() > assignment.DueDate && submission == null;

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card-box p-0 h-100 d-flex flex-column" style="overflow:hidden; transition:transform 0.2s, box-shadow 0.2s; border:1px solid @(isLate ? "rgba(225,29,72,0.3)" : "var(--color-border)"); box-shadow:var(--shadow-sm);" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-md)';" onmouseout="this.style.transform='none'; this.style.boxShadow='var(--shadow-sm)';">
                        
                        <div class="p-4 border-bottom" style="background:@(isLate ? "var(--color-danger-light)" : "var(--color-surface-muted)");">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div style="width:48px; height:48px; border-radius:var(--radius-md); background:white; color:@(isLate ? "var(--color-danger)" : "var(--color-primary)"); display:flex; align-items:center; justify-content:center; box-shadow:var(--shadow-xs);">
                                    <i class="bi bi-clipboard-check" style="font-size:24px;"></i>
                                </div>
                                
                                @if (submission == null)
                                {
                                    if (isLate)
                                    {
                                        <span class="badge" style="background:var(--color-danger); color:white; padding:6px 10px; font-weight:600; font-size:11px; display:flex; align-items:center; gap:4px;">
                                            <i class="bi bi-exclamation-circle-fill"></i> مفقود (متأخر)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:var(--color-surface-muted); color:var(--color-primary); border:1px solid var(--color-primary-ghost); padding:6px 10px; font-weight:600; font-size:11px;">قيد الانتظار</span>
                                    }
                                }
                                else if (submission.Status == LearnNova.Models.Enums.SubmitStatus.Graded)
                                {
                                    <span class="badge" style="background:var(--color-success-light); color:var(--color-success-dark); border:1px solid rgba(16,185,129,0.3); padding:6px 10px; font-weight:600; font-size:11px;">
                                        تم التقييم (@submission.Grade / @assignment.MaxGrade)
                                    </span>
                                }
                                else if (submission.Status == LearnNova.Models.Enums.SubmitStatus.Late)
                                {
                                    <span class="badge" style="background:var(--color-warning-light); color:var(--color-warning-dark); border:1px solid var(--color-warning); padding:6px 10px; font-weight:600; font-size:11px;">
                                        تم التسليم متأخراً
                                    </span>
                                }
                                else
                                {
                                    <span class="badge" style="background:var(--color-info); color:white; padding:6px 10px; font-weight:600; font-size:11px;">
                                        تم التسليم
                                    </span>
                                }
                            </div>
                            <h6 class="fw-bold mb-1" style="color:var(--color-text-primary); font-size:16px;">@assignment.Title</h6>
                            <div class="d-flex align-items-center mt-2" style="font-size:12px; color:var(--color-text-muted);">
                                <i class="bi bi-journal-bookmark me-1" style="color:var(--color-primary);"></i> @assignment.Course.Title
                            </div>
                            <div class="d-flex align-items-center mt-1" style="font-size:12px; color:var(--color-text-muted);">
                                <i class="bi bi-person me-1" style="color:var(--color-primary);"></i> @assignment.Course.Teacher.FullName
                            </div>
                        </div>

                        <div class="p-4 d-flex flex-column flex-grow-1">
                            <div class="mb-3 p-3 rounded d-flex align-items-center gap-3" style="background:var(--color-surface-muted); border:1px solid var(--color-border-light);">
                                <i class="bi bi-calendar-event text-secondary fs-4"></i>
                                <div>
                                    <div class="text-muted" style="font-size:11px; font-weight:600;">تاريخ الاستحقاق</div>
                                    <div class="fw-bold @(isLate ? "text-danger" : "text-dark")" style="font-size:13px;">@DateTimeService.ToLocal(assignment.DueDate).ToString("yyyy-MM-dd hh:mm tt")</div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2 mb-3 text-muted" style="font-size:12px; font-weight:600;">
                                <i class="bi bi-star-fill text-warning"></i> الدرجة القصوى: <span class="text-dark">@assignment.MaxGrade</span>
                            </div>

                            <p class="text-muted mb-4" style="font-size:13px; line-height:1.6; flex-grow:1;">
                                @(assignment.Description.Length > 80 ? assignment.Description[..80] + "..." : assignment.Description)
                            </p>

                            <a asp-action="Details" asp-route-assignmentId="@assignment.Id" asp-route-returnUrl="/StudentAssignment/Center" class="@(isLate ? "btn-danger" : "btn-primary-custom") w-100 mt-auto" style="height:44px; display:flex; align-items:center; justify-content:center; font-weight:600; font-size:14px; border-radius:var(--radius-md);">
                                التفاصيل والتسليم <i class="bi bi-arrow-left ms-2"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="animate-in animate-in-delay-1 mt-4">
            <partial name="_PaginationPartial" model="Model" />
        </div>
    }
</div>
