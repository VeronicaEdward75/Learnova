@model LearnNova.Models.ViewModels.Student.MyQuizzesViewModel
@{
    ViewData["Title"] = "اختباراتي";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold mb-1" style="color: var(--color-primary);"><i class="bi bi-ui-checks me-2"></i>اختباراتي</h4>
            <p class="text-muted" style="color: var(--color-text-muted);">إدارة ومتابعة جميع اختباراتك في الكورسات المسجل بها.</p>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="card-box p-3 d-flex align-items-center h-100" style="border-right: 4px solid var(--color-primary);">
                <div class="me-3" style="width:48px; height:48px; border-radius:12px; background:var(--color-primary-light); color:var(--color-primary); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-journal-check fs-4"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size:12px; font-weight:600;">إجمالي الاختبارات</div>
                    <div class="fw-bold" style="font-size:20px; color:var(--color-text-primary);">@Model.TotalQuizzes</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card-box p-3 d-flex align-items-center h-100" style="border-right: 4px solid var(--color-success);">
                <div class="me-3" style="width:48px; height:48px; border-radius:12px; background:var(--color-success-light); color:var(--color-success); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size:12px; font-weight:600;">الناجحة</div>
                    <div class="fw-bold" style="font-size:20px; color:var(--color-success-dark);">@Model.PassedCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card-box p-3 d-flex align-items-center h-100" style="border-right: 4px solid var(--color-danger);">
                <div class="me-3" style="width:48px; height:48px; border-radius:12px; background:var(--color-danger-light); color:var(--color-danger); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-x-circle fs-4"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size:12px; font-weight:600;">الراسبة</div>
                    <div class="fw-bold" style="font-size:20px; color:var(--color-danger-dark);">@Model.FailedCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card-box p-3 d-flex align-items-center h-100" style="border-right: 4px solid var(--color-warning);">
                <div class="me-3" style="width:48px; height:48px; border-radius:12px; background:var(--color-warning-light); color:var(--color-warning-dark); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-graph-up fs-4"></i>
                </div>
                <div>
                    <div class="text-muted" style="font-size:12px; font-weight:600;">متوسط الدرجات</div>
                    <div class="fw-bold" style="font-size:20px; color:var(--color-warning-dark);">@Model.AverageScore.ToString("0.0")%</div>
                </div>
            </div>
        </div>
    </div>

    <div class="animate-in animate-in-delay-1">
        <partial name="_FilterBarPartial" model="ViewBag.Filters" />
    </div>

    <!-- Quiz List -->
    @if (!Model.Quizzes.Items.Any())
    {
        <div class="card-box p-5 text-center my-4" style="background:var(--color-surface-muted); box-shadow:none; border:1px dashed var(--color-border);">
            <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width:80px; height:80px; background:white; color:var(--color-text-secondary); border-radius:var(--radius-xl); box-shadow:var(--shadow-sm);">
                <i class="bi bi-ui-checks-grid" style="font-size:36px;"></i>
            </div>
            <h5 class="fw-bold mb-2">لا توجد اختبارات حالياً</h5>
            <p class="text-muted mb-0" style="font-size:14px;">ليس لديك أي اختبارات في الكورسات المسجل بها.</p>
        </div>
    }
    else
    {
        <div class="row g-4" id="quizContainer">
            @foreach (var quiz in Model.Quizzes.Items)
            {
                <div class="col-12 col-xl-6 quiz-card-item" data-title="@quiz.QuizTitle.ToLower()" data-course="@quiz.CourseName.ToLower()" data-status="@quiz.Status">
                    <div class="card-box p-0 h-100 d-flex flex-column" style="overflow:hidden; border:1px solid var(--color-border); transition:transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-md)';" onmouseout="this.style.transform='none'; this.style.boxShadow='var(--shadow-sm)';">
                        <div class="p-4 border-bottom d-flex justify-content-between align-items-start bg-white">
                            <div>
                                <h6 class="fw-bold mb-1 text-primary">@quiz.QuizTitle</h6>
                                <div class="text-muted" style="font-size:12px;"><i class="bi bi-journal-bookmark me-1"></i>@quiz.CourseName &nbsp;|&nbsp; <i class="bi bi-person me-1"></i>@quiz.InstructorName</div>
                            </div>
                            
                            @if (quiz.Status == "Not Started")
                            {
                                <span class="badge" style="background:var(--color-surface-muted); color:var(--color-text-secondary); border:1px solid var(--color-border); padding:6px 12px; font-weight:600;">لم يبدأ</span>
                            }
                            else if (quiz.Status == "In Progress")
                            {
                                <span class="badge" style="background:var(--color-warning-light); color:var(--color-warning-dark); border:1px solid rgba(245,158,11,0.2); padding:6px 12px; font-weight:600;">قيد التنفيذ</span>
                            }
                            else if (quiz.Status == "Passed")
                            {
                                <span class="badge" style="background:var(--color-success-light); color:var(--color-success-dark); border:1px solid rgba(16,185,129,0.2); padding:6px 12px; font-weight:600;"><i class="bi bi-check-circle me-1"></i>ناجح</span>
                            }
                            else if (quiz.Status == "Failed")
                            {
                                <span class="badge" style="background:var(--color-danger-light); color:var(--color-danger-dark); border:1px solid rgba(225,29,72,0.2); padding:6px 12px; font-weight:600;"><i class="bi bi-x-circle me-1"></i>راسب</span>
                            }
                        </div>
                        
                        <div class="p-4 d-flex flex-column flex-grow-1" style="background:var(--color-surface-muted);">
                            <div class="row g-3 mb-4">
                                <div class="col-6 col-sm-3">
                                    <div class="text-muted" style="font-size:11px; font-weight:600;">أفضل درجة</div>
                                    <div class="fw-bold text-dark" style="font-size:14px;">@quiz.BestScore <span class="text-muted fw-normal" style="font-size:11px;">/ @(quiz.QuestionCount * 10)</span></div>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <div class="text-muted" style="font-size:11px; font-weight:600;">درجة النجاح</div>
                                    <div class="fw-bold text-dark" style="font-size:14px;">@quiz.PassingScore <span class="text-muted fw-normal" style="font-size:11px;">/ 100%</span></div>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <div class="text-muted" style="font-size:11px; font-weight:600;">المحاولات</div>
                                    <div class="fw-bold text-dark" style="font-size:14px;">@quiz.TotalAttemptsMade <span class="text-muted fw-normal" style="font-size:11px;">/ @quiz.MaxAttempts</span></div>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <div class="text-muted" style="font-size:11px; font-weight:600;">الوقت</div>
                                    <div class="fw-bold text-dark" style="font-size:14px;">@quiz.TimeLimitMinutes <span class="text-muted fw-normal" style="font-size:11px;">دقيقة</span></div>
                                </div>
                            </div>

                            <div class="mt-auto d-flex gap-2">
                                @if (!quiz.HasUncompletedAttempt && quiz.RemainingAttempts > 0 && !quiz.Passed)
                                {
                                    <a asp-action="TakeQuiz" asp-route-quizId="@quiz.QuizId" class="btn btn-primary-custom flex-grow-1" style="font-weight:600; font-size:13px;">
                                        <i class="bi bi-play-circle me-1"></i> @(quiz.TotalAttemptsMade > 0 ? "محاولة جديدة" : "بدء الاختبار")
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="animate-in animate-in-delay-1 mt-4">
            <partial name="_PaginationPartial" model="Model.Quizzes" />
        </div>
    }
</div>

