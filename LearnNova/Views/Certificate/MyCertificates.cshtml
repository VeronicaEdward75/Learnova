@model IEnumerable<LearnNova.Models.Entities.Certificate>
@{
    ViewData["Title"] = "شهاداتي";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">الشهادات المكتسبة</h2>
</div>

<div class="row g-4">
    @if(Model == null || !Model.Any())
    {
        <div class="col-12">
            <div class="card-box p-5 text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 400px; border: 2px dashed var(--color-border);">
                <div class="mb-4" style="width: 100px; height: 100px; background: rgba(79, 70, 229, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-award-fill" style="font-size: 3rem; color: var(--color-primary);"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">لم تحصل على أي شهادات حتى الآن</h4>
                <p class="text-muted mb-4" style="max-width: 400px;">
                    أكمل الكورسات التي اشتركت بها بنسبة 100% لتحصل على شهادات إتمام معتمدة يمكنك مشاركتها مع أصحاب العمل.
                </p>
                <a asp-controller="Enrollment" asp-action="MyCourses" class="btn btn-primary-custom">
                    <i class="bi bi-mortarboard me-2"></i> متابعة التعلم
                </a>
            </div>
        </div>
    }
    else
    {
        @foreach (var c in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card-box p-0 overflow-hidden h-100 d-flex flex-column shadow-sm hover-lift" style="border: 1px solid var(--color-border); transition: transform 0.2s;">
                    <!-- Certificate Preview Graphic -->
                    <div class="bg-primary p-4 text-white text-center position-relative" style="height:160px; display:flex; flex-direction:column; justify-content:center; overflow: hidden;">
                        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(0,0,0,0) 100%);"></div>
                        <i class="bi bi-patch-check-fill mb-2 position-relative z-index-1" style="font-size: 3rem; color:#ffd700; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2));"></i>
                        <div class="fw-bold fs-5 text-truncate position-relative z-index-1" title="@c.Course?.Title">@(c.Course?.Title ?? "N/A")</div>
                    </div>
                    
                    <div class="p-4 flex-grow-1 d-flex flex-column bg-white">
                        <div class="mb-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small mb-1">المدرس</div>
                                <div class="fw-bold text-dark">@(c.Course?.Teacher?.FullName ?? "N/A")</div>
                            </div>
                        </div>
                        <div class="mb-3 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small mb-1">رقم الشهادة</div>
                                <div class="fw-bold font-monospace text-primary">@c.CertificateNumber</div>
                            </div>
                            <div class="text-end">
                                <div class="text-muted small mb-1">تاريخ الإصدار</div>
                                <div class="fw-bold text-dark">@c.IssueDate.ToString("yyyy-MM-dd")</div>
                            </div>
                        </div>
                        <div class="mt-auto pt-3 border-top d-flex gap-2">
                            <a href="/Document/DownloadCertificate/@c.Id" class="btn btn-primary-custom flex-grow-1 py-2">
                                <i class="bi bi-download me-1"></i> تحميل PDF
                            </a>
                            <a href="/Certificate/Verify?code=@c.VerificationCode" class="btn btn-outline-secondary py-2 px-3" title="التحقق من الشهادة">
                                <i class="bi bi-shield-check"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
