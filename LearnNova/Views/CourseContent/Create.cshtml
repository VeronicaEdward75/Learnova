@model LearnNova.Models.ViewModels.Teacher.CourseContentFormViewModel
@{
    ViewData["Title"] = "إضافة محتوى";
}

<div class="mb-4">
    <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-sm btn-light" style="font-size:13px; font-weight:600; border:1px solid var(--color-border); background:white;">
        <i class="bi bi-arrow-right me-1"></i> العودة لإدارة المحتوى
    </a>
</div>

<div class="d-flex align-items-end mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold mb-1" style="color:var(--color-text-primary); letter-spacing:-0.5px;">إضافة محتوى جديد</h3>
        <p class="text-muted mb-0" style="font-size:14px;">قم بإضافة دروس جديدة للكورس سواء فيديو أو ملفات.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-box p-5">
            <h5 class="fw-bold mb-4" style="color:var(--color-text-primary); border-bottom:1px solid var(--color-border); padding-bottom:12px;">بيانات المحتوى</h5>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CourseId" />

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);">العنوان</label>
                    <input asp-for="Title" class="form-control-custom" style="height:48px;" placeholder="مثال: مقدمة في الكورس أو الملف الأول" />
                    <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4 p-3 rounded" style="background:#f8fafc; border:1px solid var(--color-border);">
                    <label class="form-label fw-bold mb-3" style="font-size:14px; color:var(--color-text-primary);">مصدر المحتوى</label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="SourceType" value="UPLOAD" id="sourceUpload">
                            <label class="form-check-label fw-semibold" for="sourceUpload">
                                رفع ملف من الجهاز
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="SourceType" value="URL" id="sourceUrl" checked>
                            <label class="form-check-label fw-semibold" for="sourceUrl">
                                رابط خارجي (يوتيوب أو درايف)
                            </label>
                        </div>
                    </div>
                </div>

                <div id="uploadContainer" class="mb-4" style="display:none;">
                    <label class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);">ارفع الملف</label>
                    <div id="dragDropArea" class="p-5 text-center rounded d-flex flex-column justify-content-center align-items-center" style="border:2px dashed var(--color-border); background:#ffffff; transition:all 0.2s; cursor:pointer;">
                        <i class="bi bi-cloud-arrow-up-fill mb-3" style="font-size:40px; color:var(--color-primary);"></i>
                        <h6 class="fw-bold mb-1" style="color:var(--color-text-primary);">اسحب وأفلت الملف هنا</h6>
                        <p class="text-muted mb-3" style="font-size:13px;">أو انقر لاختيار ملف من جهازك</p>
                        <span class="badge bg-light text-secondary border">الحد الأقصى: 50MB</span>
                        <input asp-for="UploadFile" type="file" id="fileInput" class="d-none" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.zip,.rar,.jpg,.png,.jpeg,.webp,.mp4,.txt" />
                    </div>
                    <div id="fileInfoArea" class="p-3 mt-3 rounded d-none" style="background:var(--color-success-light); border:1px solid rgba(16,185,129,0.2);">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-file-earmark-check-fill text-success fs-4"></i>
                                <div>
                                    <h6 id="fileNameDisplay" class="mb-0 fw-bold text-success-dark" style="font-size:14px;">filename.pdf</h6>
                                    <small id="fileSizeDisplay" class="text-success" style="opacity:0.8;">2.4 MB</small>
                                </div>
                            </div>
                            <button type="button" id="removeFileBtn" class="btn btn-sm text-danger fw-bold"><i class="bi bi-x-circle-fill"></i> إلغاء</button>
                        </div>
                    </div>
                    <span asp-validation-for="UploadFile" class="text-danger small mt-1 d-block"></span>
                </div>

                <div id="urlContainer" class="mb-4">
                    <label asp-for="FileUrl" class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);">الرابط الخارجي (يوتيوب، درايف، دروب بوكس)</label>
                    <div class="input-group" style="border-radius:var(--radius-md); overflow:hidden; border:1px solid var(--color-border); box-shadow:var(--shadow-xs);">
                        <span class="input-group-text bg-white border-0 text-muted px-3"><i class="bi bi-link-45deg"></i></span>
                        <input asp-for="FileUrl" class="form-control border-0 shadow-none bg-white" style="height:46px;" placeholder="https://..." dir="ltr" />
                    </div>
                    <span asp-validation-for="FileUrl" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="DurationSec" class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);">المدة (بالثواني) - اختياري</label>
                    <div class="input-group" style="border-radius:var(--radius-md); overflow:hidden; border:1px solid var(--color-border); box-shadow:var(--shadow-xs);">
                        <input asp-for="DurationSec" class="form-control border-0 shadow-none bg-white" style="height:46px;" type="number" placeholder="مثال: 600" />
                        <span class="input-group-text bg-white border-0 text-muted px-3" style="font-size:13px; font-weight:600;">ثانية</span>
                    </div>
                    <span asp-validation-for="DurationSec" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex gap-3 pt-3" style="border-top:1px solid var(--color-border);">
                    <button type="submit" class="btn-primary-custom" style="height:48px; padding:0 var(--space-6);">
                        <i class="bi bi-check-lg me-1"></i> حفظ المحتوى
                    </button>
                    <a asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-light" style="height:48px; padding:0 var(--space-6); display:flex; align-items:center; font-weight:600; border:1px solid var(--color-border); background:white;">
                        إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var radios = document.querySelectorAll('input[name="SourceType"]');
            var uploadContainer = document.getElementById('uploadContainer');
            var urlContainer = document.getElementById('urlContainer');
            
            function toggleSource() {
                var selected = document.querySelector('input[name="SourceType"]:checked').value;
                if (selected === 'UPLOAD') {
                    uploadContainer.style.display = 'block';
                    urlContainer.style.display = 'none';
                } else {
                    uploadContainer.style.display = 'none';
                    urlContainer.style.display = 'block';
                }
            }
            
            radios.forEach(r => r.addEventListener('change', toggleSource));
            toggleSource();

            // Drag and Drop Logic
            var dragDropArea = document.getElementById('dragDropArea');
            var fileInput = document.getElementById('fileInput');
            var fileInfoArea = document.getElementById('fileInfoArea');
            var fileNameDisplay = document.getElementById('fileNameDisplay');
            var fileSizeDisplay = document.getElementById('fileSizeDisplay');
            var removeFileBtn = document.getElementById('removeFileBtn');

            dragDropArea.addEventListener('click', () => fileInput.click());

            dragDropArea.addEventListener('dragover', (e) => {
                e.preventDefault();
                dragDropArea.style.backgroundColor = '#f1f5f9';
                dragDropArea.style.borderColor = 'var(--color-primary)';
            });

            dragDropArea.addEventListener('dragleave', () => {
                dragDropArea.style.backgroundColor = '#ffffff';
                dragDropArea.style.borderColor = 'var(--color-border)';
            });

            dragDropArea.addEventListener('drop', (e) => {
                e.preventDefault();
                dragDropArea.style.backgroundColor = '#ffffff';
                dragDropArea.style.borderColor = 'var(--color-border)';
                
                if (e.dataTransfer.files.length) {
                    fileInput.files = e.dataTransfer.files;
                    updateFileInfo();
                }
            });

            fileInput.addEventListener('change', updateFileInfo);

            removeFileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                fileInput.value = '';
                fileInfoArea.classList.add('d-none');
                dragDropArea.classList.remove('d-none');
            });

            function updateFileInfo() {
                if (fileInput.files.length > 0) {
                    var file = fileInput.files[0];
                    fileNameDisplay.textContent = file.name;
                    var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                    fileSizeDisplay.textContent = sizeMB + ' MB';
                    dragDropArea.classList.add('d-none');
                    fileInfoArea.classList.remove('d-none');
                }
            }
        });
    </script>
}
