@model LearnNova.Models.ViewModels.Student.CheckoutFailedViewModel
@{
    ViewData["Title"] = "فشل الدفع";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card-box p-5">
            <div class="mb-4" style="display:inline-flex; width:100px; height:100px; border-radius:50%; background:var(--color-danger-light); color:var(--color-danger); align-items:center; justify-content:center;">
                <i class="bi bi-x-lg" style="font-size:50px;"></i>
            </div>
            <h2 class="fw-bold mb-3" style="color:var(--color-text-primary);">عذراً، فشلت عملية الدفع</h2>
            <p class="text-muted mb-4" style="font-size:15px; line-height:1.6;">
                لم نتمكن من إتمام عملية الشراء للكورس <br/>
                <strong style="color:var(--color-text-primary);">@Model.CourseTitle</strong>
            </p>

            <div class="p-3 mb-4 rounded text-danger" style="background:var(--color-danger-light); border:1px solid rgba(239,68,68,0.2); font-size:14px;">
                <i class="bi bi-exclamation-triangle me-2"></i> <strong>السبب:</strong> @Model.ErrorMessage
            </div>

            <div class="d-flex gap-3 justify-content-center">
                <a asp-controller="Checkout" asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-primary px-4" style="font-weight:600; padding:12px;">
                    <i class="bi bi-arrow-clockwise me-2"></i> حاول مرة أخرى
                </a>
                <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-light px-4" style="font-weight:600; padding:12px; border:1px solid var(--color-border);">
                    العودة للكورس
                </a>
            </div>
        </div>
    </div>
</div>
