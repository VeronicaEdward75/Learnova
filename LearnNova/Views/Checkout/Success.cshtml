@model LearnNova.Models.ViewModels.Student.CheckoutSuccessViewModel
@{
    ViewData["Title"] = "تم الدفع بنجاح";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card-box p-5">
            <div class="mb-4" style="display:inline-flex; width:100px; height:100px; border-radius:50%; background:var(--color-success-light); color:var(--color-success); align-items:center; justify-content:center;">
                <i class="bi bi-check-lg" style="font-size:50px;"></i>
            </div>
            <h2 class="fw-bold mb-3" style="color:var(--color-text-primary);">تم الدفع بنجاح!</h2>
            <p class="text-muted mb-4" style="font-size:15px; line-height:1.6;">
                تهانينا! لقد تم إتمام عملية الشراء بنجاح للكورس <br/>
                <strong style="color:var(--color-text-primary);">@Model.CourseTitle</strong><br/>
                أنت الآن مسجل ويمكنك البدء في التعلم فوراً.
            </p>

            <div class="p-4 mb-4 rounded text-start" style="background:var(--color-surface-muted); border:1px dashed var(--color-border);">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted" style="font-size:13px;">رقم المعاملة:</span>
                    <span class="fw-bold" style="font-size:13px; color:var(--color-text-primary);">@Model.TransactionId</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted" style="font-size:13px;">رقم الفاتورة:</span>
                    <span class="fw-bold" style="font-size:13px; color:var(--color-text-primary);">@Model.InvoiceNumber</span>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-center">
                <a asp-controller="Enrollment" asp-action="MyCourses" class="btn btn-success px-4" style="font-weight:600; padding:12px;">
                    <i class="bi bi-play-circle me-2"></i> ابدأ التعلم الآن
                </a>
                <a asp-controller="Course" asp-action="Catalog" class="btn btn-light px-4" style="font-weight:600; padding:12px; border:1px solid var(--color-border);">
                    تصفح المزيد
                </a>
            </div>
        </div>
    </div>
</div>
