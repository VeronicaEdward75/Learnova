@model LearnNova.Models.ViewModels.Teacher.WalletViewModel
@{
    ViewData["Title"] = "المحفظة والأرباح";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">المحفظة والأرباح</h2>
    <a asp-action="Withdraw" class="btn btn-primary-custom">
        <i class="bi bi-bank2 me-2"></i> طلب سحب
    </a>
</div>

<div class="row g-4 mb-5">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card-box p-4 h-100" style="background: linear-gradient(135deg, rgba(79,70,229,0.1), transparent);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="text-muted fw-bold" style="font-size:14px;">الرصيد المعلق</div>
                <div style="width:40px; height:40px; border-radius:10px; background:var(--color-primary-light); color:var(--color-primary); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--color-text-primary);">@Model.PendingBalance.ToString("N2") <small style="font-size:16px;">EGP</small></h3>
            <div class="text-muted" style="font-size:12px;">أرباح مبيعات الكورسات الأخيرة</div>
        </div>
    </div>
    
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card-box p-4 h-100" style="background: linear-gradient(135deg, rgba(16,185,129,0.1), transparent);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="text-muted fw-bold" style="font-size:14px;">الرصيد المتاح للسحب</div>
                <div style="width:40px; height:40px; border-radius:10px; background:var(--color-success-light); color:var(--color-success); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--color-text-primary);">@Model.AvailableBalance.ToString("N2") <small style="font-size:16px;">EGP</small></h3>
            <div class="text-muted" style="font-size:12px;">رصيد جاهز للتحويل البنكي</div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card-box p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="text-muted fw-bold" style="font-size:14px;">إجمالي الأرباح</div>
                <div style="width:40px; height:40px; border-radius:10px; background:var(--color-surface-muted); color:var(--color-text-primary); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--color-text-primary);">@Model.TotalEarned.ToString("N2") <small style="font-size:16px;">EGP</small></h3>
            <div class="text-muted" style="font-size:12px;">إجمالي ما حققته منذ البداية</div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card-box p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="text-muted fw-bold" style="font-size:14px;">إجمالي المسحوبات</div>
                <div style="width:40px; height:40px; border-radius:10px; background:var(--color-surface-muted); color:var(--color-text-primary); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--color-text-primary);">@Model.TotalWithdrawn.ToString("N2") <small style="font-size:16px;">EGP</small></h3>
            <div class="text-muted" style="font-size:12px;">المبالغ التي تم سحبها بنجاح</div>
        </div>
    </div>
</div>

<div class="card-box p-4 mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label text-muted small fw-bold mb-1">بحث</label>
            <div class="input-group">
                <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="SearchTerm" class="form-control border-start-0 ps-0" placeholder="وصف، طالب، كورس..." value="@Model.Filters.SearchTerm">
            </div>
        </div>
        
        <div class="col-md-2">
            <label class="form-label text-muted small fw-bold mb-1">النوع</label>
            <select name="Type" class="form-select">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Filters.Type) || Model.Filters.Type == "All")">الكل</option>
                <option value="Sale" selected="@(Model.Filters.Type == "Sale")">بيع كورس</option>
                <option value="Refund" selected="@(Model.Filters.Type == "Refund")">استرداد</option>
                <option value="Withdrawal" selected="@(Model.Filters.Type == "Withdrawal")">سحب</option>
                <option value="WalletPurchase" selected="@(Model.Filters.Type == "WalletPurchase")">شراء محفظة</option>
                <option value="WalletRefund" selected="@(Model.Filters.Type == "WalletRefund")">استرداد محفظة</option>
                <option value="Adjustment" selected="@(Model.Filters.Type == "Adjustment")">تعديل</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label text-muted small fw-bold mb-1">الحالة</label>
            <select name="Status" class="form-select">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Filters.Status) || Model.Filters.Status == "All")">الكل</option>
                <option value="Completed" selected="@(Model.Filters.Status == "Completed")">مكتمل</option>
                <option value="Pending" selected="@(Model.Filters.Status == "Pending")">معلق</option>
                <option value="Failed" selected="@(Model.Filters.Status == "Failed")">فشل</option>
                <option value="Cancelled" selected="@(Model.Filters.Status == "Cancelled")">ملغي</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label text-muted small fw-bold mb-1">التاريخ</label>
            <select name="DateRange" class="form-select">
                <option value="All" selected="@(string.IsNullOrEmpty(Model.Filters.DateRange) || Model.Filters.DateRange == "All")">كل الوقت</option>
                <option value="Today" selected="@(Model.Filters.DateRange == "Today")">اليوم</option>
                <option value="Last 7 Days" selected="@(Model.Filters.DateRange == "Last 7 Days")">آخر 7 أيام</option>
                <option value="Last 30 Days" selected="@(Model.Filters.DateRange == "Last 30 Days")">آخر 30 يوم</option>
                <option value="This Month" selected="@(Model.Filters.DateRange == "This Month")">هذا الشهر</option>
                <option value="Last Month" selected="@(Model.Filters.DateRange == "Last Month")">الشهر الماضي</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label text-muted small fw-bold mb-1">الترتيب</label>
            <select name="SortBy" class="form-select">
                <option value="Newest" selected="@(string.IsNullOrEmpty(Model.Filters.SortBy) || Model.Filters.SortBy == "Newest")">الأحدث</option>
                <option value="Oldest" selected="@(Model.Filters.SortBy == "Oldest")">الأقدم</option>
                <option value="Highest Amount" selected="@(Model.Filters.SortBy == "Highest Amount")">الأعلى مبلغاً</option>
                <option value="Lowest Amount" selected="@(Model.Filters.SortBy == "Lowest Amount")">الأقل مبلغاً</option>
            </select>
        </div>

        <div class="col-md-3">
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label text-muted small fw-bold mb-1">الحد الأدنى</label>
                    <input type="number" name="MinAmount" class="form-control" placeholder="0" value="@Model.Filters.MinAmount">
                </div>
                <div class="col-6">
                    <label class="form-label text-muted small fw-bold mb-1">الحد الأقصى</label>
                    <input type="number" name="MaxAmount" class="form-control" placeholder="1000" value="@Model.Filters.MaxAmount">
                </div>
            </div>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary-custom flex-grow-1" style="height: 38px;">تطبيق</button>
            <a href="@Url.Action("Wallet")" class="btn btn-light border" style="height: 38px;">إلغاء</a>
        </div>
    </form>
</div>

<div class="card-box p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="fw-bold mb-0" style="color:var(--color-text-primary);">سجل المعاملات</h5>
    </div>

    @if (Model.Transactions.Count == 0)
    {
        <div class="text-center py-5">
            <div class="mb-3" style="font-size:40px; color:var(--color-border);">
                <i class="bi bi-receipt"></i>
            </div>
            <h5 class="fw-bold text-muted">لا توجد معاملات بعد</h5>
            <p class="text-muted" style="font-size:14px;">سوف تظهر مبيعات الكورسات وعمليات السحب هنا.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr style="color:var(--color-text-primary); font-size:14px; font-weight:600;">
                        <th class="border-bottom pb-3">التاريخ</th>
                        <th class="border-bottom pb-3">النوع</th>
                        <th class="border-bottom pb-3">الوصف</th>
                        <th class="border-bottom pb-3">المبلغ</th>
                        <th class="border-bottom pb-3">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td class="text-muted" style="font-size:14px;">
                                <div>@t.Date.ToString("yyyy-MM-dd")</div>
                                <div style="font-size:12px;">@t.Date.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                @if (t.Type == "Sale")
                                {
                                    <span class="badge" style="background:var(--color-success-light); color:var(--color-success);">بيع كورس</span>
                                }
                                else if (t.Type == "Withdrawal")
                                {
                                    <span class="badge" style="background:var(--color-primary-light); color:var(--color-primary);">سحب رصيد</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@t.Type</span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold" style="font-size:14px; color:var(--color-text-primary);">@t.Description</div>
                                <div class="text-muted" style="font-size:12px;"><i class="bi bi-person"></i> @t.StudentName</div>
                            </td>
                            <td class="fw-bold @(t.Type == "Sale" ? "text-success" : "text-primary")">
                                @(t.Type == "Sale" ? "+" : "-")@t.Amount.ToString("N2")
                            </td>
                            <td>
                                <span class="badge" style="background:var(--color-surface-muted); color:var(--color-text-primary);">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i> مكتمل
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
