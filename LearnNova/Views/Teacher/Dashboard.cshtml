@{
    ViewData["Title"] = "لوحة المدرس";
}

<div class="hero-banner hero-teacher">
    <div class="hero-banner-content">
        <h3>أهلاً بك في منصتك التعليمية 👋</h3>
        <p>قم بإدارة كورساتك ومتابعة أداء طلابك بكل سهولة وفاعلية.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success small">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger small">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="row g-4 mb-5">
    <div class="col-12 col-md-4">
        <a asp-action="MyCourses" class="text-decoration-none">
            <div class="stat-card clickable" style="--from:#7C3AED;--to:#6D28D9">
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-journal-richtext stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="mt-3">
                    <div class="stat-val">@ViewBag.TotalCourses</div>
                    <div class="stat-lbl">إجمالي الكورسات</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="MyCourses" class="text-decoration-none">
            <div class="stat-card clickable" style="--from:#0369A1;--to:#0284C7">
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-check-circle stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="mt-3">
                    <div class="stat-val">@ViewBag.PublishedCount</div>
                    <div class="stat-lbl">كورسات منشورة</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="MyCourses" class="text-decoration-none">
            <div class="stat-card clickable" style="--from:#B45309;--to:#D97706">
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-eye-slash stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right text-muted"></i>
                </div>
                <div class="mt-3">
                    <div class="stat-val">@ViewBag.UnpublishedCount</div>
                    <div class="stat-lbl">كورسات غير منشورة</div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="d-flex flex-wrap gap-3 mt-2">
    <a asp-action="MyCourses" class="btn-primary-custom" style="padding:0 var(--space-8); height:48px; font-size:14px; border-radius:var(--radius-lg)">
        <i class="bi bi-journal-text fs-5"></i> إدارة الكورسات
    </a>
    <a asp-action="CreateCourse" class="btn-outline-custom" style="padding:0 var(--space-8); height:48px; font-size:14px; border-radius:var(--radius-lg)">
        <i class="bi bi-plus-lg fs-5"></i> إنشاء كورس جديد
    </a>
</div>
