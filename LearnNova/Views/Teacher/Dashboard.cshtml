@{
    ViewData["Title"] = "لوحة المدرس";
}

<!-- Hero Banner -->
<div class="hero-banner hero-teacher animate-in">
    <div class="hero-orb"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-banner-content">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div style="width:48px;height:48px;border-radius:14px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.25);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(8px);">
                <i class="bi bi-person-workspace text-white fs-4"></i>
            </div>
            <div>
                <div style="font-size:11px;font-weight:700;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:1px;">منصتك التعليمية</div>
                <h2 class="fw-bold text-white mb-0" style="font-size:22px;letter-spacing:-0.5px;">أهلاً بك في منصتك 👋</h2>
            </div>
        </div>
        <p style="opacity:.8;font-size:14px;font-weight:500;margin:0;">قم بإدارة كورساتك ومتابعة أداء طلابك بكل سهولة.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success animate-in">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger animate-in">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- KPI Cards -->
<div class="row g-4 mb-6 animate-in animate-in-delay-1">
    <div class="col-12 col-md-4">
        <a asp-action="MyCourses" class="text-decoration-none d-block">
            <div class="stat-card clickable" style="--from:#7C3AED;--to:#6D28D9">
                <div class="stat-bg-shape"></div>
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-journals stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right stat-arrow"></i>
                </div>
                <div>
                    <div class="stat-lbl">إجمالي الكورسات</div>
                    <div class="stat-val">@ViewBag.TotalCourses</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="MyCourses" class="text-decoration-none d-block">
            <div class="stat-card clickable" style="--from:#0369A1;--to:#0284C7">
                <div class="stat-bg-shape"></div>
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-globe2 stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right stat-arrow"></i>
                </div>
                <div>
                    <div class="stat-lbl">كورسات منشورة</div>
                    <div class="stat-val">@ViewBag.PublishedCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-action="MyCourses" class="text-decoration-none d-block">
            <div class="stat-card clickable" style="--from:#B45309;--to:#D97706">
                <div class="stat-bg-shape"></div>
                <div class="stat-header">
                    <div class="stat-ico-wrap">
                        <i class="bi bi-pencil-square stat-ico"></i>
                    </div>
                    <i class="bi bi-arrow-up-right stat-arrow"></i>
                </div>
                <div>
                    <div class="stat-lbl">مسودات</div>
                    <div class="stat-val">@ViewBag.UnpublishedCount</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Quick Actions -->
<div class="section-card animate-in animate-in-delay-2">
    <div class="section-card-header">
        <div class="section-card-title">
            <i class="bi bi-lightning-charge-fill"></i>
            إجراءات سريعة
        </div>
    </div>
    <div class="section-card-body">
        <div class="d-flex flex-wrap gap-3">
            <a asp-action="MyCourses" class="btn-primary-custom" style="height:48px;padding:0 var(--space-7);">
                <i class="bi bi-journals"></i> إدارة الكورسات
            </a>
            <a asp-action="CreateCourse" class="btn-outline-custom" style="height:48px;padding:0 var(--space-7);">
                <i class="bi bi-plus-lg"></i> كورس جديد
            </a>
        </div>
    </div>
</div>
