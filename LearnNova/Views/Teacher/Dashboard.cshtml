@model LearnNova.Models.ViewModels.Analytics.TeacherFinanceDashboardViewModel
@{
    ViewData["Title"] = "لوحة المدرس";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">نظرة عامة على نشاطك</h2>
    <a asp-action="Revenue" class="btn btn-outline-custom">
        <i class="bi bi-graph-up-arrow me-2"></i> تقرير الأرباح المفصل
    </a>
</div>

<div class="row g-4 mb-5">
    <div class="col-12 col-md-4">
        <div class="card-box p-4 h-100" style="background: linear-gradient(135deg, rgba(79,70,229,0.1), transparent);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="text-muted fw-bold" style="font-size:14px;">أرباح هذا الشهر</div>
                <div style="width:40px; height:40px; border-radius:10px; background:var(--color-primary-light); color:var(--color-primary); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--color-text-primary);">@Model.MonthlyRevenue.ToString("N2") <small style="font-size:16px;">EGP</small></h3>
            <div class="text-muted" style="font-size:12px;">مجموع مبيعات الكورسات</div>
        </div>
    </div>
    
    <div class="col-12 col-md-4">
        <div class="card-box p-4 h-100" style="background: linear-gradient(135deg, rgba(16,185,129,0.1), transparent);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="text-muted fw-bold" style="font-size:14px;">إجمالي الطلاب</div>
                <div style="width:40px; height:40px; border-radius:10px; background:var(--color-success-light); color:var(--color-success); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--color-text-primary);">@Model.StudentsCount</h3>
            <div class="text-muted" style="font-size:12px;">طالب مسجل في كورساتك</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card-box p-4 h-100" style="background: linear-gradient(135deg, rgba(245,158,11,0.1), transparent);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="text-muted fw-bold" style="font-size:14px;">متوسط التقييم</div>
                <div style="width:40px; height:40px; border-radius:10px; background:#FEF3C7; color:#D97706; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-star-fill"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--color-text-primary);">@Model.AverageRating.ToString("0.0")</h3>
            <div class="text-muted" style="font-size:12px;">من إجمالي التقييمات</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card-box p-4 h-100">
            <h5 class="fw-bold mb-4" style="color:var(--color-text-primary);">إحصائيات الكورسات</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr style="color:var(--color-text-primary); font-size:14px;">
                            <th>الكورس</th>
                            <th>المبيعات</th>
                            <th>الأرباح</th>
                            <th>الطلاب</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var c in Model.CourseAnalytics)
                        {
                            <tr>
                                <td class="fw-bold">@c.Title</td>
                                <td>@c.Sales</td>
                                <td class="fw-bold text-success">@c.Revenue.ToString("N2") <small style="color:var(--color-muted);">EGP</small></td>
                                <td>@c.Students</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card-box p-4 h-100 d-flex flex-column justify-content-center">
            <h5 class="fw-bold mb-4 border-bottom pb-2" style="color:var(--color-text-primary);">ملخص عام</h5>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">إجمالي الكورسات</span>
                <span class="fw-bold">@Model.TotalCourses</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">الكورسات المنشورة</span>
                <span class="fw-bold text-success">@Model.PublishedCount</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">الكورسات المسودة</span>
                <span class="fw-bold text-warning">@Model.UnpublishedCount</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">نسبة إكمال الطلاب للكورسات</span>
                <span class="fw-bold text-primary">@Model.CompletionRate.ToString("0.0")%</span>
            </div>
        </div>
    </div>
</div>
