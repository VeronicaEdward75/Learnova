
@model IEnumerable<LearnNova.Models.Entities.Course>
@{
    ViewData["Title"] = "كورساتي";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success animate-in">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger animate-in">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Page Header -->
<div class="page-header animate-in">
    <div class="page-header-info">
        <div class="page-header-title">
            <div class="ph-icon"><i class="bi bi-journals"></i></div>
            كورساتي
        </div>
        <div class="page-header-subtitle">إدارة كورساتك التعليمية ومتابعة المحتوى والمهام.</div>
    </div>
    <a asp-action="CreateCourse" class="btn-primary-custom">
        <i class="bi bi-plus-circle"></i> كورس جديد
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state animate-in animate-in-delay-1">
        <div class="es-icon-wrap">
            <i class="bi bi-journal-plus es-ico"></i>
        </div>
        <div class="es-title">لا توجد كورسات بعد</div>
        <div class="es-desc">ابدأ بإنشاء أول كورس لك وشارك معرفتك مع الطلاب في المنصة.</div>
        <a asp-action="CreateCourse" class="btn-primary-custom mx-auto">
            <i class="bi bi-plus-circle"></i> إنشاء كورس جديد
        </a>
    </div>
}
else
{
    <div class="row g-4 animate-in animate-in-delay-1">
        @foreach (var course in Model)
        {
            // Pick a gradient per subject type for visual variety
            var coverGradients = new[] {
                "linear-gradient(135deg,#4338CA,#6366F1)",
                "linear-gradient(135deg,#0369A1,#0EA5E9)",
                "linear-gradient(135deg,#059669,#10B981)",
                "linear-gradient(135deg,#8B5E3C,#C4874E)",
                "linear-gradient(135deg,#7C3AED,#A855F7)",
                "linear-gradient(135deg,#BE123C,#F43F5E)",
            };
            var gradient = coverGradients[Math.Abs(course.Title.GetHashCode()) % coverGradients.Length];

            <div class="col-12 col-md-6 col-xl-4">
                <div class="course-card">
                    <!-- Cover -->
                    <div class="course-cover" style="background:@gradient;">
                        <i class="bi bi-journal-richtext course-cover-icon"></i>
                        <span class="course-status-badge @(course.IsPublished ? "badge-success" : "badge-warning")">
                            @(course.IsPublished ? "منشور" : "مسودة")
                        </span>
                    </div>

                    <!-- Body -->
                    <div class="course-body">
                        <div class="course-meta">
                            <span class="badge-status badge-indigo" style="font-size:11px;">@course.Subject</span>
                            <span class="badge-status" style="background:var(--color-surface-muted);color:var(--color-text-secondary);font-size:11px;">@course.Stage</span>
                            <span style="font-size:12.5px;font-weight:700;color:var(--color-primary);margin-right:auto;">
                                @(course.Price == 0 ? "مجاني" : $"{course.Price:N0} ج.م")
                            </span>
                        </div>
                        <div class="course-title">@course.Title</div>
                        <div class="course-desc">
                            @if (!string.IsNullOrEmpty(course.Description))
                            {
                                @(course.Description.Length > 110 ? course.Description[..110] + "..." : course.Description)
                            }
                            else
                            {
                                <span class="fst-italic" style="opacity:.5">لا يوجد وصف لهذا الكورس.</span>
                            }
                        </div>
                    </div>

                    <!-- Footer actions -->
                    <div class="course-footer">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <a asp-controller="CourseContent" asp-action="Index" asp-route-courseId="@course.Id"
                               class="btn-outline-custom btn-sm flex-grow-1" style="justify-content:center;">
                                <i class="bi bi-list-task"></i> المحتوى
                            </a>
                            <a asp-controller="Assignment" asp-action="Index" asp-route-courseId="@course.Id"
                               class="btn-outline-custom btn-sm flex-grow-1" style="justify-content:center;">
                                <i class="bi bi-clipboard-check"></i> المهام
                            </a>
                            <a asp-controller="Quiz" asp-action="Index" asp-route-courseId="@course.Id"
                               class="btn-outline-custom btn-sm flex-grow-1" style="justify-content:center;">
                                <i class="bi bi-pencil-square"></i> الاختبارات
                            </a>
                        </div>

                        <div class="d-flex align-items-center justify-content-between gap-2" style="border-top:1px dashed var(--color-border);padding-top:var(--space-3);">
                            <div class="d-flex gap-1">
                                <a asp-action="EditCourse" asp-route-id="@course.Id" class="btn-icon btn-sm" title="تعديل الكورس">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteCourse" method="post" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الكورس؟ لا يمكن التراجع.')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@course.Id" />
                                    <button type="submit" class="btn-icon btn-sm danger" title="حذف الكورس">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>

                            @if (course.IsPublished)
                            {
                                <form asp-action="Unpublish" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@course.Id" />
                                    <button type="submit" class="btn-warning-custom btn-sm">
                                        إلغاء النشر
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Publish" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@course.Id" />
                                    <button type="submit" class="btn-success-custom btn-sm">
                                        <i class="bi bi-globe2"></i> نشر
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-5 pt-3" style="border-top:1px solid var(--color-border);font-size:13px;color:var(--color-text-muted);font-weight:600;">
        إجمالي: <strong style="color:var(--color-text-primary)">@Model.Count()</strong> كورس
    </div>
}
