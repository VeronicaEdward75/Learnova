
@model IEnumerable<LearnNova.Models.Entities.Course>
@{
    ViewData["Title"] = "كورساتي";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success small mb-4">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger small mb-4">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold mb-1" style="color:var(--color-text-primary); letter-spacing:-0.5px;">كورساتي</h3>
        <p class="text-muted mb-0" style="font-size:14px;">إدارة كورساتك التعليمية ومتابعة المحتوى والمهام.</p>
    </div>
    <a asp-action="CreateCourse" class="btn-primary-custom" style="height:40px;">
        <i class="bi bi-plus-circle me-1"></i> كورس جديد
    </a>
</div>

@if (!Model.Any())
{
    <div class="card-box p-5 text-center mt-4">
        <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width:64px; height:64px; background:var(--color-surface-muted); color:var(--color-text-secondary); border-radius:var(--radius-xl);">
            <i class="bi bi-journal-plus" style="font-size:28px;"></i>
        </div>
        <h5 class="fw-bold mb-2">لا توجد كورسات بعد</h5>
        <p class="text-muted mb-4" style="font-size:14px;">ابدأ بإنشاء أول كورس لك وشارك معرفتك مع الطلاب.</p>
        <a asp-action="CreateCourse" class="btn-primary-custom mx-auto" style="height:44px; padding:0 var(--space-6);">
            <i class="bi bi-plus-circle me-2"></i> إنشاء كورس جديد
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card-box p-0 h-100 d-flex flex-column" style="overflow:hidden; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                    <div class="p-4" style="background:var(--color-surface-muted); border-bottom:1px solid var(--color-border); position:relative;">
                        @if (course.IsPublished)
                        {
                            <span class="badge badge-success" style="position:absolute; top:16px; left:16px; font-weight:600; font-size:11px; padding:6px 10px; border-radius:var(--radius-full);">منشور</span>
                        }
                        else
                        {
                            <span class="badge badge-warning" style="position:absolute; top:16px; left:16px; font-weight:600; font-size:11px; padding:6px 10px; border-radius:var(--radius-full);">مسودة</span>
                        }
                        
                        <div class="d-flex align-items-center justify-content-center mb-3" style="width:48px; height:48px; background:var(--color-surface); border-radius:var(--radius-lg); box-shadow:var(--shadow-sm); color:var(--color-primary);">
                            <i class="bi bi-journal-text" style="font-size:20px;"></i>
                        </div>
                        <h5 class="fw-bold mb-1" style="color:var(--color-text-primary); line-height:1.4;">@course.Title</h5>
                        <div class="d-flex align-items-center gap-2 text-muted" style="font-size:12px; font-weight:600;">
                            <span>@course.Subject</span>
                            <span>•</span>
                            <span>@course.Stage</span>
                            <span>•</span>
                            <span style="color:var(--color-primary);">@course.Price.ToString("N0") ج.م</span>
                        </div>
                    </div>

                    <div class="p-4 flex-grow-1">
                        @if (!string.IsNullOrEmpty(course.Description))
                        {
                            <p class="text-muted mb-0" style="font-size:13px; line-height:1.6;">
                                @(course.Description!.Length > 100 ? course.Description[..100] + "..." : course.Description)
                            </p>
                        }
                        else
                        {
                            <p class="text-muted mb-0" style="font-size:13px; font-style:italic;">لا يوجد وصف لهذا الكورس.</p>
                        }
                    </div>

                    <div class="p-3" style="border-top:1px solid var(--color-border); background:var(--color-surface);">
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            <a asp-controller="CourseContent" asp-action="Index" asp-route-courseId="@course.Id" class="btn btn-sm btn-light flex-grow-1" style="font-size:12px; font-weight:600; border:1px solid var(--color-border); background:white;">
                                <i class="bi bi-list-task me-1"></i> المحتوى
                            </a>
                            <a asp-controller="Assignment" asp-action="Index" asp-route-courseId="@course.Id" class="btn btn-sm btn-light flex-grow-1" style="font-size:12px; font-weight:600; border:1px solid var(--color-border); background:white;">
                                <i class="bi bi-clipboard-check me-1"></i> المهام
                            </a>
                            <a asp-controller="Quiz" asp-action="Index" asp-route-courseId="@course.Id" class="btn btn-sm btn-light flex-grow-1" style="font-size:12px; font-weight:600; border:1px solid var(--color-border); background:white;">
                                <i class="bi bi-pencil-square me-1"></i> الاختبارات
                            </a>
                        </div>
                        <div class="d-flex gap-2 align-items-center justify-content-between pt-2 mt-2" style="border-top:1px dashed var(--color-border);">
                            <div class="d-flex gap-2">
                                <a asp-action="EditCourse" asp-route-id="@course.Id" class="btn btn-sm text-muted hover-primary p-1">
                                    <i class="bi bi-pencil" style="font-size:14px;"></i>
                                </a>
                                <form asp-action="DeleteCourse" method="post" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الكورس؟ لا يمكن التراجع.')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@course.Id" />
                                    <button type="submit" class="btn btn-sm text-muted hover-danger p-1 border-0 bg-transparent">
                                        <i class="bi bi-trash" style="font-size:14px;"></i>
                                    </button>
                                </form>
                            </div>
                            @if (course.IsPublished)
                            {
                                <form asp-action="Unpublish" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@course.Id" />
                                    <button type="submit" class="btn btn-sm" style="font-size:12px; font-weight:600; color:var(--color-warning-dark); background:var(--color-warning-light); border:none; padding:4px 10px;">
                                        إلغاء النشر
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Publish" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@course.Id" />
                                    <button type="submit" class="btn btn-sm btn-success-custom" style="font-size:12px; font-weight:600; padding:4px 10px;">
                                        نشر الكورس
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
