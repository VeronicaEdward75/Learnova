@model IEnumerable<LearnNova.Models.ViewModels.Admin.CouponListViewModel>
@{
    ViewData["Title"] = "إدارة كوبونات الخصم";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">كوبونات الخصم لكورساتك</h2>
    <a asp-action="CreateCoupon" class="btn btn-primary-custom">
        <i class="bi bi-plus-lg me-2"></i>إنشاء كوبون جديد
    </a>
</div>

<div class="card-box p-4">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>الكود</th>
                    <th>النوع والقيمة</th>
                    <th>الكورس</th>
                    <th>الاستخدام</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-bold" style="color:var(--color-primary);">@c.Code</td>
                        <td>
                            @if (c.DiscountType == LearnNova.Models.Enums.DiscountType.Percentage) { <span class="fw-bold">@c.DiscountValue.ToString("0.##")%</span> }
                            else if (c.DiscountType == LearnNova.Models.Enums.DiscountType.FixedAmount) { <span class="fw-bold">@c.DiscountValue.ToString("N2") EGP</span> }
                            else { <span class="badge bg-success">كورس مجاني</span> }
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrEmpty(c.CourseTitle)) { <span>@c.CourseTitle</span> }
                            else { <span class="text-muted">كل كورساتي</span> }
                        </td>
                        <td>
                            @c.UsageCount @(c.UsageLimit.HasValue ? "/ " + c.UsageLimit.Value : "")
                        </td>
                        <td>
                            @if (!c.IsActive) { <span class="badge bg-danger">معطل</span> }
                            else if (c.IsExpired) { <span class="badge bg-secondary">منتهي</span> }
                            else if (c.IsUsageLimitReached) { <span class="badge bg-warning text-dark">مكتمل</span> }
                            else { <span class="badge bg-success">نشط</span> }
                        </td>
                        <td>
                            <form asp-action="ToggleCouponStatus" asp-route-id="@c.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(c.IsActive ? "إيقاف" : "تفعيل")">
                                    <i class="bi @(c.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                </button>
                            </form>
                            <form asp-action="DeleteCoupon" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا الكوبون؟');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
