@model LearnNova.Models.ViewModels.Teacher.CourseFormViewModel
@{
    ViewData["Title"] = "تعديل الكورس";
}

<div class="mb-4">
    <a asp-action="MyCourses" class="btn btn-sm btn-light" style="font-size:13px; font-weight:600; border:1px solid var(--color-border); background:white;">
        <i class="bi bi-arrow-right me-1"></i> العودة إلى كورساتي
    </a>
</div>

<div class="d-flex align-items-end mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold mb-1" style="color:var(--color-text-primary); letter-spacing:-0.5px;">تعديل الكورس</h3>
        <p class="text-muted mb-0" style="font-size:14px;">تحديث بيانات الكورس الأساسية كالعنوان، الوصف، والتصنيف.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card-box p-5">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-4"></div>

            <form asp-action="EditCourse" method="post">
                @Html.AntiForgeryToken()

                <h5 class="fw-bold mb-4" style="color:var(--color-text-primary); border-bottom:1px solid var(--color-border); padding-bottom:12px;">المعلومات الأساسية</h5>

                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);"></label>
                    <input asp-for="Title" class="form-control-custom" style="height:48px;" />
                    <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);"></label>
                    <textarea asp-for="Description" class="form-control-custom" rows="5"
                              style="resize:vertical"></textarea>
                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                </div>

                <h5 class="fw-bold mb-4 mt-5" style="color:var(--color-text-primary); border-bottom:1px solid var(--color-border); padding-bottom:12px;">التصنيف والسعر</h5>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Subject" class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);"></label>
                        <select asp-for="Subject" asp-items="Model.SubjectOptions" class="form-control-custom" style="height:48px;">
                            <option value="">-- اختر المادة --</option>
                        </select>
                        <span asp-validation-for="Subject" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);"></label>
                        <div class="input-group" style="border-radius:var(--radius-md); overflow:hidden; border:1px solid var(--color-border); box-shadow:var(--shadow-xs);">
                            <input asp-for="Price" type="number" min="0" step="0.01" class="form-control border-0 shadow-none bg-white" style="height:46px;" />
                            <span class="input-group-text bg-white border-0 text-muted" style="font-size:13px; font-weight:600;">ج.م</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <label asp-for="Stage" class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);"></label>
                        <select asp-for="Stage" asp-items="Model.StageOptions" class="form-control-custom" style="height:48px;" id="stageSelect">
                            <option value="">-- اختر المرحلة --</option>
                        </select>
                        <span asp-validation-for="Stage" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GradeLevel" class="form-label fw-semibold" style="font-size:13px; color:var(--color-text-secondary);"></label>
                        <select asp-for="GradeLevel" asp-items="Model.GradeOptions" class="form-control-custom" style="height:48px;" id="gradeSelect">
                            <option value="">-- اختر الصف --</option>
                        </select>
                        <span asp-validation-for="GradeLevel" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex gap-3 pt-3" style="border-top:1px solid var(--color-border);">
                    <button type="submit" class="btn-primary-custom" style="height:48px; padding:0 var(--space-6);">
                        <i class="bi bi-check-lg me-1"></i> حفظ التغييرات
                    </button>
                    <a asp-action="MyCourses" class="btn btn-light" style="height:48px; padding:0 var(--space-6); display:flex; align-items:center; font-weight:600; border:1px solid var(--color-border); background:white;">
                        إلغاء
                    </a>
                </div>
            </form>
        </div>
    </div>
    
    <div class="col-lg-4 d-none d-lg-block">
        <div class="card-box p-4" style="background:var(--color-surface-muted);">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-info-circle text-primary" style="font-size:20px;"></i>
                <h6 class="fw-bold mb-0">معلومات التعديل</h6>
            </div>
            <p class="text-muted mb-0" style="font-size:13px; line-height:1.7;">
                عند تعديل بيانات الكورس الأساسية، سيتم تحديثها فوراً للطلاب المسجلين. تأكد من دقة المعلومات كالسعر والمرحلة الدراسية لتجنب أي ارتباك.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // On load: populate grades for the already-selected stage
        (function () {
            const stageSelect = document.getElementById('stageSelect');
            const gradeSelect = document.getElementById('gradeSelect');
            const currentGrade = '@Model.GradeLevel';

            function loadGrades(stage, preselect) {
                gradeSelect.innerHTML = '<option value="">-- اختر الصف --</option>';
                if (!stage) return;

                fetch(`/Teacher/GetGradesByStage?stage=${encodeURIComponent(stage)}`)
                    .then(r => r.json())
                    .then(grades => {
                        grades.forEach(g => {
                            const opt = document.createElement('option');
                            opt.value = g.num;
                            opt.textContent = g.label;
                            if (String(g.num) === preselect) opt.selected = true;
                            gradeSelect.appendChild(opt);
                        });
                    });
            }

            // Pre-populate on page load
            if (stageSelect.value) loadGrades(stageSelect.value, currentGrade);

            stageSelect.addEventListener('change', function () {
                loadGrades(this.value, null);
            });
        })();
    </script>
}
