@model LearnNova.Models.ViewModels.Teacher.WithdrawalRequestViewModel
@{
    ViewData["Title"] = "سحب الأرباح";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">سحب الأرباح</h2>
    <a asp-action="Wallet" class="btn btn-outline-custom">
        <i class="bi bi-arrow-right me-2"></i> العودة للمحفظة
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
}

<div class="row g-4 mb-5">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card-box p-4 h-100" style="background: linear-gradient(135deg, rgba(16,185,129,0.1), transparent);">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="text-muted fw-bold" style="font-size:14px;">الرصيد المتاح للسحب</div>
                <div style="width:40px; height:40px; border-radius:10px; background:var(--color-success-light); color:var(--color-success); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
            <h3 class="fw-bold mb-1" style="color:var(--color-text-primary);">@Model.AvailableBalance.ToString("N2") <small style="font-size:16px;">EGP</small></h3>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card-box p-4">
            <h5 class="fw-bold mb-4" style="color:var(--color-text-primary);">تقديم طلب سحب</h5>
            
            @if (Model.HasPendingRequest)
            {
                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> لديك طلب سحب قيد المراجعة بالفعل. لا يمكنك تقديم طلب آخر حتى يتم الرد على الطلب الحالي.
                </div>
            }
            else if (Model.AvailableBalance < Model.MinimumWithdrawal)
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle-fill me-2"></i> الحد الأدنى للسحب هو @Model.MinimumWithdrawal.ToString("N2") EGP.
                </div>
            }
            else
            {
                <form asp-action="Withdraw" method="post">
                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label text-muted fw-bold">المبلغ المطلوب سحبه</label>
                        <div class="input-group">
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="@Model.MinimumWithdrawal" max="@Model.AvailableBalance" placeholder="0.00" required />
                            <span class="input-group-text">EGP</span>
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                        <div class="form-text" style="font-size:12px;">أقصى مبلغ مسموح: @Model.AvailableBalance.ToString("N2")</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentMethod" class="form-label text-muted fw-bold">طريقة التحويل</label>
                        <select asp-for="PaymentMethod" class="form-select" required>
                            <option value="">-- اختر طريقة التحويل --</option>
                            <option value="BankTransfer">تحويل بنكي</option>
                            <option value="VodafoneCash">فودافون كاش</option>
                            <option value="Instapay">إنستاباي</option>
                            <option value="PayPal">PayPal</option>
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountName" class="form-label text-muted fw-bold">اسم صاحب الحساب</label>
                        <input asp-for="AccountName" class="form-control" placeholder="الاسم كما هو مسجل في الحساب" required />
                        <span asp-validation-for="AccountName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountNumber" class="form-label text-muted fw-bold">رقم الحساب / رقم الهاتف المحفظة</label>
                        <input asp-for="AccountNumber" class="form-control" required />
                        <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BankName" class="form-label text-muted fw-bold">اسم البنك (اختياري)</label>
                        <input asp-for="BankName" class="form-control" placeholder="في حالة التحويل البنكي" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="IBAN" class="form-label text-muted fw-bold">رقم IBAN (اختياري)</label>
                        <input asp-for="IBAN" class="form-control" />
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100 py-2">
                        <i class="bi bi-send me-2"></i> تقديم الطلب
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card-box p-4 h-100">
            <h5 class="fw-bold mb-4" style="color:var(--color-text-primary);">سجل طلبات السحب</h5>
            
            @{
                var withdrawals = ViewBag.Withdrawals as System.Collections.Generic.List<LearnNova.Models.ViewModels.Teacher.WithdrawalHistoryViewModel>;
            }

            @if (withdrawals == null || withdrawals.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
                    لا توجد طلبات سحب سابقة.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr style="color:var(--color-text-primary); font-size:14px;">
                                <th>التاريخ</th>
                                <th>المبلغ</th>
                                <th>الطريقة</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var w in withdrawals)
                            {
                                <tr>
                                    <td class="text-muted" style="font-size:14px;">
                                        <div>@w.RequestedAt.ToString("yyyy-MM-dd")</div>
                                        <div style="font-size:12px;">@w.RequestedAt.ToString("hh:mm tt")</div>
                                    </td>
                                    <td class="fw-bold text-dark">@w.Amount.ToString("N2") <span style="font-size:12px;color:var(--color-muted);">EGP</span></td>
                                    <td class="text-muted" style="font-size:14px;">@w.PaymentMethod</td>
                                    <td>
                                        @if (w.Status == "Pending")
                                        {
                                            <span class="badge" style="background:#FEF3C7; color:#D97706;"><i class="bi bi-hourglass-split me-1"></i> قيد المراجعة</span>
                                        }
                                        else if (w.Status == "Approved")
                                        {
                                            <span class="badge" style="background:#D1FAE5; color:#059669;"><i class="bi bi-check-circle me-1"></i> تمت الموافقة</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background:#FEE2E2; color:#DC2626;"><i class="bi bi-x-circle me-1"></i> مرفوض</span>
                                            @if(!string.IsNullOrEmpty(w.AdminNotes))
                                            {
                                                <div class="mt-1 text-danger" style="font-size:11px;">ملاحظة: @w.AdminNotes</div>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
