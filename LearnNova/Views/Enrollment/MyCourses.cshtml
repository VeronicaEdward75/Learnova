@model IEnumerable<LearnNova.Models.Entities.Enrollment>
@{
    ViewData["Title"] = "كورساتي";
}

@{
    var coverGradients = new[] {
        "linear-gradient(135deg,#4338CA,#6366F1)",
        "linear-gradient(135deg,#0369A1,#0EA5E9)",
        "linear-gradient(135deg,#059669,#10B981)",
        "linear-gradient(135deg,#8B5E3C,#C4874E)",
        "linear-gradient(135deg,#7C3AED,#A855F7)",
        "linear-gradient(135deg,#BE123C,#F43F5E)",
        "linear-gradient(135deg,#B45309,#F59E0B)",
        "linear-gradient(135deg,#0F766E,#14B8A6)",
    };
}
<!-- Page Header -->
<div class="page-header animate-in">
    <div class="page-header-info">
        <div class="page-header-title">
            <div class="ph-icon"><i class="bi bi-mortarboard"></i></div>
            كورساتي
        </div>
        <div class="page-header-subtitle">الكورسات التي اشتركت بها وتتابع التعلم فيها.</div>
    </div>
    <a asp-controller="Course" asp-action="Catalog" class="btn-primary-custom">
        <i class="bi bi-grid-1x2"></i> تصفح المزيد
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state animate-in animate-in-delay-1">
        <div class="es-icon-wrap">
            <i class="bi bi-mortarboard es-ico"></i>
        </div>
        <div class="es-title">لم تشترك في أي كورس بعد</div>
        <div class="es-desc">تصفح الكورسات المتاحة وابدأ رحلتك التعليمية الآن. مئات الكورسات تنتظرك.</div>
        <a asp-controller="Course" asp-action="Catalog" class="btn-primary-custom mx-auto">
            <i class="bi bi-grid-1x2"></i> تصفح الكورسات المتاحة
        </a>
    </div>
}
else
{
    <div class="row g-4 animate-in animate-in-delay-1">
        @foreach (var enrollment in Model)
        {
            var course = enrollment.Course;
            var gradient = coverGradients[Math.Abs(course.Title.GetHashCode()) % coverGradients.Length];
            var teacherInitial = course.Teacher.FullName.Trim().Length > 0 ? course.Teacher.FullName.Trim()[0].ToString() : "؟";

            <div class="col-12 col-md-6 col-xl-4">
                <div class="course-card">
                    <!-- Cover -->
                    <div class="course-cover" style="background:@gradient;">
                        <i class="bi bi-journal-richtext course-cover-icon"></i>
                        <!-- Enrolled badge -->
                        <span class="course-status-badge badge-success">
                            <i class="bi bi-check-circle-fill" style="font-size:9px;"></i> مسجل
                        </span>
                    </div>

                    <!-- Body -->
                    <div class="course-body">
                        <div class="course-meta">
                            <span class="badge-status badge-indigo" style="font-size:11px;">@course.Subject</span>
                            <span class="badge-status" style="background:var(--color-surface-muted);color:var(--color-text-secondary);font-size:11px;">@course.Stage</span>
                        </div>
                        <div class="course-title">@course.Title</div>
                        <div class="course-teacher">
                            <div class="teacher-avatar-xs">@teacherInitial</div>
                            @course.Teacher.FullName
                        </div>
                    </div>

                    <!-- Footer actions -->
                    <div class="course-footer">
                        <a asp-controller="Learning" asp-action="Index" asp-route-courseId="@course.Id"
                           class="btn-primary-custom w-100 mb-2 justify-content-center" style="height:44px;">
                            متابعة التعلم <i class="bi bi-play-circle-fill"></i>
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-controller="StudentAssignment" asp-action="Index" asp-route-courseId="@course.Id"
                               class="btn-outline-custom btn-sm flex-grow-1 justify-content-center">
                                <i class="bi bi-clipboard-check"></i> المهام
                            </a>
                            <a asp-controller="QuizEngine" asp-action="Index" asp-route-courseId="@course.Id"
                               class="btn-outline-custom btn-sm flex-grow-1 justify-content-center">
                                <i class="bi bi-pencil-square"></i> الاختبارات
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-5 pt-3" style="border-top:1px solid var(--color-border);font-size:13px;color:var(--color-text-muted);font-weight:600;">
        مسجل في <strong style="color:var(--color-text-primary)">@Model.Count()</strong> كورس
    </div>
}
