@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ في النظام";
}

<div class="card-box p-5 text-center mx-auto" style="max-width:500px; margin-top:10vh;">
    <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width:80px; height:80px; background:var(--color-danger-light); color:var(--color-danger); border-radius:var(--radius-xl);">
        <i class="bi bi-exclamation-triangle-fill" style="font-size:36px;"></i>
    </div>
    <h3 class="fw-bold mb-3" style="color:var(--color-text-primary); letter-spacing:-0.5px;">حدث خطأ غير متوقع</h3>
    <p class="mb-4" style="color:var(--color-text-secondary); font-size:15px; line-height:1.6;">
        عذراً، حدث خطأ أثناء معالجة طلبك. فريقنا على علم بالمشكلة وجاري العمل على حلها.
    </p>

    @if (Model != null && Model.ShowRequestId)
    {
        <div class="mb-4 p-3 text-start" style="background:var(--color-surface-muted); border-radius:var(--radius-md); font-family:monospace; font-size:12px; color:var(--color-text-secondary);">
            <strong>معرف الطلب:</strong> <code>@Model.RequestId</code>
        </div>
    }

    <a asp-controller="Home" asp-action="Index" class="btn-primary-custom" style="padding:0 var(--space-6); height:44px;">
        <i class="bi bi-house-door me-2"></i> العودة للرئيسية
    </a>
</div>
