<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content="LearnNova - منصة التعليم الإلكتروني الذكية" />
    <title>@ViewData["Title"] - LearnNova</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/cairo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/learnnova.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity!.Name ?? "؟";
    var initial = fullName.Trim().Length > 0 ? fullName.Trim()[0].ToString() : "؟";
    var roleLabel = User.IsInRole("Admin") ? "مدير النظام" : User.IsInRole("Teacher") ? "مدرّس" : "طالب";
    var activeNav = ViewBag.ActiveNav as string ?? "";

    <div id="sidebar-overlay" onclick="closeSidebar()"></div>

    <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
         PREMIUM FLOATING SIDEBAR
         â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
    <aside id="sidebar" role="navigation" aria-label="القائمة الرئيسية">

        <!-- Logo -->
        <div class="logo-wrap">
            <div class="logo-icon" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2L3 7V17L12 22L21 17V7L12 2Z" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"/>
                    <path d="M8 10L12 13L16 10" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 13V18" stroke="white" stroke-width="2" stroke-linecap="round"/>
                    <circle cx="12" cy="9" r="2" fill="white"/>
                </svg>
            </div>
            <div>
                <div class="logo-text">LearnNova</div>
                <div class="logo-sub">منصة التعليم الذكية</div>
            </div>
        </div>

        <!-- Navigation -->
        <nav id="sb-nav" aria-label="التنقل">
            @if (User.IsInRole("Admin"))
            {
                <div class="nav-section-title">الرئيسية</div>
                <a class="nav-link-item @(activeNav == "dashboard" ? "active" : "")"
                   asp-controller="Admin" asp-action="Dashboard"
                   aria-current="@(activeNav == "dashboard" ? "page" : null)">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    <span>لوحة التحكم</span>
                </a>

                <div class="nav-section-title">إدارة المستخدمين</div>
                <a class="nav-link-item @(activeNav == "users" ? "active" : "")"
                   asp-controller="Admin" asp-action="Users">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>المستخدمون</span>
                </a>
                <a class="nav-link-item @(activeNav == "create-admin" ? "active" : "")"
                   asp-controller="Admin" asp-action="CreateAdmin">
                    <i class="bi bi-person-badge" aria-hidden="true"></i>
                    <span>إنشاء مدير</span>
                </a>

                <div class="nav-section-title">المحتوى التعليمي</div>
                <a class="nav-link-item @(activeNav == "courses" ? "active" : "")"
                   asp-controller="Admin" asp-action="Courses">
                    <i class="bi bi-journals" aria-hidden="true"></i>
                    <span>الكورسات</span>
                </a>

                <div class="nav-section-title">السوق والمالية</div>
                <a class="nav-link-item @(activeNav == "finance" ? "active" : "")" asp-controller="Admin" asp-action="Finance">
                    <i class="bi bi-currency-dollar"></i><span>المالية والأرباح</span>
                </a>
                <a class="nav-link-item @(activeNav == "withdrawals" ? "active" : "")" asp-controller="Admin" asp-action="Withdrawals">
                    <i class="bi bi-bank"></i><span>طلبات السحب</span>
                </a>
                <a class="nav-link-item @(activeNav == "refunds" ? "active" : "")" asp-controller="Admin" asp-action="Refunds">
                    <i class="bi bi-arrow-counterclockwise"></i><span>المرتجعات</span>
                </a>
                <a class="nav-link-item @(activeNav == "coupons" ? "active" : "")" asp-controller="Admin" asp-action="Coupons">
                    <i class="bi bi-ticket-perforated"></i><span>الكوبونات</span>
                </a>
            }
            else if (User.IsInRole("Teacher"))
            {
                <div class="nav-section-title">الرئيسية</div>
                <a class="nav-link-item @(activeNav == "dashboard" ? "active" : "")"
                   asp-controller="Teacher" asp-action="Dashboard">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    <span>لوحة التحكم</span>
                </a>

                <div class="nav-section-title">التعليم</div>
                <a class="nav-link-item @(activeNav == "my-courses" ? "active" : "")"
                   asp-controller="Teacher" asp-action="MyCourses">
                    <i class="bi bi-journals" aria-hidden="true"></i>
                    <span>كورساتي</span>
                </a>
                <a class="nav-link-item @(activeNav == "create-course" ? "active" : "")"
                   asp-controller="Teacher" asp-action="CreateCourse">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                    <span>إضافة كورس</span>
                </a>

                <div class="nav-section-title">المالية والمبيعات</div>
                <a class="nav-link-item @(activeNav == "wallet" ? "active" : "")" asp-controller="Teacher" asp-action="Wallet">
                    <i class="bi bi-wallet2"></i><span>محفظتي</span>
                </a>
                <a class="nav-link-item @(activeNav == "revenue" ? "active" : "")" asp-controller="Teacher" asp-action="Revenue">
                    <i class="bi bi-graph-up-arrow"></i><span>الأرباح</span>
                </a>
                <a class="nav-link-item @(activeNav == "withdraw" ? "active" : "")" asp-controller="Teacher" asp-action="Withdraw">
                    <i class="bi bi-cash-coin"></i><span>سحب الأرباح</span>
                </a>
                <a class="nav-link-item @(activeNav == "coupons" ? "active" : "")" asp-controller="Teacher" asp-action="Coupons">
                    <i class="bi bi-ticket-perforated"></i><span>الكوبونات</span>
                </a>
            }
                                    else if (User.IsInRole("Student"))
            {
                <div class="nav-section-title">التعليم</div>
                <a class="nav-link-item @(activeNav == "catalog" ? "active" : "")"
                   asp-controller="Course" asp-action="Catalog">
                    <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                    <span>تصفح الكورسات</span>
                </a>
                <a class="nav-link-item @(activeNav == "my-courses" ? "active" : "")"
                   asp-controller="Enrollment" asp-action="MyCourses">
                    <i class="bi bi-mortarboard" aria-hidden="true"></i>
                    <span>كورساتي</span>
                </a>

                <div class="nav-section-title">المدفوعات والمشتريات</div>
                <a class="nav-link-item @(activeNav == "orders" ? "active" : "")" asp-controller="Order" asp-action="History">
                    <i class="bi bi-receipt"></i><span>سجل الطلبات</span>
                </a>
                <a class="nav-link-item @(activeNav == "payments" ? "active" : "")" asp-controller="Order" asp-action="Payments">
                    <i class="bi bi-credit-card"></i><span>المدفوعات</span>
                </a>
                <a class="nav-link-item @(activeNav == "invoices" ? "active" : "")" asp-controller="Order" asp-action="Invoices">
                    <i class="bi bi-file-earmark-text"></i><span>الفواتير</span>
                </a>
                <a class="nav-link-item @(activeNav == "wallet" ? "active" : "")" asp-controller="Order" asp-action="Wallet">
                    <i class="bi bi-wallet2"></i><span>المحفظة</span>
                </a>
                <a class="nav-link-item" asp-controller="Order" asp-action="History">
                    <i class="bi bi-arrow-counterclockwise"></i><span>طلبات الاسترداد</span>
                </a>
                <a class="nav-link-item @(activeNav == "certificates" ? "active" : "")" asp-controller="Certificate" asp-action="MyCertificates">
                    <i class="bi bi-award"></i><span>الشهادات</span>
                </a>
            }
            else
            {
                <a class="nav-link-item active" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house" aria-hidden="true"></i>
                    <span>الرئيسية</span>
                </a>
            }

            <div class="nav-section-title" style="margin-top: 12px;">الحساب</div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="nav-link-item" style="color:var(--color-danger)!important">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    <span>تسجيل الخروج</span>
                </button>
            </form>
        </nav>

        <!-- User Profile Card -->
        <div class="user-card-wrap">
            <div class="user-card" role="button" tabindex="0" aria-label="بيانات المستخدم">
                <div class="user-avatar" aria-hidden="true">@initial</div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="user-name text-truncate">@fullName</div>
                    <div class="user-role">@roleLabel</div>
                </div>
                <i class="bi bi-chevron-expand" style="color:var(--color-text-muted);font-size:13px;flex-shrink:0" aria-hidden="true"></i>
            </div>
        </div>
    </aside>

    <!-- ──────────────────────────────────────────────────────────
         MOBILE TOP BAR
         ────────────────────────────────────────────────────────── -->
    <div id="mob-topbar" role="banner">
        <button class="mob-menu-btn" onclick="openSidebar()" aria-label="فتح القائمة">
            <i class="bi bi-list" aria-hidden="true"></i>
        </button>
        <div class="mob-logo-wrap">
            <div class="logo-icon" style="width:32px;height:32px;border-radius:8px;background:var(--gradient-primary);display:inline-flex;align-items:center;justify-content:center;box-shadow:var(--shadow-primary);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M8 10L12 13L16 10" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 13V18" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="12" cy="9" r="2" fill="white"/>
                </svg>
            </div>
            <span class="fw-bold" style="color:var(--color-text-primary);font-size:15px;letter-spacing:-0.2px">LearnNova</span>
        </div>
        <div style="width:36px"></div>
    </div>

    <!-- ──────────────────────────────────────────────────────────
         MAIN CONTENT AREA
         ────────────────────────────────────────────────────────── -->
    <div id="main-wrap">
        <div id="main">

            <!-- Premium Glass Topbar -->
            <header class="topbar" role="banner">
                <!-- Page title -->
                <div class="d-flex align-items-center gap-3">
                    <h1 class="topbar-page-title">@ViewData["Title"]</h1>
                </div>

                <!-- Topbar right actions -->
                <div class="d-flex align-items-center gap-2">
                    <!-- Search -->
                    <div class="topbar-search d-none d-md-flex" role="search" aria-label="بحث سريع" tabindex="0" id="topbar-search-btn">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <span>البحث في المنصة...</span>
                        <span class="shortcut" aria-label="Ctrl K">⌘ K</span>
                    </div>

                    <!-- Notifications -->
                    <div class="topbar-actions">
                        <button class="topbar-btn" id="notif-btn" aria-label="الإشعارات">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                        </button>
                    </div>

                    <!-- Profile -->
                    <div class="profile-trigger" id="profile-trigger" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false">
                        <div class="profile-avatar-sm" aria-hidden="true">@initial</div>
                        <span class="profile-name-sm d-none d-lg-block">@fullName</span>
                        <i class="bi bi-chevron-down d-none d-lg-block" style="font-size:11px;color:var(--color-text-muted)" aria-hidden="true"></i>

                        <!-- Dropdown -->
                        <div class="profile-dropdown" role="menu" aria-label="قائمة الملف الشخصي">
                            <div style="padding:var(--space-3) var(--space-3) var(--space-2);">
                                <div style="font-size:12.5px;font-weight:700;color:var(--color-text-primary);">@fullName</div>
                                <div style="font-size:11.5px;color:var(--color-text-muted);margin-top:1px;">@roleLabel</div>
                            </div>
                            <div class="profile-dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="profile-dropdown-item danger" role="menuitem">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                    تسجيل الخروج
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Page body -->
            <main class="page-content" role="main" id="page-main-content">
                @RenderBody()
            </main>
        </div>

        <!-- Premium App Footer -->
        <footer class="app-footer" role="contentinfo">
            <div class="footer-brand">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="flex-shrink:0">
                    <path d="M12 2L3 7V17L12 22L21 17V7L12 2Z" fill="rgba(139,94,60,0.15)" stroke="var(--color-primary)" stroke-width="1.5"/>
                    <path d="M8 10L12 13L16 10" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M12 13V18" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round"/>
                    <circle cx="12" cy="9" r="2" fill="var(--color-primary)"/>
                </svg>
                <span>LearnNova</span>
            </div>
            <div class="footer-copy">
                &copy; @DateTime.Now.Year LearnNova. جميع الحقوق محفوظة.
                <span style="margin-right: 8px; opacity: 0.6">v3.0</span>
            </div>
            <div class="footer-links">
                <a href="#">المساعدة</a>
                <a href="#">الخصوصية</a>
                <a href="#">الشروط</a>
            </div>
        </footer>
    </div>

    <!-- ──────────────────────────────────────────────────────────
         MOBILE BOTTOM NAV
         ────────────────────────────────────────────────────────── -->
    <nav id="bottomnav" aria-label="تنقل سريع">
        @if (User.IsInRole("Admin"))
        {
            <button onclick="location.href='@Url.Action("Dashboard", "Admin")'" class="@(activeNav == "dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2" aria-hidden="true"></i>الرئيسية
            </button>
            <button onclick="location.href='@Url.Action("Users", "Admin")'" class="@(activeNav == "users" ? "active" : "")">
                <i class="bi bi-people" aria-hidden="true"></i>المستخدمون
            </button>
            <button onclick="location.href='@Url.Action("Courses", "Admin")'" class="@(activeNav == "courses" ? "active" : "")">
                <i class="bi bi-journals" aria-hidden="true"></i>الكورسات
            </button>
        }
        else if (User.IsInRole("Teacher"))
        {
            <button onclick="location.href='@Url.Action("Dashboard", "Teacher")'" class="@(activeNav == "dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2" aria-hidden="true"></i>الرئيسية
            </button>
            <button onclick="location.href='@Url.Action("MyCourses", "Teacher")'" class="@(activeNav == "my-courses" ? "active" : "")">
                <i class="bi bi-journals" aria-hidden="true"></i>كورساتي
            </button>
            <button onclick="location.href='@Url.Action("CreateCourse", "Teacher")'" class="@(activeNav == "create-course" ? "active" : "")">
                <i class="bi bi-plus-circle" aria-hidden="true"></i>إضافة
            </button>
        }
        else if (User.IsInRole("Student"))
        {
            <button onclick="location.href='@Url.Action("Catalog", "Course")'" class="@(activeNav == "catalog" ? "active" : "")">
                <i class="bi bi-grid-1x2" aria-hidden="true"></i>تصفح
            </button>
            <button onclick="location.href='@Url.Action("MyCourses", "Enrollment")'" class="@(activeNav == "my-courses" ? "active" : "")">
                <i class="bi bi-mortarboard" aria-hidden="true"></i>كورساتي
            </button>
        }
        else
        {
            <button onclick="location.href='@Url.Action("Index", "Home")'">
                <i class="bi bi-house" aria-hidden="true"></i>الرئيسية
            </button>
        }
    </nav>
    <div id="modal-root"></div>
}
else
{
    <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:var(--space-4);padding:var(--space-8);">
        <div style="width:60px;height:60px;border-radius:var(--radius-xl);background:var(--gradient-primary);display:flex;align-items:center;justify-content:center;box-shadow:var(--shadow-primary);margin-bottom:var(--space-2);">
            <i class="bi bi-lock text-white fs-4"></i>
        </div>
        <h2 style="font-weight:800;color:var(--color-text-primary);">يجب تسجيل الدخول</h2>
        <p style="color:var(--color-text-muted);font-size:14px;">هذه الصفحة تتطلب تسجيل الدخول للوصول إليها.</p>
        <a asp-controller="Account" asp-action="Login" class="btn-primary-custom" style="height:48px;padding:0 var(--space-8);">
            <i class="bi bi-box-arrow-in-right"></i> تسجيل الدخول
        </a>
    </div>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/learnnova.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>


