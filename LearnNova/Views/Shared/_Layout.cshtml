<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - LearnNova</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/cairo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/learnnova.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity!.Name ?? "؟";
    var initial = fullName.Trim().Length > 0 ? fullName.Trim()[0].ToString() : "؟";
    var roleLabel = User.IsInRole("Admin") ? "مدير النظام" : User.IsInRole("Teacher") ? "مدرس" : "طالب";
    var activeNav = ViewBag.ActiveNav as string ?? "";

    <div id="sidebar-overlay" onclick="closeSidebar()"></div>

    <div id="sidebar">
        <div class="logo-wrap d-flex align-items-center gap-3">
            <div class="logo-icon">LN</div>
            <div>
                <div class="logo-text">LearnNova</div>
                <div class="logo-sub">منصة التعليم الإلكتروني</div>
            </div>
        </div>
        
        <nav id="sb-nav">
            @if (User.IsInRole("Admin"))
            {
                <div class="nav-section-title">الرئيسية</div>
                <a class="nav-link-item @(activeNav == "dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-house"></i><span>لوحة التحكم</span>
                </a>
                
                <div class="nav-section-title">الإدارة</div>
                <a class="nav-link-item @(activeNav == "users" ? "active" : "")" asp-controller="Admin" asp-action="Users">
                    <i class="bi bi-people"></i><span>المستخدمون</span>
                </a>
                <a class="nav-link-item @(activeNav == "create-admin" ? "active" : "")" asp-controller="Admin" asp-action="CreateAdmin">
                    <i class="bi bi-person-plus"></i><span>إنشاء مدير</span>
                </a>
                
                <div class="nav-section-title">التعليم</div>
                <a class="nav-link-item @(activeNav == "courses" ? "active" : "")" asp-controller="Admin" asp-action="Courses">
                    <i class="bi bi-journal-richtext"></i><span>الكورسات</span>
                </a>
            }
            else if (User.IsInRole("Teacher"))
            {
                <div class="nav-section-title">الرئيسية</div>
                <a class="nav-link-item @(activeNav == "dashboard" ? "active" : "")" asp-controller="Teacher" asp-action="Dashboard">
                    <i class="bi bi-house"></i><span>لوحة التحكم</span>
                </a>
                
                <div class="nav-section-title">التعليم</div>
                <a class="nav-link-item @(activeNav == "my-courses" ? "active" : "")" asp-controller="Teacher" asp-action="MyCourses">
                    <i class="bi bi-journal-richtext"></i><span>كورساتي</span>
                </a>
                <a class="nav-link-item @(activeNav == "create-course" ? "active" : "")" asp-controller="Teacher" asp-action="CreateCourse">
                    <i class="bi bi-plus-square"></i><span>إنشاء كورس</span>
                </a>
            }
            else if (User.IsInRole("Student"))
            {
                <div class="nav-section-title">التعليم</div>
                <a class="nav-link-item @(activeNav == "catalog" ? "active" : "")" asp-controller="Course" asp-action="Catalog">
                    <i class="bi bi-grid"></i><span>تصفح الكورسات</span>
                </a>
                <a class="nav-link-item @(activeNav == "my-courses" ? "active" : "")" asp-controller="Enrollment" asp-action="MyCourses">
                    <i class="bi bi-journal-check"></i><span>كورساتي</span>
                </a>
            }
            else
            {
                <a class="nav-link-item active" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house"></i><span>الرئيسية</span>
                </a>
            }
            
            <div class="nav-section-title mt-4">الحساب</div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="nav-link-item text-danger" style="color:var(--color-danger)!important">
                    <i class="bi bi-box-arrow-right"></i><span>تسجيل الخروج</span>
                </button>
            </form>
        </nav>
        
        <div class="user-card-wrap">
            <div class="user-card">
                <div class="user-avatar">@initial</div>
                <div class="flex-grow-1">
                    <div class="user-name">@fullName</div>
                    <div class="user-role">@roleLabel</div>
                </div>
                <i class="bi bi-chevron-expand" style="color:var(--color-text-muted);font-size:14px"></i>
            </div>
        </div>
    </div>

    <div id="mob-topbar">
        <button class="btn btn-sm btn-light" onclick="openSidebar()"><i class="bi bi-list fs-5"></i></button>
        <div class="d-flex align-items-center gap-2">
            <div class="logo-icon" style="width:32px;height:32px;font-size:13px;border-radius:8px;background:var(--color-surface-raised);border:1px solid var(--color-border);display:inline-flex;align-items:center;justify-content:center;color:var(--color-primary);font-weight:800;">LN</div>
            <span class="fw-bold" style="color:var(--color-text-primary)">LearnNova</span>
        </div>
        <div style="width:32px"></div>
    </div>

    <div id="main-wrap">
        <div id="main">
            <div class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <h5 class="topbar-page-title">@ViewData["Title"]</h5>
                </div>
                
                <div class="d-flex align-items-center gap-4">
                    <div class="topbar-search d-none d-md-flex">
                        <i class="bi bi-search"></i>
                        <span>البحث في المنصة...</span>
                        <span class="shortcut">Ctrl K</span>
                    </div>
                    
                    <div class="topbar-actions">
                        <button class="topbar-btn"><i class="bi bi-bell"></i></button>
                    </div>
                </div>
            </div>
            
            <div class="page-content">
                @RenderBody()
            </div>
        </div>
        
        <footer class="app-footer">
            <div>&copy; @DateTime.Now.Year LearnNova. جميع الحقوق محفوظة.</div>
            <div class="d-flex gap-3">
                <a href="#">المساعدة</a>
                <a href="#">الخصوصية</a>
                <a href="#">الشروط</a>
            </div>
        </footer>
    </div>

    <nav id="bottomnav">
        @if (User.IsInRole("Admin"))
        {
            <button onclick="location.href='@Url.Action("Dashboard", "Admin")'"><i class="bi bi-house-fill"></i>الرئيسية</button>
            <button onclick="location.href='@Url.Action("Users", "Admin")'"><i class="bi bi-people-fill"></i>المستخدمون</button>
            <button onclick="location.href='@Url.Action("Courses", "Admin")'"><i class="bi bi-journal-richtext"></i>الكورسات</button>
        }
        else if (User.IsInRole("Teacher"))
        {
            <button onclick="location.href='@Url.Action("Dashboard", "Teacher")'"><i class="bi bi-house-fill"></i>الرئيسية</button>
            <button onclick="location.href='@Url.Action("MyCourses", "Teacher")'"><i class="bi bi-journal-richtext"></i>كورساتي</button>
            <button onclick="location.href='@Url.Action("CreateCourse", "Teacher")'"><i class="bi bi-plus-circle-fill"></i>إضافة</button>
        }
        else if (User.IsInRole("Student"))
        {
            <button onclick="location.href='@Url.Action("Catalog", "Course")'"><i class="bi bi-grid-fill"></i>تصفح</button>
            <button onclick="location.href='@Url.Action("MyCourses", "Enrollment")'"><i class="bi bi-journal-richtext"></i>كورساتي</button>
        }
        else
        {
            <button onclick="location.href='@Url.Action("Index", "Home")'"><i class="bi bi-house-fill"></i>الرئيسية</button>
        }
    </nav>
    <div id="modal-root"></div>
}
else
{
    <div class="p-5 text-center">
        <p>يجب تسجيل الدخول لعرض هذه الصفحة.</p>
        <a asp-controller="Account" asp-action="Login" class="btn-primary-custom">تسجيل الدخول</a>
    </div>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/learnnova.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
