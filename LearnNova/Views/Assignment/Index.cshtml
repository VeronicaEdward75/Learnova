@model IEnumerable<LearnNova.Models.Entities.Assignment>
@{
    ViewData["Title"] = "المهام - " + ViewBag.CourseTitle;
}

<div class="mb-4">
    <a asp-controller="Teacher" asp-action="MyCourses" class="btn btn-sm btn-light" style="font-size:13px; font-weight:600; border:1px solid var(--color-border); background:white;">
        <i class="bi bi-arrow-right me-1"></i> العودة إلى كورساتي
    </a>
</div>

<div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
    <div>
        <h3 class="fw-bold mb-1" style="color:var(--color-text-primary); letter-spacing:-0.5px;">المهام: @ViewBag.CourseTitle</h3>
        <p class="text-muted mb-0" style="font-size:14px;">إدارة المهام والتكليفات وتقييم تسليمات الطلاب.</p>
    </div>
    <a asp-action="Create" asp-route-courseId="@ViewBag.CourseId" class="btn-primary-custom" style="height:40px;">
        <i class="bi bi-plus-circle me-1"></i> إضافة مهمة جديدة
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success small mb-4">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger small mb-4">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="card-box p-5 text-center my-4" style="background:var(--color-surface-muted); box-shadow:none; border:1px dashed var(--color-border);">
        <div class="d-inline-flex align-items-center justify-content-center mb-4" style="width:64px; height:64px; background:white; color:var(--color-text-secondary); border-radius:var(--radius-xl); box-shadow:var(--shadow-sm);">
            <i class="bi bi-card-checklist" style="font-size:28px;"></i>
        </div>
        <h5 class="fw-bold mb-2">لا توجد مهام حالياً</h5>
        <p class="text-muted mb-4" style="font-size:14px;">أضف مهام وتكليفات لتقييم مدى استيعاب الطلاب لمحتوى الكورس.</p>
        <a asp-action="Create" asp-route-courseId="@ViewBag.CourseId" class="btn-primary-custom mx-auto" style="height:40px; padding:0 var(--space-5);">
            <i class="bi bi-plus-circle me-2"></i> إضافة أول مهمة
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var assignment in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card-box h-100 d-flex flex-column hover-shadow-sm p-4" style="border:1px solid var(--color-border); transition:all 0.2s ease;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center justify-content-center" style="width:40px; height:40px; border-radius:var(--radius-md); background:var(--color-surface-muted); color:var(--color-primary);">
                            <i class="bi bi-file-earmark-text-fill fs-5"></i>
                        </div>
                        <span class="badge" style="background:var(--color-surface-muted); color:var(--color-text-primary); border:1px solid var(--color-border);">@(assignment.MaxGrade) درجة</span>
                    </div>

                    <h5 class="fw-bold mb-2" style="color:var(--color-text-primary); font-size:16px;">@assignment.Title</h5>
                    
                    <div class="d-flex align-items-center mb-3" style="font-size:12px; color:var(--color-text-secondary); font-weight:600;">
                        <i class="bi bi-calendar-event me-2 text-primary"></i> 
                        استحقاق: @DateTimeService.ToLocal(assignment.DueDate).ToString("yyyy-MM-dd hh:mm tt")
                    </div>

                    <p class="text-muted mb-4" style="font-size:13px; line-height:1.6; flex:1;">
                        @(assignment.Description.Length > 90 ? assignment.Description[..90] + "..." : assignment.Description)
                    </p>

                    <div class="d-flex gap-2 mt-auto pt-3" style="border-top:1px solid var(--color-border-light);">
                        <a asp-action="Submissions" asp-route-id="@assignment.Id" class="btn btn-sm" style="flex:2; background:var(--color-primary-light); color:var(--color-primary-dark); font-weight:600; border:none; height:36px; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-people-fill me-1"></i> التسليمات
                        </a>
                        <a asp-action="Edit" asp-route-id="@assignment.Id" class="btn btn-sm btn-light" style="flex:1; border:1px solid var(--color-border); background:white; font-weight:600; height:36px; display:flex; align-items:center; justify-content:center;">
                            تعديل
                        </a>
                        <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذه المهمة؟ كل تسليمات الطلاب المرتبطة بها ستحذف أيضاً.')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@assignment.Id" />
                            <input type="hidden" name="courseId" value="@ViewBag.CourseId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" style="width:36px; height:36px; display:flex; align-items:center; justify-content:center; border:none; background:var(--color-danger-light); color:var(--color-danger-dark);">
                                <i class="bi bi-trash" style="font-size:14px;"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
