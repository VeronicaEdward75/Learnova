                            <span><i class="bi bi-people"></i> 3.2k طالب</span>
                        </div>
                        <h4 class="cc-title">كمياء </h4>
                        <div class="cc-footer">
                            <div class="cc-teacher">
                                <div class="cc-avatar">M</div>
                                <span>م. محمد أحمد</span>
                            </div>
                            <div class="cc-price">مجاناً</div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Course 2 -->
            <div class="col-12 col-md-6 col-lg-4 reveal" data-delay="0.2">
                <div class="course-card-premium">
                    <div class="cc-image">
                        <div class="cc-badge text-danger"><i class="bi bi-shield-lock"></i> ادبي</div>
                        <div class="position-absolute top-50 start-50 translate-middle text-dark opacity-10">
                            <i class="bi bi-shield-check" style="font-size:5rem;"></i>
                        </div>
                    </div>
                    <div class="cc-body">
                        <div class="cc-meta">
                            <span><i class="bi bi-clock"></i> 25 ساعة</span>
                            <span><i class="bi bi-book"></i> 8 وحدات</span>
                            <span><i class="bi bi-people"></i> 1.5k طالب</span>
                        </div>
                        <h4 class="cc-title">جغرفيا</h4>
                        <div class="cc-footer">
                            <div class="cc-teacher">
                                <div class="cc-avatar" style="background:var(--color-info);">A</div>
                                <span>م. علي خالد</span>
                            </div>
                            <div class="cc-price">600ج</div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Course 3 -->
            <div class="col-12 col-md-6 col-lg-4 reveal" data-delay="0.3">
                <div class="course-card-premium">
                    <div class="cc-image">
                        <div class="cc-badge text-success"><i class="bi bi-cpu"></i> عام</div>
                        <div class="position-absolute top-50 start-50 translate-middle text-dark opacity-10">
                            <i class="bi bi-robot" style="font-size:5rem;"></i>
                        </div>
                    </div>
                    <div class="cc-body">
                        <div class="cc-meta">
                            <span><i class="bi bi-clock"></i> 60 ساعة</span>
                            <span><i class="bi bi-book"></i> 15 وحدة</span>
                            <span><i class="bi bi-people"></i> 4.1k طالب</span>
                        </div>
                        <h4 class="cc-title">عربي</h4>
                        <div class="cc-footer">
                            <div class="cc-teacher">
                                <div class="cc-avatar" style="background:var(--color-success);">S</div>
                                <span>د. سارة محمود</span>
                            </div>
                            <div class="cc-price">200ج</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-4 d-md-none reveal">
            <a href="#" class="btn btn-outline-dark rounded-pill px-4">عرض كل الكورسات</a>
        </div>
    </div>
</section>

<!-- 6. How It Works (Timeline) -->
<section class="timeline-section">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <h2 class="section-title text-white mb-3">كيف تسير رحلة التعلم؟</h2>
            <p class="fs-5 text-white-50 mx-auto" style="max-width:600px;">
                خطوات متسلسلة تضمن لك تحقيق أقصى استفادة من المنصة.
            </p>
        </div>

        <div class="timeline-wrapper">
            <div class="timeline-line"></div>
            
            <div class="timeline-item reveal" data-delay="0.1">
                <div class="tl-dot">1</div>
                <div class="tl-content">
                    <h4 class="fw-bold mb-2 text-white">إنشاء الحساب</h4>
                    <p class="text-white-50 mb-0">سجل في المنصة كطالب بسهولة وفي أقل من دقيقة لتصل إلى لوحة التحكم الخاصة بك.</p>
                </div>
            </div>
            
            <div class="timeline-item reveal" data-delay="0.2">
                <div class="tl-dot">2</div>
                <div class="tl-content">
                    <h4 class="fw-bold mb-2 text-white">الانضمام للكورس</h4>
                    <p class="text-white-50 mb-0">استعرض الكتالوج واختر الكورس الذي يناسب طموحاتك واشترك فيه فوراً.</p>
                </div>
            </div>
            
            <div class="timeline-item reveal" data-delay="0.3">
                <div class="tl-dot">3</div>
                <div class="tl-content">
                    <h4 class="fw-bold mb-2 text-white">مشاهدة الدروس</h4>
                    <p class="text-white-50 mb-0">استمتع بمشاهدة الدروس المرئية بجودة عالية واقرأ المرفقات والمقالات.</p>
                </div>
            </div>
            
            <div class="timeline-item reveal" data-delay="0.4">
                <div class="tl-dot">4</div>
                <div class="tl-content">
                    <h4 class="fw-bold mb-2 text-white">إنجاز المهام</h4>
                    <p class="text-white-50 mb-0">قم بتطبيق ما تعلمته عبر حل المهام العملية ورفعها ليقيمها المعلم.</p>
                </div>
            </div>
            
            <div class="timeline-item reveal" data-delay="0.5">
                <div class="tl-dot">5</div>
                <div class="tl-content">
                    <h4 class="fw-bold mb-2 text-white">اجتياز الاختبارات</h4>
                    <p class="text-white-50 mb-0">اختبر معلوماتك من خلال الكويزات الذكية التي تظهر نتيجتها مباشرة.</p>
                </div>
            </div>
            
            <div class="timeline-item reveal" data-delay="0.6">
                <div class="tl-dot">6</div>
                <div class="tl-content">
                    <h4 class="fw-bold mb-2 text-white">التخرج والشهادة</h4>
                    <p class="text-white-50 mb-0">احصل على شهادتك المعتمدة وابدأ في تطبيق مهاراتك في سوق العمل.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 7. Instructors -->
