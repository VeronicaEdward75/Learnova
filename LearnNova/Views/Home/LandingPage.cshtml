                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 8. Testimonials Carousel -->
<section id="testimonials" class="testimonials-section position-relative">
    <div class="container reveal">
        <h2 class="section-title mb-5 text-center">آراء الطلاب</h2>
        
        <div class="overflow-hidden" style="margin: 0 -15px; padding: 0 15px;">
            <div class="testi-carousel" id="carouselTrack" dir="rtl">
