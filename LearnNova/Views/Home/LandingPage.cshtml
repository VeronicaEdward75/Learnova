@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "الرئيسية";
}

<!-- 1. Hero Section -->
<section id="hero" class="hero-premium">
    <div class="container position-relative z-2">
        <div class="row align-items-center g-5">
            <!-- Hero Text -->
            <div class="col-lg-6">
                <div class="hero-content-wrapper reveal" data-delay="0.1">
                    <div class="hero-badge">
                        ✨ الإصدار الأحدث متوفر الآن
                    </div>
                    <h1 class="hero-title">
                        مستقبل التعليم الرقمي،<br/>
                        <span class="text-gradient">أصبح بين يديك</span>
                    </h1>
                    <p class="hero-desc">
                        تخلص من تعقيدات المنصات التقليدية. توفر LearnNova بيئة تعليمية متكاملة وسهلة الاستخدام للمعلمين والطلاب بأسلوب عصري وأداء فائق السرعة.
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-controller="Account" asp-action="Register" class="btn-premium ripple py-3 px-5 fs-5">
                            ابدأ الآن <i class="bi bi-arrow-left ms-2"></i>
                        </a>
                        <a href="#courses" class="btn-secondary-premium py-3 px-5 fs-5">
                            استكشف الكورسات
                        </a>
                    </div>
                    <div class="mt-4 text-muted small d-flex gap-4">
                        <span><i class="bi bi-check-circle-fill text-success"></i> لا يلزم بطاقة ائتمان</span>
                        <span><i class="bi bi-check-circle-fill text-success"></i> إعداد في دقيقتين</span>
                    </div>
                </div>
            </div>

            <!-- Complex UI Mockup -->
            <div class="col-lg-6 d-none d-lg-block reveal" data-delay="0.3">
                <div class="mockup-perspective">
                    <!-- Floating Badges -->
                    <div class="floating-badge fb-1">
                        <div class="fb-icon" style="background:#10B981;"><i class="bi bi-check-lg"></i></div>
                        تم تسليم المهمة
                    </div>
                    <div class="floating-badge fb-2">
                        <div class="fb-icon" style="background:#F59E0B;"><i class="bi bi-star-fill"></i></div>
                        حصلت على شهادة جديدة!
                    </div>
                    
                    <div class="ui-mockup">
                        <div class="mock-sidebar">
                            <div class="mock-icon active"></div>
                            <div class="mock-icon"></div>
                            <div class="mock-icon"></div>
                            <div class="mock-icon"></div>
                            <div style="margin-top:auto; margin-bottom:20px;" class="mock-icon"></div>
                        </div>
                        <div class="mock-main">
                            <div class="mock-header">
                                <div class="mock-search"></div>
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi bi-bell text-muted fs-5"></i>
                                    <div class="mock-avatar"></div>
                                </div>
                            </div>
                            <div class="mock-grid">
                                <div class="mock-card">
                                    <div class="mock-card-title"></div>
                                    <div class="mock-card-val" style="width:40%;"></div>
                                </div>
                                <div class="mock-card">
                                    <div class="mock-card-title"></div>
                                    <div class="mock-card-val" style="width:60%; background:var(--color-success-light);"></div>
                                </div>
                                <div class="mock-card">
                                    <div class="mock-card-title"></div>
                                    <div class="mock-card-val" style="width:80%; background:var(--color-info-light);"></div>
                                </div>
                            </div>
                            <div class="mock-chart">
                                <div class="mock-bar"></div>
                                <div class="mock-bar"></div>
                                <div class="mock-bar"></div>
                                <div class="mock-bar"></div>
                                <div class="mock-bar"></div>
                                <div class="mock-bar"></div>
                                <div class="mock-bar"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. Trust Section -->
<section class="trust-section">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-6 col-md-3 stat-box reveal" data-delay="0.1">
                <div class="stat-val"><span class="counter" data-target="12000">0</span>+</div>
                <div class="stat-lbl">طالب نشط</div>
            </div>
            <div class="col-6 col-md-3 stat-box reveal" data-delay="0.2">
                <div class="stat-val"><span class="counter" data-target="350">0</span>+</div>
                <div class="stat-lbl">كورس تعليمي</div>
            </div>
            <div class="col-6 col-md-3 stat-box reveal" data-delay="0.3">
                <div class="stat-val"><span class="counter" data-target="120">0</span>+</div>
                <div class="stat-lbl">معلم خبير</div>
            </div>
            <div class="col-6 col-md-3 stat-box reveal" data-delay="0.4">
                <div class="stat-val"><span class="counter" data-target="95">0</span>%</div>
                <div class="stat-lbl">نسبة الإنجاز</div>
            </div>
        </div>
    </div>
</section>

<!-- 3. Features -->
<section id="features" class="features-section">
    <div class="container">
        <div class="text-center mb-5 reveal" data-delay="0">
            <h2 class="section-title mb-3">كل ما تحتاجه في مكان واحد</h2>
            <p class="text-muted fs-5 mx-auto" style="max-width:600px;">
                قمنا بتصميم أدوات قوية وسهلة الاستخدام تمنحك السيطرة الكاملة على عمليتك التعليمية.
            </p>
        </div>

        <div class="row g-4">
            <!-- Row 1 -->
            <div class="col-12 col-md-4 reveal" data-delay="0.1">
                <div class="feature-card-premium">
                    <div class="feature-icon-premium"><i class="bi bi-play-btn"></i></div>
                    <h4 class="fw-bold mb-3">تعلم تفاعلي</h4>
                    <p class="text-muted mb-0">تجربة مشاهدة فيديو سلسة مع تتبع دقيق لتقدم الطالب واستئناف التشغيل من حيث توقف.</p>
                </div>
            </div>
            <div class="col-12 col-md-4 reveal" data-delay="0.2">
                <div class="feature-card-premium">
                    <div class="feature-icon-premium"><i class="bi bi-journal-check"></i></div>
                    <h4 class="fw-bold mb-3">إدارة المهام</h4>
                    <p class="text-muted mb-0">ارفع المهام، حدد مواعيد التسليم، وقم بتقييم إجابات الطلاب مع تقديم تغذية راجعة فورية.</p>
                </div>
            </div>
            <div class="col-12 col-md-4 reveal" data-delay="0.3">
                <div class="feature-card-premium">
                    <div class="feature-icon-premium"><i class="bi bi-ui-checks"></i></div>
                    <h4 class="fw-bold mb-3">اختبارات ذكية</h4>
                    <p class="text-muted mb-0">قم بإنشاء اختبارات مؤقتة مع تصحيح تلقائي وعرض فوري للنتائج بمجرد الانتهاء.</p>
                </div>
            </div>
            <!-- Row 2 -->
            <div class="col-12 col-md-4 reveal" data-delay="0.4">
                <div class="feature-card-premium">
                    <div class="feature-icon-premium"><i class="bi bi-graph-up-arrow"></i></div>
                    <h4 class="fw-bold mb-3">تحليلات دقيقة</h4>
                    <p class="text-muted mb-0">لوحات معلومات قوية توضح أداء الكورسات ومستوى تقدم الطلاب بالأرقام والرسوم البيانية.</p>
                </div>
            </div>
            <div class="col-12 col-md-4 reveal" data-delay="0.5">
                <div class="feature-card-premium">
                    <div class="feature-icon-premium"><i class="bi bi-shield-check"></i></div>
                    <h4 class="fw-bold mb-3">نظام آمن</h4>
                    <p class="text-muted mb-0">نظام متقدم للصلاحيات يضمن أن كل شخص يرى فقط ما يحق له رؤيته بناءً على دوره.</p>
                </div>
            </div>
            <div class="col-12 col-md-4 reveal" data-delay="0.6">
                <div class="feature-card-premium">
                    <div class="feature-icon-premium"><i class="bi bi-award"></i></div>
                    <h4 class="fw-bold mb-3">شهادات معتمدة</h4>
                    <p class="text-muted mb-0">إصدار تلقائي للشهادات عند إتمام الطالب للكورس بنجاح وتجاوز الاختبارات المطلوبة.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. Why LearnNova (Comparison) -->
<section class="vs-section">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <h2 class="section-title mb-3">لماذا تختار <span class="text-gradient">LearnNova</span>؟</h2>
        </div>
        
        <div class="comparison-table reveal" data-delay="0.2">
            <div class="comp-row">
                <div class="comp-header bg-transparent text-end">الميزة</div>
                <div class="comp-header highlight">LearnNova</div>
                <div class="comp-header">الأنظمة التقليدية</div>
            </div>
            <div class="comp-row">
                <div class="comp-cell fw-bold">واجهة المستخدم وتجربة الاستخدام (UX)</div>
                <div class="comp-cell center highlight"><i class="bi bi-check-circle-fill text-success fs-5"></i></div>
                <div class="comp-cell center"><i class="bi bi-x-circle text-danger fs-5 opacity-50"></i></div>
            </div>
            <div class="comp-row">
                <div class="comp-cell fw-bold">تحليلات وإحصائيات متقدمة للمدرسين</div>
                <div class="comp-cell center highlight"><i class="bi bi-check-circle-fill text-success fs-5"></i></div>
                <div class="comp-cell center"><i class="bi bi-x-circle text-danger fs-5 opacity-50"></i></div>
            </div>
            <div class="comp-row">
                <div class="comp-cell fw-bold">سرعة تحميل الصفحات وتجاوب الشاشات</div>
                <div class="comp-cell center highlight"><i class="bi bi-check-circle-fill text-success fs-5"></i></div>
                <div class="comp-cell center"><i class="bi bi-dash-circle text-warning fs-5 opacity-50"></i></div>
            </div>
            <div class="comp-row">
                <div class="comp-cell fw-bold">دعم كامل للغة العربية (RTL)</div>
                <div class="comp-cell center highlight"><i class="bi bi-check-circle-fill text-success fs-5"></i></div>
                <div class="comp-cell center"><i class="bi bi-x-circle text-danger fs-5 opacity-50"></i></div>
            </div>
            <div class="comp-row">
                <div class="comp-cell fw-bold">لوحة تحكم مركزية للإدارة</div>
                <div class="comp-cell center highlight"><i class="bi bi-check-circle-fill text-success fs-5"></i></div>
                <div class="comp-cell center"><i class="bi bi-dash-circle text-warning fs-5 opacity-50"></i></div>
            </div>
        </div>
    </div>
</section>

<!-- 5. Course Preview -->
<section id="courses" class="courses-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-5 reveal">
            <div>
                <h2 class="section-title mb-2">أحدث الكورسات</h2>
                <p class="text-muted fs-5 mb-0">استكشف بعض الكورسات المتاحة على منصتنا</p>
            </div>
            <a href="#" class="btn-text d-none d-md-block">عرض كل الكورسات <i class="bi bi-arrow-left ms-1"></i></a>
        </div>

        <div class="row g-4">
            <!-- Course 1 -->
            <div class="col-12 col-md-6 col-lg-4 reveal" data-delay="0.1">
                <div class="course-card-premium">
                    <div class="cc-image">
                        <div class="cc-badge text-primary"><i class="bi bi-code-slash"></i> علمي</div>
                        <div class="position-absolute top-50 start-50 translate-middle text-dark opacity-10">
                            <i class="bi bi-braces" style="font-size:5rem;"></i>
                        </div>
                    </div>
                    <div class="cc-body">
                        <div class="cc-meta">
                            <span><i class="bi bi-clock"></i> 40 ساعة</span>
