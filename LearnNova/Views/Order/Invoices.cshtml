@model IEnumerable<LearnNova.Models.ViewModels.Student.OrderHistoryViewModel>
@{
    ViewData["Title"] = "الفواتير";
}

<style>
    #main {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">@ViewData["Title"]</h2>
</div>

<div class="card-box p-0 overflow-hidden">
    @if(Model != null && Model.Any(m => !string.IsNullOrEmpty(m.InvoiceNumber)))
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">رقم الفاتورة</th>
                        <th>الكورس</th>
                        <th>تاريخ الفاتورة</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in Model.Where(m => !string.IsNullOrEmpty(m.InvoiceNumber)))
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold font-monospace">@item.InvoiceNumber</div>
                            </td>
                            <td>
                                <div class="fw-bold text-truncate" style="max-width:300px;">@item.CourseTitle</div>
                            </td>
                            <td class="text-muted">@item.PurchaseDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Details" asp-route-id="@item.PaymentId" class="btn btn-sm btn-outline-custom">عرض الفاتورة</a>
                                    <a asp-controller="Document" asp-action="DownloadReceipt" asp-route-id="@item.PaymentId" class="btn btn-sm btn-primary-custom">
                                        <i class="bi bi-download"></i> PDF
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="p-5 text-center text-muted">
            <i class="bi bi-file-earmark-text d-block mb-3" style="font-size: 3rem;"></i>
            ليس لديك أي فواتير حتى الآن
        </div>
    }
</div>
