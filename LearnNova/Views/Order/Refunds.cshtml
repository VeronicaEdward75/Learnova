@using LearnNova.Models.Enums
@model LearnNova.Models.ViewModels.PagedResult<LearnNova.Models.ViewModels.Student.StudentRefundViewModel>
@{
    ViewData["Title"] = "طلبات الاسترداد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">طلبات الاسترداد</h2>
</div>

<div class="mb-4">
    <partial name="_FilterBarPartial" model="ViewBag.Filters" />
</div>

@if(Model == null || !Model.Items.Any())
{
    <div class="card-box p-5 text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 400px; border: 2px dashed var(--color-border);">
        <div class="mb-4" style="width: 100px; height: 100px; background: rgba(79, 70, 229, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-arrow-counterclockwise" style="font-size: 3rem; color: var(--color-primary);"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">لا توجد طلبات استرداد</h4>
        <p class="text-muted mb-4" style="max-width: 400px;">
            لم تقم بتقديم أي طلبات لاسترداد الأموال حتى الآن.
        </p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle custom-table">
            <thead class="table-light">
                <tr>
                    <th>رقم الطلب</th>
                    <th>الكورس</th>
                    <th>تاريخ الطلب</th>
                    <th>المبلغ</th>
                    <th>السبب</th>
                    <th>الحالة</th>
                    <th>ملاحظات الإدارة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td class="fw-bold text-primary">#@r.RefundId</td>
                        <td class="fw-bold">@r.CourseTitle</td>
                        <td class="text-muted">@r.RequestDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="fw-bold">@r.RefundAmount.ToString("C")</td>
                        <td><span class="text-muted small">@r.Reason</span></td>
                        <td>
                            @if(r.Status == RefundStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">قيد الانتظار</span>
                            }
                            else if(r.Status == RefundStatus.Approved)
                            {
                                <span class="badge bg-success px-3 py-2 rounded-pill">مقبول</span>
                            }
                            else if(r.Status == RefundStatus.Rejected)
                            {
                                <span class="badge bg-danger px-3 py-2 rounded-pill">مرفوض</span>
                            }
                        </td>
                        <td>
                            @if(!string.IsNullOrEmpty(r.AdminNotes))
                            {
                                <span class="text-muted small">@r.AdminNotes</span>
                            }
                            else
                            {
                                <span class="text-muted small">--</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="mt-4">
        <partial name="_PaginationPartial" model="Model" />
    </div>
}
