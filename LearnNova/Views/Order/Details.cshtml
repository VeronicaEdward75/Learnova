@model LearnNova.Models.ViewModels.Student.OrderDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الطلب #" + Model.PaymentId;
}

<style>
    /* Issue 1: Prevent #main from fading in slowly so it renders instantly */
    #main {
        animation: none !important;
        opacity: 1 !important;
        transform: none !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">@ViewData["Title"]</h2>
    <a asp-action="History" class="btn btn-outline-secondary">العودة للسجل</a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <!-- Course Purchased Card -->
        <div class="card-box p-4 mb-4" style="border: 1px solid var(--color-border);">
            <h5 class="fw-bold mb-4 border-bottom pb-3">الكورس المشترك به</h5>
            <div class="d-flex flex-column flex-md-row gap-4 align-items-center">
                @if (!string.IsNullOrEmpty(Model.CourseThumbnail))
                {
                    <img src="@Model.CourseThumbnail" alt="@Model.CourseTitle" style="width: 140px; height: 100px; object-fit: cover; border-radius: 8px; box-shadow: var(--shadow-sm);" />
                }
                else
                {
                    <div style="width: 140px; height: 100px; border-radius: 8px; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm);">
                        <i class="bi bi-mortarboard text-white" style="font-size: 2.5rem;"></i>
                    </div>
                }
                
                <div class="flex-grow-1 text-center text-md-start">
                    <h4 class="fw-bold mb-2">@Model.CourseTitle</h4>
                    <div class="text-muted mb-3"><i class="bi bi-person-video3 me-1"></i> المدرس: @Model.TeacherName</div>
                    
                    @if(Model.PaymentStatus == LearnNova.Models.Enums.PaymentStatus.Succeeded)
                    {
                        <a asp-controller="Learning" asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-primary-custom px-4">
                            <i class="bi bi-play-circle me-2"></i> متابعة التعلم
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Refund Status Alert -->
        @if(Model.HasRefundRequest)
        {
            <div class="card-box p-4 border-start border-4 @(Model.RefundStatus == LearnNova.Models.Enums.RefundStatus.Approved ? "border-success" : Model.RefundStatus == LearnNova.Models.Enums.RefundStatus.Rejected ? "border-danger" : "border-warning")">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">حالة طلب الاسترداد</h5>
                    @if(Model.RefundStatus == LearnNova.Models.Enums.RefundStatus.Pending) { <span class="badge bg-warning fs-6 py-2 px-3">قيد المراجعة</span> }
                    else if(Model.RefundStatus == LearnNova.Models.Enums.RefundStatus.Approved) { <span class="badge bg-success fs-6 py-2 px-3">تم القبول</span> }
                    else { <span class="badge bg-danger fs-6 py-2 px-3">مرفوض</span> }
                </div>
                
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="text-muted small">تاريخ الطلب</div>
                        <div class="fw-bold">@Model.RefundRequestedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                    <div class="col-sm-6">
                        <div class="text-muted small">سبب الاسترداد</div>
                        <div class="fw-bold text-truncate" title="@Model.RefundReason">@Model.RefundReason</div>
                    </div>
                </div>
                
                @if(Model.RefundStatus == LearnNova.Models.Enums.RefundStatus.Rejected && !string.IsNullOrEmpty(Model.RefundAdminNotes))
                {
                    <div class="mt-3 p-3 bg-light rounded text-danger">
                        <strong>ملاحظة الإدارة:</strong> @Model.RefundAdminNotes
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-12 col-lg-4">
        <!-- Order Summary Card -->
        <div class="card-box p-0 overflow-hidden" style="border: 1px solid var(--color-border);">
            <div class="bg-light p-4 border-bottom">
                <h5 class="fw-bold mb-0">ملخص الطلب</h5>
            </div>
            
            <div class="p-4">
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">المبلغ الإجمالي</span>
                    <span class="fw-bold">@Model.TotalPaid.ToString("N2") @Model.Currency</span>
                </div>
                
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">تاريخ الشراء</span>
                    <span>@Model.PurchaseDate.ToString("yyyy-MM-dd")</span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">طريقة الدفع</span>
                    <span><i class="bi bi-credit-card me-1"></i> @Model.PaymentMethod</span>
                </div>
                
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">حالة الدفع</span>
                    @if(Model.PaymentStatus == LearnNova.Models.Enums.PaymentStatus.Succeeded) { <span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i> ناجح</span> }
                    else if(Model.PaymentStatus == LearnNova.Models.Enums.PaymentStatus.Refunded) { <span class="text-secondary fw-bold">مسترد</span> }
                    else if(Model.PaymentStatus == LearnNova.Models.Enums.PaymentStatus.Failed) { <span class="text-danger fw-bold">فشل</span> }
                    else { <span class="text-warning fw-bold">@Model.PaymentStatus</span> }
                </div>

                @if(!string.IsNullOrEmpty(Model.InvoiceNumber))
                {
                    <div class="d-flex justify-content-between mb-4">
                        <span class="text-muted">رقم الفاتورة</span>
                        <span class="font-monospace">@Model.InvoiceNumber</span>
                    </div>
                }

                <hr class="my-4" />

                <div class="d-grid gap-3">
                    <a asp-controller="Document" asp-action="DownloadReceipt" asp-route-id="@Model.PaymentId" class="btn btn-primary-custom">
                        <i class="bi bi-file-earmark-pdf me-2"></i> تحميل الفاتورة (PDF)
                    </a>
                    
                    @if(Model.CanRequestRefund)
                    {
                        <a asp-action="RequestRefund" asp-route-paymentId="@Model.PaymentId" class="btn btn-outline-danger">
                            <i class="bi bi-arrow-counterclockwise me-2"></i> طلب استرداد مالي
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
