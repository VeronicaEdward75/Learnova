@model LearnNova.Models.ViewModels.Student.RefundRequestViewModel
@{
    ViewData["Title"] = "طلب استرداد الأموال";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--color-text-primary);">طلب استرداد</h2>
    <a asp-action="History" class="btn btn-outline-custom">العودة للسجل</a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-md-8">
        <div class="card-box p-4 border-top border-4 border-warning">
            <div class="alert alert-warning mb-4">
                <h5 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle me-2"></i> سياسة الاسترداد</h5>
                <p class="mb-0">يمكنك طلب استرداد الأموال خلال 14 يوماً من تاريخ الشراء، بشرط ألا تكون قد أكملت أكثر من 20% من محتوى الكورس.</p>
            </div>

            <form asp-action="RequestRefund" method="post">
                <input type="hidden" asp-for="PaymentId" />
                <input type="hidden" asp-for="CourseTitle" />
                <input type="hidden" asp-for="AmountPaid" />

                <div class="mb-4 p-3 bg-light rounded border">
                    <div class="fw-bold mb-1">تفاصيل الطلب:</div>
                    <div class="text-muted mb-1">الكورس: <strong class="text-dark">@Model.CourseTitle</strong></div>
                    <div class="text-muted">المبلغ المدفوع: <strong class="text-dark">@Model.AmountPaid.ToString("N2") EGP</strong></div>
                </div>

                <div class="mb-3">
                    <label asp-for="Reason" class="form-label fw-bold">سبب الاسترداد <span class="text-danger">*</span></label>
                    <select asp-for="Reason" class="form-select">
                        <option value="">-- اختر السبب --</option>
                        <option value="محتوى الكورس لا يلبي توقعاتي">محتوى الكورس لا يلبي توقعاتي</option>
                        <option value="اشتريت الكورس بالخطأ">اشتريت الكورس بالخطأ</option>
                        <option value="مشاكل تقنية في التشغيل">مشاكل تقنية في التشغيل</option>
                        <option value="الكورس متقدم جداً / أساسي جداً">الكورس متقدم جداً / أساسي جداً</option>
                        <option value="أخرى">أخرى</option>
                    </select>
                    <span asp-validation-for="Reason" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold">تفاصيل إضافية (اختياري)</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="الرجاء توضيح سبب الاسترداد لمساعدتنا في تحسين خدماتنا..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-warning fw-bold text-dark">
                        <i class="bi bi-send me-2"></i> إرسال طلب الاسترداد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
